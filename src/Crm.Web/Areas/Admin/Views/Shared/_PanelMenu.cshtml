@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Tab() => controller switch
    {
        "Articles" or "Faqs" or "Categories" or "SitePages" => "content",
        "Help" or "Account" => "account",
        _ => "platform"
    };
    var tab = Tab();
    string Item(string ctrl, string href, string icon, string label)
    {
        var active = controller == ctrl ? "active" : "";
        return $"<li class=\"menu-item\"><a class=\"menu-link {active}\" href=\"{href}\"><i class=\"fi {icon}\"></i><span class=\"menu-label\">{label}</span></a></li>";
    }
    string Rail(string id, string icon, string title) =>
        $"<li class=\"nav-item\" data-bs-toggle=\"tooltip\" data-bs-placement=\"left\" data-bs-title=\"{title}\"><a class=\"menu-link {(tab == id ? "active" : "")}\" href=\"#nx-admin-{id}\" data-bs-toggle=\"tab\" role=\"tab\"><i class=\"fi {icon}\"></i></a></li>";
}
<aside class="app-menubar-tabs" id="appMenubar">
    <div class="app-navbar-brand">
        <a class="navbar-brand-logo" href="/Admin">
            <img src="~/nexlink/images/logo.svg" alt="@BrandingAccessor.Value.LatinName" />
        </a>
    </div>
    <div class="app-navbar-tabs" data-simplebar>
        <ul class="nav" role="tablist">
            @Html.Raw(Rail("platform", "fi-br-shield", "پلتفرم"))
            @Html.Raw(Rail("content", "fi-br-newspaper", "محتوا"))
            @Html.Raw(Rail("account", "fi-br-user", "حساب"))
            <li class="nav-item-hr"></li>
            <li class="nav-item mt-auto">
                <a class="menu-link @(controller == "Tenants" ? "active" : "")" href="/Admin/Tenants" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="مشتریان">
                    <i class="fi fi-br-building"></i>
                </a>
            </li>
        </ul>
    </div>
    <div class="app-tab-content">
        <div class="app-side-brands"><a class="navbar-brand-text" href="/Admin">مدیریت</a></div>
        <div class="app-content-inner">
            <div class="tab-content">
                <div class="tab-pane fade @(tab == "platform" ? "show active" : "")" id="nx-admin-platform">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">پلتفرم</span></li>
                            @Html.Raw(Item("Dashboard", "/Admin", "fi-rr-house-blank", "داشبورد"))
                            @Html.Raw(Item("Tenants", "/Admin/Tenants", "fi-rr-building", "مشتریان"))
                            @Html.Raw(Item("Subscriptions", "/Admin/Subscriptions", "fi-rr-id-badge", "اشتراک‌ها"))
                            @Html.Raw(Item("Transactions", "/Admin/Transactions", "fi-rr-dollar", "تراکنش‌ها"))
                            @Html.Raw(Item("Plans", "/Admin/Plans", "fi-rr-tags", "پلن‌ها"))
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(tab == "content" ? "show active" : "")" id="nx-admin-content">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">محتوا</span></li>
                            @Html.Raw(Item("Articles", "/Admin/Articles", "fi-rr-newspaper", "مقالات"))
                            @Html.Raw(Item("Faqs", "/Admin/Faqs", "fi-rr-interrogation", "سؤالات"))
                            @Html.Raw(Item("Categories", "/Admin/Categories", "fi-rr-folder", "دسته‌ها"))
                            @Html.Raw(Item("SitePages", "/Admin/SitePages", "fi-rr-document", "درباره ما"))
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(tab == "account" ? "show active" : "")" id="nx-admin-account">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">حساب</span></li>
                            @Html.Raw(Item("Help", "/Admin/Help", "fi-rr-book-alt", "آموزش"))
                            <li class="menu-item"><a class="menu-link @(controller == "Account" ? "active" : "")" href="/Admin/Account/ChangePassword"><i class="fi fi-rr-key"></i><span class="menu-label">تغییر رمز</span></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</aside>
