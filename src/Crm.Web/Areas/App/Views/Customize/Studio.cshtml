@* Modal: add field (type-aware wizard) *@
<div class="modal fade" id="addFieldModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" action="/App/customize/@module.Name/fields" class="modal-content crm-field-wizard" id="addFieldForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="blockId" id="addFieldBlockId" value="" />
            <input type="hidden" name="visibilityRuleJson" id="addRuleJson" value="" />
            <input type="hidden" name="validationRulesJson" id="addValidationJson" value="" />
            <input type="hidden" name="name" id="addFieldName" value="" />
            <input type="hidden" name="picklistOptions" id="addPicklistOptions" value="" />
            <input type="hidden" name="defaultValue" id="addDefaultValueHidden" value="" />
            <input type="hidden" name="integerDigits" id="addIntegerDigitsHidden" value="" />
            <input type="hidden" name="maxLength" id="addMaxLengthHidden" value="" />

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">افزودن فیلد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="crm-field-wizard-steps" id="addFieldSteps">
                <button type="button" class="crm-field-wizard-step is-active" data-step-key="info"><span>1</span> اطلاعات فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="props"><span>2</span> ویژگی‌های فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="validation"><span>3</span> اعتبارسنجی فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="formula"><span>4</span> فرمول</button>
            </div>

            <div class="modal-body">
                @* —— Step: info —— *@
                <div class="crm-field-wizard-pane is-active" data-pane-key="info">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نوع فیلد <span class="text-danger">*</span></label>
                            <select name="type" id="addFieldType" class="form-select" required>
                                @foreach (FieldType ft in Enum.GetValues(typeof(FieldType)))
                                {
                                    if (ft is FieldType.Lookup or FieldType.MultiPicklist) { continue; }
                                    <option value="@((int)ft)">@FieldTypeFa(ft)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">برچسب فیلد <span class="text-danger">*</span></label>
                            <input type="text" name="label" id="addFieldLabel" class="form-control" required placeholder="مثلاً کد ملی" />
                        </div>

                        @* text-like *@
                        <div class="col-md-6" data-for-types="0,1,10,11,12">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultValue" class="form-control" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="0,1,10,11,12">
                            <label class="form-label">حداکثر کاراکتر مجاز</label>
                            <input type="number" id="addMaxLength" class="form-control" min="1" max="4000" placeholder="مثلاً ۲۵۵" data-maxlength-sync="1" />
                        </div>

                        @* number *@
                        <div class="col-md-6" data-for-types="2">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultNumber" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="2">
                            <label class="form-label">حداکثر رقم مجاز <span class="text-danger">*</span></label>
                            <input type="number" id="addMaxDigits" class="form-control" min="1" max="18" placeholder="مثلاً ۱۰" data-integer-digits="1" />
                        </div>

                        @* decimal *@
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultDecimal" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">تعداد ارقام صحیح <span class="text-danger">*</span></label>
                            <input type="number" id="addIntegerDigitsDec" class="form-control" min="1" max="18" placeholder="مثلاً ۱۰" data-integer-digits="1" />
                        </div>
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">تعداد ارقام اعشاری <span class="text-danger">*</span></label>
                            <input type="number" name="decimalDigits" id="addDecimalDigits" class="form-control" min="0" max="10" placeholder="مثلاً ۲" />
                        </div>
                        <div class="col-12" data-for-types="3">
                            <p class="text-muted small mb-0">مجموع تعداد ارقام اعشاری و صحیح نباید بیشتر از ۱۸ باشد.</p>
                        </div>

                        @* currency *@
                        <div class="col-md-6" data-for-types="4">
                            <label class="form-label">مقدار پیش‌فرض (﷼)</label>
                            <input type="text" id="addDefaultCurrency" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="4">
                            <label class="form-label">حداکثر رقم مجاز <span class="text-danger">*</span></label>
                            <input type="number" id="addCurrencyDigits" class="form-control" min="1" max="18" placeholder="مثلاً ۱۲" data-integer-digits="1" />
                        </div>

                        @* percent — no default needed *@
                        <div class="col-12" data-for-types="14">
                            <p class="text-muted small mb-0">مقدار درصد به‌صورت عددی ذخیره می‌شود (مثلاً ۲۵ برای ۲۵٪).</p>
                        </div>

                        @* date *@
                        <div class="col-md-6" data-for-types="5,6">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultDate" class="form-control" dir="ltr" data-default-sync="1" placeholder="اختیاری" />
                        </div>
                        <div class="col-md-6" data-for-types="5,6">
                            <div class="form-check mt-4">
                                <input type="hidden" name="defaultToday" value="false" />
                                <input class="form-check-input" type="checkbox" name="defaultToday" value="true" id="addDefaultToday" />
                                <label class="form-check-label" for="addDefaultToday">مقدار پیش‌فرض فیلد، تاریخ روز باشد</label>
                            </div>
                        </div>

                        @* checkbox *@
                        <div class="col-md-6" data-for-types="7">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <select id="addDefaultCheckbox" class="form-select" data-default-sync="1">
                                <option value="false">خیر</option>
                                <option value="true">بله</option>
                            </select>
                        </div>

                        @* picklist options *@
                        <div class="col-12" data-for-types="8">
                            <label class="form-label">انتخاب مقادیر قابل انتخاب <span class="text-danger">*</span></label>
                            <div id="addPicklistRows" class="crm-picklist-editor mb-2"></div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addPicklistRowBtn">
                                <i class="bx bx-plus"></i> افزودن گزینه
                            </button>
                        </div>
                        <div class="col-md-6" data-for-types="8">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <select id="addPicklistDefault" class="form-select" data-default-sync="1">
                                <option value="">— بدون پیش‌فرض —</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isVisible" value="false" />
                                <input class="form-check-input" type="checkbox" name="isVisible" value="true" id="addIsVisible" checked />
                                <label class="form-check-label" for="addIsVisible">نمایش فیلد</label>
                            </div>
                            <p class="text-muted small mb-0 mt-1">احتیاط: اگر این فیلد در همگام‌سازی یا جریان کاری استفاده شود، پس از مخفی کردن دیگر به‌روزرسانی نمی‌شود.</p>
                        </div>
                    </div>
                </div>

                @* —— Step: props —— *@
                <div class="crm-field-wizard-pane" data-pane-key="props">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isRequired" value="false" />
                                <input class="form-check-input" type="checkbox" name="isRequired" value="true" id="addIsRequired" />
                                <label class="form-check-label" for="addIsRequired">اجباری</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="showInList" value="false" />
                                <input class="form-check-input" type="checkbox" name="showInList" value="true" id="addShowInList" checked />
                                <label class="form-check-label" for="addShowInList">افزودن سریع / نمایش در لیست</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isUniqueCheck" value="false" />
                                <input class="form-check-input" type="checkbox" name="isUniqueCheck" value="true" id="addIsUnique" />
                                <label class="form-check-label" for="addIsUnique">فیلد کلیدی (یکتا)</label>
                            </div>
                        </div>
                    </div>
                </div>

                @* —— Step: validation —— *@
                <div class="crm-field-wizard-pane" data-pane-key="validation">
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="addValidationRuleBtn">
                            <i class="bx bx-plus"></i> افزودن قانون جدید
                        </button>
                    </div>
                    <div id="addValidationRulesList" class="crm-validation-rules"></div>
                    <p class="text-muted small mt-3 mb-0">قوانین بر اساس نوع فیلد تغییر می‌کنند و هنگام ذخیره رکورد اعمال می‌شوند.</p>
                    <script type="application/json" id="studio-date-fields-json">
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            fields.Where(f => f.Type is FieldType.Date or FieldType.DateTime)
                                .Select(f => new { name = f.Name, label = f.Label })
                                .ToList()))
                    </script>
                </div>

                @* —— Step: formula —— *@
                <div class="crm-field-wizard-pane" data-pane-key="formula">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="addFormulaEnabled" />
                                <label class="form-check-label" for="addFormulaEnabled">محاسبه مقدار فیلد با فرمول</label>
                            </div>
                            <textarea name="formulaExpression" id="addFormulaExpression" class="form-control" rows="4" dir="ltr" placeholder="مثلاً {price} * {qty}" disabled></textarea>
                            <p class="text-warning small mt-2 mb-0">
                                احتیاط: فیلدهایی که برای آن‌ها فرمول تعریف شده یا در فرمول فیلد دیگری استفاده شده‌اند، به‌عنوان فیلد سرفصل یا کلیدی توصیه نمی‌شوند.
                                موتور محاسبه در این نسخه ذخیره می‌شود و بعداً اجرا خواهد شد.
                            </p>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <label class="form-label">شرط نمایش (وابستگی)</label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <select id="addDepField" class="form-select">
                                        <option value="">— بدون شرط —</option>
                                        @foreach (var cf in controllingFields)
                                        {
                                            <option value="@cf.Name">@cf.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select id="addDepOp" class="form-select">
                                        <option value="eq">برابر با</option>
                                        <option value="neq">نابرابر با</option>
                                        <option value="contains">شامل شده باشد با</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <input type="text" id="addDepValue" class="form-control" placeholder="مقدار" dir="ltr" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" id="addFieldPrev" hidden>قبلی</button>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-primary" id="addFieldNext">بعدی</button>
                    <button type="submit" class="btn btn-primary" id="addFieldSubmit" hidden>ذخیره</button>
                </div>
            </div>
        </form>
    </div>
</div>

@* Modal: edit field *@
<div class="modal fade" id="editFieldModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form method="post" id="editFieldForm" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="visibilityRuleJson" id="editRule" />
            <div class="modal-header">
                <h5 class="modal-title">ویرایش فیلد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">برچسب</label>
                    <input type="text" name="label" id="editLabel" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">ترتیب</label>
                    <input type="number" name="sortOrder" id="editSort" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">حداکثر طول</label>
                    <input type="number" name="maxLength" id="editMaxLength" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">بلاک</label>
                    <select name="blockId" id="editBlockId" class="form-select">
                        <option value="">— بدون بلاک —</option>
                        @foreach (var block in blocks)
                        {
                            <option value="@block.Id">@block.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">مقدار پیش‌فرض</label>
                    <input type="text" name="defaultValue" id="editDefault" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">ارقام صحیح</label>
                    <input type="number" name="integerDigits" id="editIntegerDigits" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">ارقام اعشار</label>
                    <input type="number" name="decimalDigits" id="editDecimalDigits" class="form-control" />
                </div>
                <div class="col-12" id="editPicklistWrap" style="display:none">
                    <label class="form-label">گزینه‌های انتخابی (هر خط یک گزینه)</label>
                    <textarea name="picklistOptions" id="editPicklistOptions" class="form-control" rows="4" placeholder="گزینه ۱&#10;گزینه ۲"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">فرمول</label>
                    <textarea name="formulaExpression" id="editFormula" class="form-control" rows="2" dir="ltr"></textarea>
                </div>
                <input type="hidden" name="validationRulesJson" id="editValidationJson" value="" />
                <div class="col-12">
                    <label class="form-label">شرط نمایش</label>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <select id="editDepField" class="form-select">
                                <option value="">— بدون شرط —</option>
                                @foreach (var cf in controllingFields)
                                {
                                    <option value="@cf.Name">@cf.Label</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select id="editDepOp" class="form-select">
                                <option value="eq">برابر با</option>
                                <option value="neq">نابرابر با</option>
                                <option value="contains">شامل شده باشد با</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <input type="text" id="editDepValue" class="form-control" dir="ltr" placeholder="مقدار" />
                        </div>
                    </div>
                    <small class="text-muted">مثلاً وقتی مرحله = Closed Won این فیلد نمایش داده شود.</small>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isRequired" value="true" id="editRequired" />
                        <label class="form-check-label" for="editRequired">الزامی</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="showInList" value="true" id="editShowInList" />
                        <label class="form-check-label" for="editShowInList">نمایش در لیست</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isVisible" value="true" id="editVisible" />
                        <label class="form-check-label" for="editVisible">قابل‌مشاهده</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isUniqueCheck" value="true" id="editUnique" />
                        <label class="form-check-label" for="editUnique">یکتا</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-primary">ذخیره</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        (function () {
            function parseRule(json) {
                if (!json) return null;
                try {
                    var r = JSON.parse(json);
                    if (!r) return null;
                    if (r.conditions && r.conditions.length) {
                        return r.conditions[0];
                    }
                    if (r.field) return r;
                    return null;
                } catch { return null; }
            }
            function buildRule(field, op, value) {
                if (!field) return '';
                return JSON.stringify({
                    action: 'show',
                    logic: 'and',
                    conditions: [{ field: field, op: op || 'eq', value: value || '' }]
                });
            }
            function applyRuleToUi(rule, fieldEl, opEl, valueEl) {
                if (rule && rule.field) {
                    fieldEl.value = rule.field;
                    opEl.value = rule.op || 'eq';
                    valueEl.value = rule.value || '';
                } else {
                    fieldEl.value = '';
                    opEl.value = 'eq';
                    valueEl.value = '';
                }
            }

            function syncFieldsEmptyState(container) {
                if (!container) return;
                const hasFields = !!container.querySelector('.studio-field');
                let empty = container.querySelector('.studio-fields-empty');
                if (hasFields) {
                    if (empty) empty.remove();
                    return;
                }
                if (!empty) {
                    empty = document.createElement('div');
                    empty.className = 'studio-fields-empty';
                    empty.textContent = container.getAttribute('data-empty-msg')
                        || 'هنوز فیلدی در این بلاک نیست — فیلدها را بکشید یا اضافه کنید.';
                    container.appendChild(empty);
                }
            }

            const containers = document.querySelectorAll('.studio-fields');
            containers.forEach(function (el) {
                new Sortable(el, {
                    group: 'studio-fields',
                    animation: 150,
                    draggable: '.studio-field',
                    handle: '.studio-field-handle',
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    onAdd: function (evt) { syncFieldsEmptyState(evt.to); syncFieldsEmptyState(evt.from); },
                    onRemove: function (evt) { syncFieldsEmptyState(evt.from); syncFieldsEmptyState(evt.to); },
                    onUpdate: function (evt) { syncFieldsEmptyState(evt.from); }
                });
            });

            const form = document.getElementById('saveLayoutForm');
            if (form) {
                form.addEventListener('submit', function () {
                    const layout = [];
                    document.querySelectorAll('.studio-block').forEach(function (blockEl) {
                        const raw = blockEl.getAttribute('data-block-id');
                        const blockId = raw === '' || raw == null ? null : parseInt(raw, 10);
                        const fieldIds = [];
                        blockEl.querySelectorAll('.studio-field').forEach(function (fieldEl) {
                            fieldIds.push(parseInt(fieldEl.getAttribute('data-field-id'), 10));
                        });
                        layout.push({ blockId: blockId, fieldIds: fieldIds });
                    });
                    document.getElementById('layoutJson').value = JSON.stringify(layout);
                });
            }

            const editModal = document.getElementById('editFieldModal');
            if (editModal) {
                editModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    const id = btn.getAttribute('data-id');
                    document.getElementById('editFieldForm').action = '/App/customize/@module.Name/fields/' + id;
                    document.getElementById('editLabel').value = btn.getAttribute('data-label') || '';
                    document.getElementById('editSort').value = btn.getAttribute('data-sort') || '0';
                    document.getElementById('editMaxLength').value = btn.getAttribute('data-maxlength') || '';
                    document.getElementById('editBlockId').value = btn.getAttribute('data-blockid') || '';
                    document.getElementById('editDefault').value = btn.getAttribute('data-default') || '';
                    document.getElementById('editIntegerDigits').value = btn.getAttribute('data-integerdigits') || '';
                    document.getElementById('editDecimalDigits').value = btn.getAttribute('data-decimaldigits') || '';
                    document.getElementById('editFormula').value = btn.getAttribute('data-formula') || '';
                    document.getElementById('editValidationJson').value = btn.getAttribute('data-validation') || '';
                    const type = btn.getAttribute('data-type') || '';
                    const pickWrap = document.getElementById('editPicklistWrap');
                    const pickTa = document.getElementById('editPicklistOptions');
                    if (pickWrap && pickTa) {
                        const isPick = type === '8' || type === '9';
                        pickWrap.style.display = isPick ? '' : 'none';
                        pickTa.value = isPick ? (btn.getAttribute('data-picklist') || '') : '';
                        pickTa.disabled = !isPick;
                    }
                    document.getElementById('editRequired').checked = btn.getAttribute('data-required') === 'true';
                    document.getElementById('editShowInList').checked = btn.getAttribute('data-showinlist') === 'true';
                    document.getElementById('editVisible').checked = btn.getAttribute('data-visible') === 'true';
                    document.getElementById('editUnique').checked = btn.getAttribute('data-unique') === 'true';
                    applyRuleToUi(
                        parseRule(btn.getAttribute('data-rule')),
                        document.getElementById('editDepField'),
                        document.getElementById('editDepOp'),
                        document.getElementById('editDepValue'));
                });

                document.getElementById('editFieldForm').addEventListener('submit', function () {
                    document.getElementById('editRule').value = buildRule(
                        document.getElementById('editDepField').value,
                        document.getElementById('editDepOp').value,
                        document.getElementById('editDepValue').value);
                });
            }

            const blockRuleModal = document.getElementById('editBlockRuleModal');
            if (blockRuleModal) {
                blockRuleModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    const id = btn.getAttribute('data-id');
                    document.getElementById('editBlockRuleForm').action = '/App/customize/@module.Name/blocks/' + id;
                    document.getElementById('blockRuleLabel').value = btn.getAttribute('data-label') || '';
                    document.getElementById('blockRuleSort').value = btn.getAttribute('data-sort') || '0';
                    document.getElementById('blockRuleCollapsed').value = btn.getAttribute('data-collapsed') === 'true' ? 'true' : 'false';
                    applyRuleToUi(
                        parseRule(btn.getAttribute('data-rule')),
                        document.getElementById('blockDepField'),
                        document.getElementById('blockDepOp'),
                        document.getElementById('blockDepValue'));
                });

                document.getElementById('editBlockRuleForm').addEventListener('submit', function () {
                    document.getElementById('blockRuleJson').value = buildRule(
                        document.getElementById('blockDepField').value,
                        document.getElementById('blockDepOp').value,
                        document.getElementById('blockDepValue').value);
                });
            }

            /* Preselect block + type-aware wizard for add field */
            const addFieldModal = document.getElementById('addFieldModal');
            if (addFieldModal) {
                const form = document.getElementById('addFieldForm');
                const prevBtn = document.getElementById('addFieldPrev');
                const nextBtn = document.getElementById('addFieldNext');
                const submitBtn = document.getElementById('addFieldSubmit');
                let activeSteps = ['info', 'props', 'validation', 'formula'];
                let stepIndex = 0;
                let dateFieldsForRules = [];
                try {
                    const dfEl = document.getElementById('studio-date-fields-json');
                    if (dfEl) dateFieldsForRules = JSON.parse(dfEl.textContent || '[]');
                } catch (e) { dateFieldsForRules = []; }

                /* type -> step keys (competitor-like) */
                function stepsForType(type) {
                    const t = String(type);
                    if (t === '8') return ['info', 'props']; /* picklist */
                    if (t === '7') return ['info', 'props']; /* checkbox */
                    if (t === '3' || t === '4' || t === '14') return ['info', 'props', 'formula']; /* decimal/currency/percent */
                    return ['info', 'props', 'validation', 'formula'];
                }

                function validationCatalog(type) {
                    const t = String(type);
                    /* Date / DateTime */
                    if (t === '5' || t === '6') {
                        return [
                            { rule: 'beforeToday', label: 'قبل از امروز', needs: null },
                            { rule: 'beforeOrOnToday', label: 'قبل از یا مساوی امروز', needs: null },
                            { rule: 'afterToday', label: 'بعد از امروز', needs: null },
                            { rule: 'afterOrOnToday', label: 'بعد از یا مساوی امروز', needs: null },
                            { rule: 'beforeField', label: 'قبل از فیلد', needs: 'field' },
                            { rule: 'afterField', label: 'بعد از فیلد', needs: 'field' },
                            { rule: 'afterNDays', label: 'بعد از n روز آینده', needs: 'number' }
                        ];
                    }
                    /* Number (integer) */
                    if (t === '2') {
                        return [
                            { rule: 'min', label: 'حداقل', needs: 'number' },
                            { rule: 'max', label: 'حداکثر', needs: 'number' }
                        ];
                    }
                    /* Text-like (Text, Multiline, Email, Phone, Url) */
                    return [
                        { rule: 'englishOnly', label: 'فقط حروف انگلیسی', needs: null },
                        { rule: 'persianOnly', label: 'فقط حروف فارسی', needs: null },
                        { rule: 'minLength', label: 'حداقل تعداد کاراکتر', needs: 'number' },
                        { rule: 'maxLength', label: 'حداکثر تعداد کاراکتر', needs: 'number' },
                        { rule: 'nationalId', label: 'کد ملی', needs: null },
                        { rule: 'contains', label: 'شامل شده باشد با', needs: 'text' },
                        { rule: 'digitsOnly', label: 'فقط اعداد صحیح', needs: null }
                    ];
                }

                function slugifyLabel(label) {
                    const base = (label || '').trim().toLowerCase()
                        .replace(/[^a-z0-9\u0600-\u06FF]+/gi, '_')
                        .replace(/^_+|_+$/g, '');
                    const ascii = base.replace(/[^\x00-\x7F]/g, '');
                    if (ascii && /^[a-z]/.test(ascii)) return ascii.substring(0, 40);
                    return 'f_' + Date.now().toString(36).slice(-6);
                }

                function syncTypePanels() {
                    const type = document.getElementById('addFieldType')?.value || '0';
                    addFieldModal.querySelectorAll('[data-for-types]').forEach(function (el) {
                        const list = (el.getAttribute('data-for-types') || '').split(',');
                        el.style.display = list.indexOf(String(type)) >= 0 ? '' : 'none';
                    });
                    activeSteps = stepsForType(type);
                    if (stepIndex >= activeSteps.length) stepIndex = 0;
                    /* قوانین را با تغییر نوع پاک کن تا با کاتالوگ جدید هم‌خوان باشد */
                    const list = document.getElementById('addValidationRulesList');
                    if (list) list.innerHTML = '';
                    goStep(stepIndex);
                }

                function goStep(index) {
                    stepIndex = Math.max(0, Math.min(activeSteps.length - 1, index));
                    const key = activeSteps[stepIndex];
                    addFieldModal.querySelectorAll('.crm-field-wizard-step').forEach(function (el) {
                        const k = el.getAttribute('data-step-key');
                        const i = activeSteps.indexOf(k);
                        el.style.display = i >= 0 ? '' : 'none';
                        el.classList.toggle('is-active', k === key);
                        el.classList.toggle('is-done', i >= 0 && i < stepIndex);
                        const num = el.querySelector('span');
                        if (num && i >= 0) num.textContent = String(i + 1);
                    });
                    addFieldModal.querySelectorAll('.crm-field-wizard-pane').forEach(function (el) {
                        el.classList.toggle('is-active', el.getAttribute('data-pane-key') === key);
                    });
                    prevBtn.hidden = stepIndex === 0;
                    nextBtn.hidden = stepIndex === activeSteps.length - 1;
                    submitBtn.hidden = stepIndex !== activeSteps.length - 1;
                }

                function addPicklistRow(label) {
                    const wrap = document.getElementById('addPicklistRows');
                    if (!wrap) return;
                    const row = document.createElement('div');
                    row.className = 'crm-picklist-row input-group mb-2';
                    row.innerHTML =
                        '<input type="text" class="form-control pick-label" placeholder="برچسب گزینه" value="' + (label || '').replace(/"/g, '&quot;') + '" />' +
                        '<button type="button" class="btn btn-outline-danger pick-remove" title="حذف"><i class="bx bx-trash"></i></button>';
                    wrap.appendChild(row);
                    row.querySelector('.pick-label').addEventListener('input', refreshPicklistDefault);
                    row.querySelector('.pick-remove').addEventListener('click', function () {
                        row.remove();
                        refreshPicklistDefault();
                    });
                    refreshPicklistDefault();
                }

                function refreshPicklistDefault() {
                    const sel = document.getElementById('addPicklistDefault');
                    if (!sel) return;
                    const prev = sel.value;
                    const labels = Array.from(document.querySelectorAll('#addPicklistRows .pick-label'))
                        .map(function (i) { return i.value.trim(); })
                        .filter(Boolean);
                    sel.innerHTML = '<option value="">— بدون پیش‌فرض —</option>';
                    labels.forEach(function (l) {
                        const opt = document.createElement('option');
                        opt.value = l;
                        opt.textContent = l;
                        sel.appendChild(opt);
                    });
                    if (prev && labels.indexOf(prev) >= 0) sel.value = prev;
                }

                function syncRuleValueUi(row) {
                    const rule = row.querySelector('.rule-select')?.value || '';
                    const type = document.getElementById('addFieldType')?.value || '0';
                    const cat = validationCatalog(type).find(function (c) { return c.rule === rule; });
                    const needs = cat ? cat.needs : null;
                    const valueWrap = row.querySelector('.rule-value-wrap');
                    const fieldWrap = row.querySelector('.rule-field-wrap');
                    if (valueWrap) valueWrap.style.display = (needs === 'number' || needs === 'text') ? '' : 'none';
                    if (fieldWrap) fieldWrap.style.display = needs === 'field' ? '' : 'none';
                    const input = row.querySelector('.rule-value');
                    if (input) {
                        input.placeholder = needs === 'number' ? 'مقدار' : (needs === 'text' ? 'متن' : '');
                        input.dir = needs === 'text' ? 'rtl' : 'ltr';
                    }
                }

                function addValidationRuleRow() {
                    const list = document.getElementById('addValidationRulesList');
                    if (!list) return;
                    const type = document.getElementById('addFieldType')?.value || '0';
                    const catalog = validationCatalog(type);
                    const row = document.createElement('div');
                    row.className = 'crm-validation-rule-row d-flex gap-2 align-items-center mb-2 flex-wrap';

                    let opts = '<option value="">انتخاب قانون</option>';
                    catalog.forEach(function (c) {
                        opts += '<option value="' + c.rule + '">' + c.label + '</option>';
                    });

                    let fieldOpts = '<option value="">انتخاب فیلد</option>';
                    dateFieldsForRules.forEach(function (f) {
                        fieldOpts += '<option value="' + f.name + '">' + f.label + '</option>';
                    });

                    row.innerHTML =
                        '<select class="form-select rule-select" style="max-width:16rem">' + opts + '</select>' +
                        '<div class="rule-value-wrap" style="display:none">' +
                        '<input type="text" class="form-control rule-value" style="max-width:10rem" placeholder="مقدار" dir="ltr" />' +
                        '</div>' +
                        '<div class="rule-field-wrap" style="display:none">' +
                        '<select class="form-select rule-field" style="max-width:14rem">' + fieldOpts + '</select>' +
                        '</div>' +
                        '<button type="button" class="btn btn-link text-danger p-1 rule-remove" title="حذف"><i class="bx bx-trash" style="font-size:1.25rem"></i></button>';

                    list.appendChild(row);
                    row.querySelector('.rule-select').addEventListener('change', function () { syncRuleValueUi(row); });
                    row.querySelector('.rule-remove').addEventListener('click', function () { row.remove(); });
                }

                function collectValidationRules() {
                    const rows = document.querySelectorAll('#addValidationRulesList .crm-validation-rule-row');
                    const result = [];
                    rows.forEach(function (row) {
                        const rule = row.querySelector('.rule-select')?.value;
                        if (!rule) return;
                        const type = document.getElementById('addFieldType')?.value || '0';
                        const cat = validationCatalog(type).find(function (c) { return c.rule === rule; });
                        const needs = cat ? cat.needs : null;
                        let value = '';
                        if (needs === 'field')
                            value = row.querySelector('.rule-field')?.value || '';
                        else if (needs === 'number' || needs === 'text')
                            value = (row.querySelector('.rule-value')?.value || '').trim();
                        if (needs && !value) return;
                        result.push({ rule: rule, value: value || null });
                    });
                    return result;
                }

                function collectVisibleDefault() {
                    const type = document.getElementById('addFieldType')?.value || '0';
                    let val = '';
                    addFieldModal.querySelectorAll('[data-default-sync]').forEach(function (el) {
                        const wrap = el.closest('[data-for-types]');
                        if (!wrap || wrap.style.display === 'none') return;
                        if (el.tagName === 'SELECT' || el.tagName === 'INPUT')
                            val = el.value || '';
                    });
                    if (type === '5' || type === '6') {
                        if (document.getElementById('addDefaultToday')?.checked)
                            val = '__TODAY__';
                    }
                    return val;
                }

                function collectIntegerDigits() {
                    let val = '';
                    addFieldModal.querySelectorAll('[data-integer-digits]').forEach(function (el) {
                        const wrap = el.closest('[data-for-types]');
                        if (!wrap || wrap.style.display === 'none') return;
                        val = el.value || '';
                    });
                    return val;
                }

                function collectMaxLength() {
                    const el = document.getElementById('addMaxLength');
                    const wrap = el?.closest('[data-for-types]');
                    if (!wrap || wrap.style.display === 'none') return '';
                    return el.value || '';
                }

                function collectPicklistOptions() {
                    return Array.from(document.querySelectorAll('#addPicklistRows .pick-label'))
                        .map(function (i) { return i.value.trim(); })
                        .filter(Boolean)
                        .join('\n');
                }

                addFieldModal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    const blockInput = document.getElementById('addFieldBlockId');
                    if (blockInput && btn && btn.classList.contains('studio-add-field-to-block')) {
                        blockInput.value = btn.getAttribute('data-block-id') || '';
                    }
                    const vList = document.getElementById('addValidationRulesList');
                    if (vList) vList.innerHTML = '';
                    const rows = document.getElementById('addPicklistRows');
                    if (rows) rows.innerHTML = '';
                    addPicklistRow('');
                    addPicklistRow('');
                    const formulaCb = document.getElementById('addFormulaEnabled');
                    const formulaTa = document.getElementById('addFormulaExpression');
                    if (formulaCb) formulaCb.checked = false;
                    if (formulaTa) { formulaTa.value = ''; formulaTa.disabled = true; }
                    stepIndex = 0;
                    syncTypePanels();
                });

                document.getElementById('addFieldType')?.addEventListener('change', function () {
                    stepIndex = 0;
                    syncTypePanels();
                });
                document.getElementById('addPicklistRowBtn')?.addEventListener('click', function () { addPicklistRow(''); });
                document.getElementById('addFormulaEnabled')?.addEventListener('change', function () {
                    const ta = document.getElementById('addFormulaExpression');
                    if (ta) ta.disabled = !this.checked;
                    if (!this.checked && ta) ta.value = '';
                });
                document.getElementById('addValidationRuleBtn')?.addEventListener('click', function () {
                    addValidationRuleRow();
                });

                prevBtn?.addEventListener('click', function () { goStep(stepIndex - 1); });
                nextBtn?.addEventListener('click', function () {
                    const label = document.getElementById('addFieldLabel');
                    if (activeSteps[stepIndex] === 'info') {
                        if (label && !label.value.trim()) {
                            label.focus();
                            label.reportValidity();
                            return;
                        }
                        const type = document.getElementById('addFieldType')?.value;
                        if (type === '8' && !collectPicklistOptions()) {
                            alert('حداقل یک گزینه برای فیلد انتخابی وارد کنید.');
                            return;
                        }
                        if (type === '2' && !collectIntegerDigits()) {
                            document.getElementById('addMaxDigits')?.focus();
                            return;
                        }
                        if (type === '3') {
                            if (!document.getElementById('addIntegerDigitsDec')?.value || !document.getElementById('addDecimalDigits')?.value) {
                                document.getElementById('addIntegerDigitsDec')?.focus();
                                return;
                            }
                        }
                        if (type === '4' && !collectIntegerDigits()) {
                            document.getElementById('addCurrencyDigits')?.focus();
                            return;
                        }
                    }
                    goStep(stepIndex + 1);
                });

                addFieldModal.querySelectorAll('.crm-field-wizard-step').forEach(function (el) {
                    el.addEventListener('click', function () {
                        const k = el.getAttribute('data-step-key');
                        const i = activeSteps.indexOf(k);
                        if (i >= 0) goStep(i);
                    });
                });

                form?.addEventListener('submit', function () {
                    const label = document.getElementById('addFieldLabel')?.value || '';
                    document.getElementById('addFieldName').value = slugifyLabel(label);
                    document.getElementById('addDefaultValueHidden').value = collectVisibleDefault();
                    document.getElementById('addIntegerDigitsHidden').value = collectIntegerDigits();
                    document.getElementById('addMaxLengthHidden').value = collectMaxLength();
                    document.getElementById('addPicklistOptions').value = collectPicklistOptions();
                    const rules = collectValidationRules();
                    document.getElementById('addValidationJson').value = rules.length
                        ? JSON.stringify(rules) : '';
                    const dd = document.getElementById('addDecimalDigits');
                    if (dd) {
                        const wrap = dd.closest('[data-for-types]');
                        dd.disabled = !!(wrap && wrap.style.display === 'none');
                    }
                    const formulaOn = document.getElementById('addFormulaEnabled')?.checked;
                    if (!formulaOn) {
                        const ta = document.getElementById('addFormulaExpression');
                        if (ta) ta.value = '';
                    }
                    document.getElementById('addRuleJson').value = buildRule(
                        document.getElementById('addDepField').value,
                        document.getElementById('addDepOp').value,
                        document.getElementById('addDepValue').value);
                });
            }

            /* Relation modal: autofill tab label from related module plural */
            const relTarget = document.getElementById('relTargetModule');
            const relTabLabel = document.getElementById('relTabLabel');
            if (relTarget && relTabLabel) {
                relTarget.addEventListener('change', function () {
                    const opt = relTarget.options[relTarget.selectedIndex];
                    if (!opt || !opt.value) return;
                    if (!relTabLabel.value.trim())
                        relTabLabel.value = opt.getAttribute('data-plural') || opt.textContent.trim();
                });
            }

            /* Toggle hidden fields per block */
            document.querySelectorAll('.studio-toggle-hidden').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const block = btn.closest('.studio-block');
                    if (!block) return;
                    const showing = block.classList.toggle('show-hidden');
                    btn.classList.toggle('is-active', showing);
                    const label = btn.querySelector('span');
                    const icon = btn.querySelector('i');
                    if (label) label.textContent = showing ? 'مخفی‌کردن فیلدهای پنهان' : 'نمایش فیلدهای پنهان';
                    if (icon) {
                        icon.classList.toggle('bx-hide', !showing);
                        icon.classList.toggle('bx-show', showing);
                    }
                });
            });

            /* Sync collapse label / class with Bootstrap collapse */
            document.querySelectorAll('.studio-block').forEach(function (block) {
                const body = block.querySelector('.studio-block-body.collapse');
                const label = block.querySelector('.studio-collapse-label');
                if (!body) return;
                body.addEventListener('shown.bs.collapse', function () {
                    block.classList.remove('is-collapsed');
                    if (label) label.textContent = 'بسته شدن';
                });
                body.addEventListener('hidden.bs.collapse', function () {
                    block.classList.add('is-collapsed');
                    if (label) label.textContent = 'باز شدن';
                });
            });

            /* ── Duplicates wizard ── */
            (function initDuplicatesWizard() {
                const root = document.querySelector('[data-dup-wizard]');
                const tmpl = document.getElementById('dupCardTemplate');
                if (!root || !tmpl) return;

                const tints = ['tint-sky', 'tint-peach', 'tint-mint', 'tint-lavender', 'tint-sand'];
                const enabledCb = root.querySelector('[data-dup-enabled]');
                const steps = root.querySelector('[data-dup-steps]');
                const globalCb = root.querySelector('[data-dup-global-enabled]');
                const globalBody = root.querySelector('[data-dup-global-body]');

                function syncEnabled() {
                    if (steps) steps.classList.toggle('is-disabled', !(enabledCb && enabledCb.checked));
                }
                function syncGlobal() {
                    if (globalBody) globalBody.classList.toggle('is-disabled', !(globalCb && globalCb.checked));
                }
                if (enabledCb) enabledCb.addEventListener('change', syncEnabled);
                if (globalCb) globalCb.addEventListener('change', syncGlobal);
                syncEnabled();
                syncGlobal();

                function wireList(opts) {
                    const cards = root.querySelector(opts.cards);
                    const select = root.querySelector(opts.select);
                    const addBtn = root.querySelector(opts.add);
                    const emptySel = opts.empty;
                    const removeSel = opts.remove;
                    const inputName = opts.inputName;
                    const max = opts.max || 99;
                    if (!cards || !select || !addBtn) return;

                    function recolor() {
                        cards.querySelectorAll('[data-dup-card]').forEach(function (card, i) {
                            tints.forEach(function (t) { card.classList.remove(t); });
                            card.classList.add(tints[i % tints.length]);
                        });
                    }

                    function syncEmpty() {
                        const n = cards.querySelectorAll('[data-dup-card]').length;
                        let empty = cards.querySelector(emptySel);
                        if (n === 0) {
                            if (!empty) {
                                empty = document.createElement('div');
                                empty.className = 'crm-dup-empty';
                                const attr = (emptySel.match(/data-[\w-]+/) || [])[0];
                                if (attr) empty.setAttribute(attr, '');
                                empty.textContent = opts.emptyText;
                                cards.appendChild(empty);
                            }
                        } else if (empty) {
                            empty.remove();
                        }
                        addBtn.disabled = !select.value || n >= max;
                        recolor();
                    }

                    function setOptionDisabled(id, disabled) {
                        const opt = select.querySelector('option[value="' + id + '"]');
                        if (opt) opt.disabled = !!disabled;
                    }

                    function removeCard(card) {
                        var msg = opts.confirmMessage || 'این فیلد از معیار حذف شود؟';
                        var ask = typeof window.crmConfirm === 'function'
                            ? window.crmConfirm(msg, { title: 'حذف از معیار تکرار', confirmText: 'بله، حذف شود', icon: 'warning' })
                            : Promise.resolve(window.confirm(msg));
                        ask.then(function (ok) {
                            if (!ok) return;
                            const id = card.getAttribute('data-field-id');
                            card.remove();
                            if (id) setOptionDisabled(id, false);
                            syncEmpty();
                        });
                    }

                    function addCard(id, label, typeLabel) {
                        const n = cards.querySelectorAll('[data-dup-card]').length;
                        if (!id || n >= max || cards.querySelector('[data-field-id="' + id + '"]')) return;
                        const node = tmpl.content.firstElementChild.cloneNode(true);
                        node.setAttribute('data-field-id', id);
                        const input = node.querySelector('input');
                        input.name = inputName;
                        input.value = id;
                        node.querySelector('[data-label]').textContent = label;
                        node.querySelector('[data-type]').textContent = '(' + typeLabel + ')';
                        const rm = node.querySelector('[data-remove]');
                        if (rm) {
                            rm.removeAttribute('data-remove');
                            rm.setAttribute(removeSel.replace(/^\[|\]$/g, ''), '');
                            const rmLabel = rm.querySelector('[data-remove-label]');
                            if (rmLabel && opts.removeLabel) rmLabel.textContent = opts.removeLabel;
                        }
                        cards.appendChild(node);
                        setOptionDisabled(id, true);
                        select.value = '';
                        syncEmpty();
                    }

                    cards.addEventListener('click', function (e) {
                        const btn = e.target.closest(removeSel);
                        if (!btn) return;
                        const card = btn.closest('[data-dup-card]');
                        if (card) removeCard(card);
                    });

                    select.addEventListener('change', function () {
                        const n = cards.querySelectorAll('[data-dup-card]').length;
                        addBtn.disabled = !select.value || n >= max;
                    });

                    addBtn.addEventListener('click', function () {
                        const opt = select.options[select.selectedIndex];
                        if (!opt || !opt.value) return;
                        addCard(opt.value, opt.getAttribute('data-label') || opt.textContent.trim(),
                            opt.getAttribute('data-type') || '');
                    });

                    if (typeof Sortable !== 'undefined') {
                        new Sortable(cards, {
                            animation: 150,
                            handle: '.crm-dup-card-handle',
                            draggable: '[data-dup-card]',
                            ghostClass: 'sortable-ghost',
                            onEnd: recolor
                        });
                    }

                    syncEmpty();
                }

                wireList({
                    cards: '[data-dup-unique-cards]',
                    select: '[data-dup-unique-select]',
                    add: '[data-dup-unique-add]',
                    empty: '[data-dup-unique-empty]',
                    remove: '[data-dup-unique-remove]',
                    inputName: 'uniqueFieldIds',
                    max: 3,
                    emptyText: 'هنوز فیلد یکتایی انتخاب نشده است.',
                    removeLabel: 'حذف از معیار تکرار',
                    confirmMessage: 'این فیلد از معیار تشخیص تکرار این ماژول حذف شود؟'
                });

                wireList({
                    cards: '[data-dup-global-cards]',
                    select: '[data-dup-global-select]',
                    add: '[data-dup-global-add]',
                    empty: '[data-dup-global-empty]',
                    remove: '[data-dup-global-remove]',
                    inputName: 'globalFieldIds',
                    max: 20,
                    emptyText: 'فیلد شماره تماسی برای تشخیص سراسری انتخاب نشده است.',
                    removeLabel: 'حذف از تشخیص سراسری',
                    confirmMessage: 'این فیلد از تشخیص تکراری سراسری حذف شود؟'
                });
            })();
        })();
    </script>
    <script src="~/js/crm-dep-studio.js" asp-append-version="true"></script>
}
