@using Crm.Core.Entities
@{
    var module = (ModuleDef)ViewBag.Module;
    var blocks = (IReadOnlyList<FieldBlock>)ViewBag.Blocks;
    var fields = (IReadOnlyList<FieldDef>)ViewBag.Fields;
    var tab = (string)ViewBag.Tab;
    ViewData["PanelTitle"] = $"صفحه‌بندی ماژول {module.PluralLabel}";

    var allModules = ViewBag.AllModules as IReadOnlyList<ModuleDef> ?? Array.Empty<ModuleDef>();
    var relations = ViewBag.Relations as IReadOnlyList<RelationDef> ?? Array.Empty<RelationDef>();
    var moduleMap = allModules.ToDictionary(m => m.Id);

    var ungrouped = fields.Where(f => f.BlockId is null).OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList();
    var fieldsByBlock = fields.Where(f => f.BlockId is not null)
        .GroupBy(f => f.BlockId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList());

    var controllingFields = fields
        .Where(f => f.Type is FieldType.Picklist or FieldType.Text or FieldType.MultilineText)
        .OrderBy(f => f.SortOrder)
        .ToList();

    var lookupFields = ViewBag.LookupFields as IReadOnlyList<FieldDef>
        ?? fields.Where(f => f.Type == FieldType.Lookup).ToList();

    string FieldTypeFa(FieldType t) => t switch
    {
        FieldType.Text => "متن ساده",
        FieldType.MultilineText => "متن چندخطی",
        FieldType.Number => "عدد صحیح",
        FieldType.Decimal => "عدد اعشار",
        FieldType.Currency => "واحد پولی",
        FieldType.Date => "تاریخ",
        FieldType.DateTime => "تاریخ و زمان",
        FieldType.Checkbox => "چک‌باکس",
        FieldType.Picklist => "فیلد انتخابی",
        FieldType.MultiPicklist => "فهرست چندانتخابی",
        FieldType.Email => "ایمیل",
        FieldType.Phone => "تلفن",
        FieldType.Url => "پیوند",
        FieldType.Lookup => "ارجاع",
        FieldType.Percent => "درصد",
        _ => t.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-module-studio.css" asp-append-version="true" />
}

<div class="crm-studio">
    <nav class="crm-studio-breadcrumb" aria-label="مسیر">
        <span>تنظیمات</span>
        <span class="sep">›</span>
        <a href="/App/customize">مدیریت ماژول</a>
        <span class="sep">›</span>
        <span class="current">ویرایش صفحه‌بندی</span>
    </nav>

    <div class="crm-studio-header">
        <div class="crm-studio-header-title">
            <span class="crm-studio-header-icon"><i class="bx @module.Icon"></i></span>
            <div>
                <h1>صفحه‌بندی ماژول @module.PluralLabel</h1>
                <p class="subtitle">چیدمان بلاک‌ها و فیلدهای ماژول را مدیریت کنید · <span dir="ltr">@module.Name</span></p>
            </div>
        </div>
        @if (tab == "layout")
        {
            <div class="crm-studio-actions">
                <button type="button" class="btn btn-studio-outline" data-bs-toggle="modal" data-bs-target="#addBlockModal">
                    <i class="bx bx-plus me-1"></i> افزودن بلاک
                </button>
                <form method="post" action="/App/customize/@module.Name/layout" id="saveLayoutForm" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="layoutJson" id="layoutJson" />
                    <button type="submit" class="btn btn-studio-primary" id="btnSaveLayout">
                        <i class="bx bx-save me-1"></i> تغییر چیدمان
                    </button>
                </form>
            </div>
        }
    </div>

    <partial name="_Alerts" />

    <div class="crm-studio-tablist" role="tablist">
        <a class="crm-studio-tab @(tab == "layout" ? "active" : "")" href="/App/customize/@module.Name?tab=layout" role="tab">صفحه‌بندی ماژول</a>
        <a class="crm-studio-tab @(tab == "relations" ? "active" : "")" href="/App/customize/@module.Name?tab=relations" role="tab">ارتباط ماژول‌ها</a>
        <a class="crm-studio-tab @(tab == "duplicates" ? "active" : "")" href="/App/customize/@module.Name?tab=duplicates" role="tab">مدیریت تکرار رکوردها</a>
        <a class="crm-studio-tab @(tab == "dependencies" ? "active" : "")" href="/App/customize/@module.Name?tab=dependencies" role="tab">بلاک / فیلدهای وابسته</a>
    </div>

@if (tab == "relations")
{
    <div class="crm-studio-panel">
        <div class="crm-studio-panel-header">
            <h5>ارتباط ماژول‌ها</h5>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRelationModal">
                <i class="bx bx-plus me-1"></i> رابطه جدید
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>برچسب</th>
                        <th>ماژول مقابل</th>
                        <th>چند-به-چند</th>
                        <th>فیلد لینک</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (relations.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted text-center py-4">هنوز رابطه‌ای تعریف نشده است.</td></tr>
                    }
                    @foreach (var rel in relations)
                    {
                        var otherId = rel.SourceModuleId == module.Id ? rel.TargetModuleId : rel.SourceModuleId;
                        var otherLabel = moduleMap.TryGetValue(otherId, out ModuleDef? other)
                            ? other.PluralLabel
                            : $"#{otherId}";
                        <tr>
                            <td>@rel.Label</td>
                            <td>@otherLabel</td>
                            <td>@(rel.IsManyToMany ? "بله" : "—")</td>
                            <td dir="ltr"><code>@(rel.LinkFieldName ?? "—")</code></td>
                            <td class="text-end">
                                <form method="post" action="/App/customize/@module.Name/relations/@rel.Id/delete" class="d-inline"
                                      onsubmit="return confirm('رابطه حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade" id="addRelationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" action="/App/customize/@module.Name/relations" class="modal-content" id="addRelationForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">رابطه جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <label class="form-label">ماژول مقصد</label>
                        <select name="targetModuleId" id="relTargetModule" class="form-select" required>
                            <option value="">— انتخاب کنید —</option>
                            @foreach (var m in allModules.Where(m => m.Id != module.Id))
                            {
                                <option value="@m.Id">@m.PluralLabel</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">برچسب</label>
                        <input type="text" name="label" class="form-control" required placeholder="مثلاً فرصت‌های مرتبط" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isManyToMany" value="true" id="relMany" />
                            <label class="form-check-label" for="relMany">چند-به-چند</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">فیلد لینک (Lookup)</label>
                        <select name="linkFieldName" id="relLinkField" class="form-select">
                            <option value="">— اختیاری —</option>
                            @foreach (var lf in lookupFields)
                            {
                                var ownerLabel = moduleMap.TryGetValue(lf.ModuleId, out ModuleDef? owner)
                                    ? owner.PluralLabel
                                    : $"#{lf.ModuleId}";
                                <option value="@lf.Name" data-module-id="@lf.ModuleId">
                                    @lf.Label (@lf.Name) — @ownerLabel
                                </option>
                            }
                        </select>
                        <small class="text-muted">Lookup روی مقصد یا مبدأ که برای لیست مرتبط استفاده می‌شود.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">افزودن</button>
                </div>
            </form>
        </div>
    </div>
}
else if (tab == "duplicates")
{
    var mode = string.IsNullOrWhiteSpace(module.DuplicateMatchMode) ? "or" : module.DuplicateMatchMode.ToLowerInvariant();
    <div class="crm-studio-panel">
        <div class="crm-studio-panel-header">
            <h5>مدیریت تکرار رکوردها</h5>
        </div>
        <div class="crm-studio-panel-body">
            <p class="text-muted small mb-4">
                فیلدهای علامت‌خورده به‌عنوان معیار یکتایی در ایجاد/ویرایش رکورد بررسی می‌شوند.
                در حالت <strong>OR</strong> هر فیلد جداگانه تطبیق داده می‌شود؛ در حالت <strong>AND</strong>
                فقط وقتی همه فیلدهای یکتا با هم روی یک رکورد موجود منطبق باشند، تکراری اعلام می‌شود.
            </p>
            <form method="post" action="/App/customize/@module.Name/duplicates">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label fw-medium">حالت تطبیق</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="modeOr" value="or"
                               @(mode == "or" ? "checked" : null) />
                        <label class="form-check-label" for="modeOr">تطبیق با OR (هر فیلد جداگانه)</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="mode" id="modeAnd" value="and"
                               @(mode == "and" ? "checked" : null) />
                        <label class="form-check-label" for="modeAnd">تطبیق با AND (ترکیب فیلدها)</label>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">فیلدهای یکتا</label>
                    @foreach (var field in fields.OrderBy(f => f.SortOrder).ThenBy(f => f.Id))
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="uniqueFieldIds" value="@field.Id"
                                   id="uniq_@field.Id" @(field.IsUniqueCheck ? "checked" : null) />
                            <label class="form-check-label" for="uniq_@field.Id">
                                @field.Label <span class="text-muted" dir="ltr">(@field.Name)</span>
                            </label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> ذخیره
                </button>
            </form>
        </div>
    </div>
}
else if (tab == "dependencies")
{
    var depFields = fields.Where(f => !string.IsNullOrWhiteSpace(f.VisibilityRuleJson)).OrderBy(f => f.SortOrder).ToList();
    var depBlocks = blocks.Where(b => !string.IsNullOrWhiteSpace(b.VisibilityRuleJson)).OrderBy(b => b.SortOrder).ToList();
    <div class="crm-studio-panel">
        <div class="crm-studio-panel-header">
            <h5>بلاک / فیلدهای وابسته</h5>
        </div>
        <div class="crm-studio-panel-body">
            <p class="text-muted small mb-4">
                وابستگی‌ها مشخص می‌کنند یک فیلد یا بلاک فقط وقتی نمایش داده شود که شرط روی فیلد دیگری برقرار باشد.
                برای تنظیم، از «ویرایش گروه» روی بلاک یا مداد فیلد در تب صفحه‌بندی استفاده کنید.
            </p>
            <h6 class="mb-2">فیلدهای وابسته (@depFields.Count)</h6>
            @if (depFields.Count == 0)
            {
                <p class="text-muted small">هنوز فیلد وابسته‌ای تعریف نشده است.</p>
            }
            else
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm">
                        <thead><tr><th>فیلد</th><th>شرط</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var field in depFields)
                        {
                            <tr>
                                <td>@field.Label</td>
                                <td dir="ltr"><code class="small">@field.VisibilityRuleJson</code></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-label-primary"
                                            data-bs-toggle="modal" data-bs-target="#editFieldModal"
                                            data-id="@field.Id"
                                            data-label="@field.Label"
                                            data-required="@field.IsRequired.ToString().ToLowerInvariant()"
                                            data-showinlist="@field.ShowInList.ToString().ToLowerInvariant()"
                                            data-sort="@field.SortOrder"
                                            data-blockid="@(field.BlockId?.ToString() ?? "")"
                                            data-maxlength="@(field.MaxLength?.ToString() ?? "")"
                                            data-visible="@field.IsVisible.ToString().ToLowerInvariant()"
                                            data-unique="@field.IsUniqueCheck.ToString().ToLowerInvariant()"
                                            data-default="@(field.DefaultValue ?? "")"
                                            data-rule="@(field.VisibilityRuleJson ?? "")"
                                            data-type="@((int)field.Type)"
                                            data-integerdigits="@(field.IntegerDigits?.ToString() ?? "")"
                                            data-decimaldigits="@(field.DecimalDigits?.ToString() ?? "")"
                                            data-formula="@(field.FormulaExpression ?? "")"
                                            data-validation="@(field.ValidationRulesJson ?? "")"
                                            data-picklist="@(field.Type is FieldType.Picklist or FieldType.MultiPicklist ? string.Join("\n", field.PicklistValues.OrderBy(p => p.SortOrder).Select(p => p.Label)) : "")">ویرایش</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <h6 class="mb-2">بلاک‌های وابسته (@depBlocks.Count)</h6>
            @if (depBlocks.Count == 0)
            {
                <p class="text-muted small mb-0">هنوز بلاک وابسته‌ای تعریف نشده است.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>بلاک</th><th>شرط</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var block in depBlocks)
                        {
                            <tr>
                                <td>@block.Label</td>
                                <td dir="ltr"><code class="small">@block.VisibilityRuleJson</code></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-label-primary"
                                            data-bs-toggle="modal" data-bs-target="#editBlockRuleModal"
                                            data-id="@block.Id"
                                            data-label="@block.Label"
                                            data-sort="@block.SortOrder"
                                            data-collapsed="@block.IsCollapsed.ToString().ToLowerInvariant()"
                                            data-rule="@(block.VisibilityRuleJson ?? "")">ویرایش</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else if (tab == "layout")
{
    <div id="studio-layout" class="studio-layout">
        @foreach (var block in blocks.OrderBy(b => b.SortOrder).ThenBy(b => b.Id))
        {
            var blockFields = fieldsByBlock.GetValueOrDefault(block.Id) ?? new List<FieldDef>();
            var hiddenCount = blockFields.Count(f => !f.IsVisible);
            var collapseId = $"block-body-{block.Id}";
            var isCollapsed = block.IsCollapsed;
            <div class="studio-block @(isCollapsed ? "is-collapsed" : "")" data-block-id="@block.Id">
                <div class="studio-block-header studio-block-handle">
                    <div class="studio-block-title">
                        <i class="bx bx-grid-vertical"></i>
                        <strong>@block.Label</strong>
                        @if (hiddenCount > 0)
                        {
                            <span class="hint">(@hiddenCount پنهان)</span>
                        }
                    </div>
                    <div class="studio-block-actions">
                        <button type="button" class="studio-action studio-toggle-collapse"
                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                aria-expanded="@(!isCollapsed)" aria-controls="@collapseId"
                                title="بستن/بازکردن">
                            <i class="bx bx-chevron-up studio-collapse-icon"></i>
                            <span class="studio-collapse-label">@(isCollapsed ? "باز شدن" : "بسته شدن")</span>
                        </button>
                        @if (hiddenCount > 0)
                        {
                            <button type="button" class="studio-action studio-toggle-hidden" title="نمایش فیلدهای پنهان">
                                <i class="bx bx-hide"></i>
                                <span>نمایش فیلدهای پنهان</span>
                            </button>
                        }
                        <button type="button" class="studio-action"
                                data-bs-toggle="modal" data-bs-target="#editBlockRuleModal"
                                data-id="@block.Id"
                                data-label="@block.Label"
                                data-sort="@block.SortOrder"
                                data-collapsed="@block.IsCollapsed.ToString().ToLowerInvariant()"
                                data-rule="@(block.VisibilityRuleJson ?? "")"
                                title="ویرایش گروه">
                            <i class="bx bx-edit-alt"></i>
                            <span>ویرایش گروه</span>
                        </button>
                        <form method="post" action="/App/customize/@module.Name/blocks/@block.Id/delete" class="m-0 d-inline"
                              onsubmit="return confirm('بلاک حذف شود؟ فیلدها بدون گروه می‌مانند.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="studio-action studio-action--danger" title="حذف">
                                <i class="bx bx-trash"></i>
                                <span>حذف</span>
                            </button>
                        </form>
                    </div>
                </div>
                <div id="@collapseId" class="studio-block-body collapse @(isCollapsed ? "" : "show")">
                    <div class="studio-fields" data-block-id="@block.Id"
                         data-empty-msg="هنوز فیلدی در این بلاک نیست — فیلدها را بکشید یا اضافه کنید.">
                        @if (blockFields.Count == 0)
                        {
                            <div class="studio-fields-empty">هنوز فیلدی در این بلاک نیست — فیلدها را بکشید یا اضافه کنید.</div>
                        }
                        @foreach (var field in blockFields)
                        {
                            <div class="studio-field @(field.IsVisible ? "" : "studio-field--hidden")" data-field-id="@field.Id">
                                <div class="studio-field-card">
                                    <i class="bx bx-move studio-field-handle" title="جابه‌جایی"></i>
                                    <div class="studio-field-meta">
                                        <div class="studio-field-label">@field.Label</div>
                                        <div class="studio-field-type">@FieldTypeFa(field.Type)</div>
                                    </div>
                                    <div class="studio-field-badges">
                                        @if (field.IsRequired)
                                        {
                                            <span class="studio-badge-required">اجباری</span>
                                        }
                                        @if (!field.IsVisible)
                                        {
                                            <span class="studio-badge-hidden">پنهان</span>
                                        }
                                    </div>
                                    <button type="button" class="studio-field-edit"
                                            data-bs-toggle="modal" data-bs-target="#editFieldModal"
                                            data-id="@field.Id"
                                            data-label="@field.Label"
                                            data-required="@field.IsRequired.ToString().ToLowerInvariant()"
                                            data-showinlist="@field.ShowInList.ToString().ToLowerInvariant()"
                                            data-sort="@field.SortOrder"
                                            data-blockid="@(field.BlockId?.ToString() ?? "")"
                                            data-maxlength="@(field.MaxLength?.ToString() ?? "")"
                                            data-visible="@field.IsVisible.ToString().ToLowerInvariant()"
                                            data-unique="@field.IsUniqueCheck.ToString().ToLowerInvariant()"
                                            data-default="@(field.DefaultValue ?? "")"
                                            data-rule="@(field.VisibilityRuleJson ?? "")"
                                            data-type="@((int)field.Type)"
                                            data-integerdigits="@(field.IntegerDigits?.ToString() ?? "")"
                                            data-decimaldigits="@(field.DecimalDigits?.ToString() ?? "")"
                                            data-formula="@(field.FormulaExpression ?? "")"
                                            data-validation="@(field.ValidationRulesJson ?? "")"
                                            data-picklist="@(field.Type is FieldType.Picklist or FieldType.MultiPicklist ? string.Join("\n", field.PicklistValues.OrderBy(p => p.SortOrder).Select(p => p.Label)) : "")"
                                            title="ویرایش">
                                        <i class="bx bx-pencil"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="studio-add-field-dashed studio-add-field-to-block"
                            data-bs-toggle="modal" data-bs-target="#addFieldModal"
                            data-block-id="@block.Id">
                        <i class="bx bx-plus"></i> افزودن فیلد سفارشی
                    </button>
                </div>
            </div>
        }

        @if (ungrouped.Count > 0)
        {
            <div class="studio-block is-ungrouped" data-block-id="">
                <div class="studio-block-header">
                    <div class="studio-block-title">
                        <i class="bx bx-grid-vertical"></i>
                        <strong>بدون بلاک</strong>
                        <span class="hint">فیلدهایی که هنوز گروه نشده‌اند</span>
                    </div>
                    <div class="studio-block-actions">
                        @{
                            var ungroupedHidden = ungrouped.Count(f => !f.IsVisible);
                        }
                        @if (ungroupedHidden > 0)
                        {
                            <button type="button" class="studio-action studio-toggle-hidden" title="نمایش فیلدهای پنهان">
                                <i class="bx bx-hide"></i>
                                <span>نمایش فیلدهای پنهان</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="studio-block-body">
                    <div class="studio-fields" data-block-id=""
                         data-empty-msg="همه فیلدها داخل بلاک‌ها هستند.">
                        @foreach (var field in ungrouped)
                        {
                            <div class="studio-field @(field.IsVisible ? "" : "studio-field--hidden")" data-field-id="@field.Id">
                                <div class="studio-field-card">
                                    <i class="bx bx-move studio-field-handle" title="جابه‌جایی"></i>
                                    <div class="studio-field-meta">
                                        <div class="studio-field-label">@field.Label</div>
                                        <div class="studio-field-type">@FieldTypeFa(field.Type)</div>
                                    </div>
                                    <div class="studio-field-badges">
                                        @if (field.IsRequired)
                                        {
                                            <span class="studio-badge-required">اجباری</span>
                                        }
                                        @if (!field.IsVisible)
                                        {
                                            <span class="studio-badge-hidden">پنهان</span>
                                        }
                                    </div>
                                    <button type="button" class="studio-field-edit"
                                            data-bs-toggle="modal" data-bs-target="#editFieldModal"
                                            data-id="@field.Id"
                                            data-label="@field.Label"
                                            data-required="@field.IsRequired.ToString().ToLowerInvariant()"
                                            data-showinlist="@field.ShowInList.ToString().ToLowerInvariant()"
                                            data-sort="@field.SortOrder"
                                            data-blockid=""
                                            data-maxlength="@(field.MaxLength?.ToString() ?? "")"
                                            data-visible="@field.IsVisible.ToString().ToLowerInvariant()"
                                            data-unique="@field.IsUniqueCheck.ToString().ToLowerInvariant()"
                                            data-default="@(field.DefaultValue ?? "")"
                                            data-rule="@(field.VisibilityRuleJson ?? "")"
                                            data-type="@((int)field.Type)"
                                            data-integerdigits="@(field.IntegerDigits?.ToString() ?? "")"
                                            data-decimaldigits="@(field.DecimalDigits?.ToString() ?? "")"
                                            data-formula="@(field.FormulaExpression ?? "")"
                                            data-validation="@(field.ValidationRulesJson ?? "")"
                                            data-picklist="@(field.Type is FieldType.Picklist or FieldType.MultiPicklist ? string.Join("\n", field.PicklistValues.OrderBy(p => p.SortOrder).Select(p => p.Label)) : "")"
                                            title="ویرایش">
                                        <i class="bx bx-pencil"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="studio-add-field-dashed studio-add-field-to-block"
                            data-bs-toggle="modal" data-bs-target="#addFieldModal"
                            data-block-id="">
                        <i class="bx bx-plus"></i> افزودن فیلد سفارشی
                    </button>
                </div>
            </div>
        }
    </div>
}
</div>

