@* Modal: add field (type-aware wizard) *@
<div class="modal fade" id="addFieldModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" action="/App/customize/@module.Name/fields" class="modal-content crm-field-wizard" id="addFieldForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="blockId" id="addFieldBlockId" value="" />
            <input type="hidden" name="visibilityRuleJson" id="addRuleJson" value="" />
            <input type="hidden" name="validationRulesJson" id="addValidationJson" value="" />
            <input type="hidden" name="name" id="addFieldName" value="" />
            <input type="hidden" name="picklistOptions" id="addPicklistOptions" value="" />
            <input type="hidden" name="defaultValue" id="addDefaultValueHidden" value="" />
            <input type="hidden" name="integerDigits" id="addIntegerDigitsHidden" value="" />
            <input type="hidden" name="maxLength" id="addMaxLengthHidden" value="" />

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">افزودن فیلد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="crm-field-wizard-steps" id="addFieldSteps">
                <button type="button" class="crm-field-wizard-step is-active" data-step-key="info"><span>1</span> اطلاعات فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="props"><span>2</span> ویژگی‌های فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="validation"><span>3</span> اعتبارسنجی فیلد</button>
                <button type="button" class="crm-field-wizard-step" data-step-key="formula"><span>4</span> فرمول</button>
            </div>

            <div class="modal-body">
                @* —— Step: info —— *@
                <div class="crm-field-wizard-pane is-active" data-pane-key="info">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نوع فیلد <span class="text-danger">*</span></label>
                            <select name="type" id="addFieldType" class="form-select" required>
                                @foreach (FieldType ft in Enum.GetValues(typeof(FieldType)))
                                {
                                    if (ft is FieldType.Lookup or FieldType.MultiPicklist) { continue; }
                                    <option value="@((int)ft)">@FieldTypeFa(ft)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">برچسب فیلد <span class="text-danger">*</span></label>
                            <input type="text" name="label" id="addFieldLabel" class="form-control" required placeholder="مثلاً کد ملی" />
                        </div>

                        @* text-like *@
                        <div class="col-md-6" data-for-types="0,1,10,11,12">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultValue" class="form-control" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="0,1,10,11,12">
                            <label class="form-label">حداکثر کاراکتر مجاز</label>
                            <input type="number" id="addMaxLength" class="form-control" min="1" max="4000" placeholder="مثلاً ۲۵۵" data-maxlength-sync="1" />
                        </div>

                        @* number *@
                        <div class="col-md-6" data-for-types="2">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultNumber" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="2">
                            <label class="form-label">حداکثر رقم مجاز <span class="text-danger">*</span></label>
                            <input type="number" id="addMaxDigits" class="form-control" min="1" max="18" placeholder="مثلاً ۱۰" data-integer-digits="1" />
                        </div>

                        @* decimal *@
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultDecimal" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">تعداد ارقام صحیح <span class="text-danger">*</span></label>
                            <input type="number" id="addIntegerDigitsDec" class="form-control" min="1" max="18" placeholder="مثلاً ۱۰" data-integer-digits="1" />
                        </div>
                        <div class="col-md-6" data-for-types="3">
                            <label class="form-label">تعداد ارقام اعشاری <span class="text-danger">*</span></label>
                            <input type="number" name="decimalDigits" id="addDecimalDigits" class="form-control" min="0" max="10" placeholder="مثلاً ۲" />
                        </div>
                        <div class="col-12" data-for-types="3">
                            <p class="text-muted small mb-0">مجموع تعداد ارقام اعشاری و صحیح نباید بیشتر از ۱۸ باشد.</p>
                        </div>

                        @* currency *@
                        <div class="col-md-6" data-for-types="4">
                            <label class="form-label">مقدار پیش‌فرض (﷼)</label>
                            <input type="text" id="addDefaultCurrency" class="form-control" dir="ltr" data-default-sync="1" />
                        </div>
                        <div class="col-md-6" data-for-types="4">
                            <label class="form-label">حداکثر رقم مجاز <span class="text-danger">*</span></label>
                            <input type="number" id="addCurrencyDigits" class="form-control" min="1" max="18" placeholder="مثلاً ۱۲" data-integer-digits="1" />
                        </div>

                        @* percent — no default needed *@
                        <div class="col-12" data-for-types="14">
                            <p class="text-muted small mb-0">مقدار درصد به‌صورت عددی ذخیره می‌شود (مثلاً ۲۵ برای ۲۵٪).</p>
                        </div>

                        @* date *@
                        <div class="col-md-6" data-for-types="5,6">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <input type="text" id="addDefaultDate" class="form-control" dir="ltr" data-default-sync="1" placeholder="اختیاری" />
                        </div>
                        <div class="col-md-6" data-for-types="5,6">
                            <div class="form-check mt-4">
                                <input type="hidden" name="defaultToday" value="false" />
                                <input class="form-check-input" type="checkbox" name="defaultToday" value="true" id="addDefaultToday" />
                                <label class="form-check-label" for="addDefaultToday">مقدار پیش‌فرض فیلد، تاریخ روز باشد</label>
                            </div>
                        </div>

                        @* checkbox *@
                        <div class="col-md-6" data-for-types="7">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <select id="addDefaultCheckbox" class="form-select" data-default-sync="1">
                                <option value="false">خیر</option>
                                <option value="true">بله</option>
                            </select>
                        </div>

                        @* picklist options *@
                        <div class="col-12" data-for-types="8">
                            <label class="form-label">انتخاب مقادیر قابل انتخاب <span class="text-danger">*</span></label>
                            <div id="addPicklistRows" class="crm-picklist-editor mb-2"></div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addPicklistRowBtn">
                                <i class="bx bx-plus"></i> افزودن گزینه
                            </button>
                        </div>
                        <div class="col-md-6" data-for-types="8">
                            <label class="form-label">مقدار پیش‌فرض</label>
                            <select id="addPicklistDefault" class="form-select" data-default-sync="1">
                                <option value="">— بدون پیش‌فرض —</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isVisible" value="false" />
                                <input class="form-check-input" type="checkbox" name="isVisible" value="true" id="addIsVisible" checked />
                                <label class="form-check-label" for="addIsVisible">نمایش فیلد</label>
                            </div>
                            <p class="text-muted small mb-0 mt-1">احتیاط: اگر این فیلد در همگام‌سازی یا جریان کاری استفاده شود، پس از مخفی کردن دیگر به‌روزرسانی نمی‌شود.</p>
                        </div>
                    </div>
                </div>

                @* —— Step: props —— *@
                <div class="crm-field-wizard-pane" data-pane-key="props">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isRequired" value="false" />
                                <input class="form-check-input" type="checkbox" name="isRequired" value="true" id="addIsRequired" />
                                <label class="form-check-label" for="addIsRequired">اجباری</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="showInList" value="false" />
                                <input class="form-check-input" type="checkbox" name="showInList" value="true" id="addShowInList" checked />
                                <label class="form-check-label" for="addShowInList">افزودن سریع / نمایش در لیست</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="hidden" name="isUniqueCheck" value="false" />
                                <input class="form-check-input" type="checkbox" name="isUniqueCheck" value="true" id="addIsUnique" />
                                <label class="form-check-label" for="addIsUnique">فیلد کلیدی (یکتا)</label>
                            </div>
                        </div>
                    </div>
                </div>

                @* —— Step: validation —— *@
                <div class="crm-field-wizard-pane" data-pane-key="validation">
                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="addValidationRuleBtn">
                            <i class="bx bx-plus"></i> افزودن قانون جدید
                        </button>
                    </div>
                    <div id="addValidationRulesList" class="crm-validation-rules"></div>
                    <p class="text-muted small mt-3 mb-0">قوانین بر اساس نوع فیلد تغییر می‌کنند و هنگام ذخیره رکورد اعمال می‌شوند.</p>
                    <script type="application/json" id="studio-date-fields-json">
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            fields.Where(f => f.Type is FieldType.Date or FieldType.DateTime)
                                .Select(f => new { name = f.Name, label = f.Label })
                                .ToList()))
                    </script>
                </div>

                @* —— Step: formula —— *@
                <div class="crm-field-wizard-pane" data-pane-key="formula">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="addFormulaEnabled" />
                                <label class="form-check-label" for="addFormulaEnabled">محاسبه مقدار فیلد با فرمول</label>
                            </div>
                            <textarea name="formulaExpression" id="addFormulaExpression" class="form-control" rows="4" dir="ltr" placeholder="مثلاً {price} * {qty}" disabled></textarea>
                            <p class="text-warning small mt-2 mb-0">
                                احتیاط: فیلدهایی که برای آن‌ها فرمول تعریف شده یا در فرمول فیلد دیگری استفاده شده‌اند، به‌عنوان فیلد سرفصل یا کلیدی توصیه نمی‌شوند.
                                موتور محاسبه در این نسخه ذخیره می‌شود و بعداً اجرا خواهد شد.
                            </p>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <label class="form-label">شرط نمایش (وابستگی)</label>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <select id="addDepField" class="form-select">
                                        <option value="">— بدون شرط —</option>
                                        @foreach (var cf in controllingFields)
                                        {
                                            <option value="@cf.Name">@cf.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select id="addDepOp" class="form-select">
                                        <option value="eq">برابر</option>
                                        <option value="neq">نابرابر</option>
                                        <option value="contains">شامل</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <input type="text" id="addDepValue" class="form-control" placeholder="مقدار" dir="ltr" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" id="addFieldPrev" hidden>قبلی</button>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-primary" id="addFieldNext">بعدی</button>
                    <button type="submit" class="btn btn-primary" id="addFieldSubmit" hidden>ذخیره</button>
                </div>
            </div>
        </form>
    </div>
</div>

