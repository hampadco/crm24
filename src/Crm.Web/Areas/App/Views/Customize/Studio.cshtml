@using Crm.Core.Entities
@using Crm.Web.Services
@using System.Text.Json
@{
    var module = (ModuleDef)ViewBag.Module;
    var blocks = (IReadOnlyList<FieldBlock>)ViewBag.Blocks;
    var fields = (IReadOnlyList<FieldDef>)ViewBag.Fields;
    var tab = (string)ViewBag.Tab;
    ViewData["PanelTitle"] = $"صفحه‌بندی ماژول {module.PluralLabel}";

    var allModules = ViewBag.AllModules as IReadOnlyList<ModuleDef> ?? Array.Empty<ModuleDef>();
    var relations = ViewBag.Relations as IReadOnlyList<RelationDef> ?? Array.Empty<RelationDef>();
    var moduleMap = allModules.ToDictionary(m => m.Id);

    var ungrouped = fields.Where(f => f.BlockId is null).OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList();
    var fieldsByBlock = fields.Where(f => f.BlockId is not null)
        .GroupBy(f => f.BlockId!.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList());

    var controllingFields = fields
        .Where(f => f.Type is FieldType.Picklist or FieldType.Text or FieldType.MultilineText)
        .OrderBy(f => f.SortOrder)
        .ToList();

    var lookupFields = ViewBag.LookupFields as IReadOnlyList<FieldDef>
        ?? fields.Where(f => f.Type == FieldType.Lookup).ToList();

    string FieldTypeFa(FieldType t) => t switch
    {
        FieldType.Text => "متن ساده",
        FieldType.MultilineText => "متن چندخطی",
        FieldType.Number => "عدد صحیح",
        FieldType.Decimal => "عدد اعشار",
        FieldType.Currency => "واحد پولی",
        FieldType.Date => "تاریخ",
        FieldType.DateTime => "تاریخ و زمان",
        FieldType.Checkbox => "چک‌باکس",
        FieldType.Picklist => "فیلد انتخابی",
        FieldType.MultiPicklist => "فهرست چندانتخابی",
        FieldType.Email => "ایمیل",
        FieldType.Phone => "تلفن",
        FieldType.Url => "پیوند",
        FieldType.Lookup => "ارجاع",
        FieldType.Percent => "درصد",
        _ => t.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-module-studio.css" asp-append-version="true" />
}

<div class="crm-studio">
    <nav class="crm-studio-breadcrumb" aria-label="مسیر">
        <span>تنظیمات</span>
        <span class="sep">›</span>
        <a href="/App/customize">مدیریت ماژول</a>
        <span class="sep">›</span>
        <span class="current">ویرایش صفحه‌بندی</span>
    </nav>

    <div class="crm-studio-header">
        <div class="crm-studio-header-title">
            <span class="crm-studio-header-icon"><i class="bx @module.Icon"></i></span>
            <div>
                <h1>صفحه‌بندی ماژول @module.PluralLabel</h1>
                <p class="subtitle">چیدمان بلاک‌ها و فیلدهای ماژول را مدیریت کنید · <span dir="ltr">@module.Name</span></p>
            </div>
        </div>
        @if (tab == "layout")
        {
            <div class="crm-studio-actions">
                <button type="button" class="btn btn-studio-outline" data-bs-toggle="modal" data-bs-target="#addBlockModal">
                    <i class="bx bx-plus me-1"></i> افزودن بلاک
                </button>
                <form method="post" action="/App/customize/@module.Name/layout" id="saveLayoutForm" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="layoutJson" id="layoutJson" />
                    <button type="submit" class="btn btn-studio-primary" id="btnSaveLayout">
                        <i class="bx bx-save me-1"></i> تغییر چیدمان
                    </button>
                </form>
            </div>
        }
    </div>

    <partial name="_Alerts" />

    <div class="crm-studio-tablist" role="tablist">
        <a class="crm-studio-tab @(tab == "layout" ? "active" : "")" href="/App/customize/@module.Name?tab=layout" role="tab">صفحه‌بندی ماژول</a>
        <a class="crm-studio-tab @(tab == "relations" ? "active" : "")" href="/App/customize/@module.Name?tab=relations" role="tab">ارتباط ماژول‌ها</a>
        <a class="crm-studio-tab @(tab == "duplicates" ? "active" : "")" href="/App/customize/@module.Name?tab=duplicates" role="tab">مدیریت تکرار رکوردها</a>
        <a class="crm-studio-tab @(tab == "dependencies" ? "active" : "")" href="/App/customize/@module.Name?tab=dependencies" role="tab">بلاک / فیلدهای وابسته</a>
        <a class="crm-studio-tab @(tab == "settings" ? "active" : "")" href="/App/customize/@module.Name?tab=settings" role="tab">تنظیمات</a>
    </div>

@if (tab == "settings")
{
    var menuGroups = new (string Value, string Label)[]
    {
        ("marketing", "بازاریابی"),
        ("sales", "فروش"),
        ("support", "پشتیبانی"),
        ("inventory", "انبار"),
        ("projects", "پروژه‌ها"),
        ("tools", "ابزارها")
    };
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4">
            <h5 class="mb-3">تنظیمات ماژول</h5>
            <form method="post" action="/App/customize/@module.Name/settings" class="row g-3" style="max-width:40rem">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label">برچسب مفرد</label>
                    <input type="text" name="singularLabel" class="form-control" value="@module.SingularLabel" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">برچسب جمع</label>
                    <input type="text" name="pluralLabel" class="form-control" value="@module.PluralLabel" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">آیکون (Boxicons)</label>
                    <input type="text" name="icon" class="form-control" dir="ltr" value="@module.Icon" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">گروه منو</label>
                    <select name="menuGroup" class="form-select">
                        @foreach (var g in menuGroups)
                        {
                            if (string.Equals(module.MenuGroup, g.Value, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@g.Value" selected>@g.Label</option>
                            }
                            else
                            {
                                <option value="@g.Value">@g.Label</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="showInMenu" value="true" id="showInMenu"
                               @(module.ShowInMenu ? "checked" : null)
                               @(module.IsChildModule ? "disabled" : null) />
                        <label class="form-check-label" for="showInMenu">نمایش در منوی اصلی</label>
                    </div>
                    @if (module.IsChildModule)
                    {
                        <div class="form-text">ماژول‌های فرزند در منو نمایش داده نمی‌شوند.</div>
                    }
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-studio-primary">
                        <i class="bx bx-save me-1"></i> ذخیره تنظیمات
                    </button>
                </div>
            </form>
        </div>
    </div>
}
else if (tab == "relations")
{
    string KindFa(RelationKind k) => k switch
    {
        RelationKind.OneToOne => "یک به یک",
        RelationKind.OneToMany => "یک به چند",
        RelationKind.ManyToOne => "چند به یک",
        RelationKind.ManyToMany => "چند به چند",
        _ => k.ToString()
    };

    RelationKind EffectiveKind(RelationDef r) =>
        r.IsManyToMany ? RelationKind.ManyToMany : r.Kind;

    var relationSections = new (string Title, List<RelationDef> Items)[]
    {
        ("یک به یک و چند به یک", relations.Where(r =>
        {
            var k = EffectiveKind(r);
            return k is RelationKind.OneToOne or RelationKind.ManyToOne;
        }).ToList()),
        ("یک به چند", relations.Where(r => EffectiveKind(r) == RelationKind.OneToMany).ToList()),
        ("چند به چند", relations.Where(r => EffectiveKind(r) == RelationKind.ManyToMany).ToList())
    };

    <div class="crm-studio-panel">
        <div class="crm-studio-panel-header">
            <div>
                <h5 class="mb-0">ماژول مرتبط</h5>
                <p class="text-muted small mb-0 mt-1">روابط @module.PluralLabel با سایر ماژول‌ها</p>
            </div>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRelationModal">
                <i class="bx bx-plus me-1"></i> افزودن رابطه
            </button>
        </div>
        <div class="p-3">
            @foreach (var (sectionTitle, items) in relationSections)
            {
                <div class="crm-rel-section mb-4">
                    <div class="crm-rel-section-title">@sectionTitle</div>
                    @if (items.Count == 0)
                    {
                        <p class="text-muted small mb-0 py-2">هیچ رابطه‌ای تعریف نشده است.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>نام زبانه</th>
                                        <th>ماژول مرتبط</th>
                                        <th>نوع</th>
                                        <th>نام فیلد</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var rel in items)
                                {
                                    var otherId = rel.SourceModuleId == module.Id ? rel.TargetModuleId : rel.SourceModuleId;
                                    var otherLabel = moduleMap.TryGetValue(otherId, out ModuleDef? other)
                                        ? other.PluralLabel
                                        : $"#{otherId}";
                                    <tr>
                                        <td>@rel.Label</td>
                                        <td>@otherLabel</td>
                                        <td>@KindFa(EffectiveKind(rel))</td>
                                        <td>@(rel.RelatedFieldLabel ?? rel.LinkFieldName ?? "—")</td>
                                        <td class="text-end">
                                            <form method="post" action="/App/customize/@module.Name/relations/@rel.Id/delete" class="d-inline"
                                                  onsubmit="return confirm('رابطه حذف شود؟');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="addRelationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" action="/App/customize/@module.Name/relations" class="modal-content" id="addRelationForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">افزودن رابطه</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-12">
                        <label class="form-label">نوع رابطه</label>
                        <div class="crm-rel-kind-pills" role="radiogroup">
                            <label class="crm-rel-kind-pill">
                                <input type="radio" name="kind" value="@((int)RelationKind.OneToMany)" checked />
                                <span>یک به چند</span>
                            </label>
                            <label class="crm-rel-kind-pill">
                                <input type="radio" name="kind" value="@((int)RelationKind.ManyToOne)" />
                                <span>چند به یک</span>
                            </label>
                            <label class="crm-rel-kind-pill">
                                <input type="radio" name="kind" value="@((int)RelationKind.ManyToMany)" />
                                <span>چند به چند</span>
                            </label>
                            <label class="crm-rel-kind-pill">
                                <input type="radio" name="kind" value="@((int)RelationKind.OneToOne)" />
                                <span>یک به یک</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">انتخاب ماژول‌های مرتبط <span class="text-danger">*</span></label>
                        <select name="targetModuleId" id="relTargetModule" class="form-select" required>
                            <option value="">انتخاب</option>
                            @foreach (var m in allModules.Where(m => m.Id != module.Id))
                            {
                                <option value="@m.Id"
                                        data-singular="@m.SingularLabel"
                                        data-plural="@m.PluralLabel">@m.PluralLabel</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">نام زبانه در رکورد @module.SingularLabel <span class="text-danger">*</span></label>
                        <input type="text" name="label" id="relTabLabel" class="form-control" required
                               placeholder="مثلاً فرصت‌های فروش" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">نام فیلد @module.PluralLabel در رکورد مرتبط <span class="text-danger">*</span></label>
                        <input type="text" name="relatedFieldLabel" id="relFieldLabel" class="form-control" required
                               value="@module.SingularLabel" />
                        <small class="text-muted">روی ماژول مقابل به‌عنوان فیلد Lookup ساخته می‌شود (به‌جز چند‌به‌چند).</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">لغو</button>
                    <button type="submit" class="btn btn-primary">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
}
else if (tab == "duplicates")
{
    var enabled = module.DuplicateCheckEnabled;
    var mode = string.IsNullOrWhiteSpace(module.DuplicateMatchMode) ? "or" : module.DuplicateMatchMode.ToLowerInvariant();
    var ignoreEmpty = module.DuplicateIgnoreEmpty;
    var syncPolicy = string.IsNullOrWhiteSpace(module.DuplicateSyncPolicy) ? "latest" : module.DuplicateSyncPolicy.ToLowerInvariant();
    var globalEnabled = module.GlobalDuplicateEnabled;
    var uniqueFields = fields.Where(f => f.IsUniqueCheck).OrderBy(f => f.SortOrder).ThenBy(f => f.Id).Take(3).ToList();
    var globalFields = fields.Where(f => f.IsGlobalUniqueCheck && f.Type == FieldType.Phone).OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList();
    var phoneFields = fields.Where(f => f.Type == FieldType.Phone).OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList();
    var orderedFields = fields.OrderBy(f => f.SortOrder).ThenBy(f => f.Id).ToList();

    string DupTypeFa(FieldType t) => t switch
    {
        FieldType.Phone => "شماره تماس",
        FieldType.Email => "ایمیل",
        _ => FieldTypeFa(t)
    };

    var cardTints = new[] { "tint-sky", "tint-peach", "tint-mint", "tint-lavender", "tint-sand" };
    <form method="post" action="/App/customize/@module.Name/duplicates" id="dupForm" class="crm-dup-wizard" data-dup-wizard>
        @Html.AntiForgeryToken()

        <div class="crm-dup-intro">
            مدیریت تکرار، تنها رکوردهای جدیدی که توسط کاربر یا نرم‌افزارهای متصل ثبت می‌شوند را بررسی می‌کند
            و از ایجاد رکورد تکراری جلوگیری می‌کند.
        </div>

        <div class="crm-dup-master">
            <label class="crm-dup-switch">
                <input type="checkbox" name="enabled" value="true" data-dup-enabled @(enabled ? "checked" : null) />
                <span class="crm-dup-switch-ui" aria-hidden="true"></span>
                <span class="crm-dup-switch-label">فعال کردن بررسی رکوردهای تکراری</span>
            </label>
        </div>

        <div class="crm-dup-steps @(enabled ? null : "is-disabled")" data-dup-steps>
            @* ── Step 1: field selection ── *@
            <section class="crm-dup-step">
                <aside class="crm-dup-step-rail">
                    <span class="crm-dup-step-num">۱</span>
                    <span class="crm-dup-step-title">انتخاب فیلد</span>
                </aside>
                <div class="crm-dup-step-body">
                    <p class="crm-dup-step-lead">
                        برای بررسی رکوردهای تکراری، فیلد یکتایی انتخاب کنید
                        <span class="text-muted">(حداکثر ۳ فیلد)</span>
                    </p>

                    <div class="crm-dup-cards" data-dup-unique-cards data-max="3">
                        @if (uniqueFields.Count == 0)
                        {
                            <div class="crm-dup-empty" data-dup-unique-empty>هنوز فیلد یکتایی انتخاب نشده است.</div>
                        }
                        @for (var i = 0; i < uniqueFields.Count; i++)
                        {
                            var field = uniqueFields[i];
                            <div class="crm-dup-card @cardTints[i % cardTints.Length]" data-dup-card data-field-id="@field.Id">
                                <input type="hidden" name="uniqueFieldIds" value="@field.Id" />
                                <div class="crm-dup-card-main">
                                    <span class="crm-dup-card-key"><i class="bx bx-key"></i></span>
                                    <div class="crm-dup-card-text">
                                        <strong>@field.Label</strong>
                                        <span class="crm-dup-card-type">(@DupTypeFa(field.Type))</span>
                                    </div>
                                </div>
                                <div class="crm-dup-card-actions">
                                    <span class="crm-dup-card-handle" title="جابجایی"><i class="bx bx-grid-alt"></i></span>
                                    <div class="dropdown">
                                        <button type="button" class="crm-dup-card-edit dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bx-edit-alt"></i><span>ویرایش</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" data-dup-unique-remove>
                                                    <i class="bx bx-trash me-1"></i> حذف از معیار تکرار
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="crm-dup-picker">
                        <label class="crm-dup-picker-label" for="dupUniqueSelect">افزودن فیلد یکتا</label>
                        <div class="crm-dup-picker-row">
                            <select id="dupUniqueSelect" class="form-select" data-dup-unique-select>
                                <option value="">انتخاب فیلد…</option>
                                @foreach (var field in orderedFields)
                                {
                                    var taken = field.IsUniqueCheck;
                                    if (taken)
                                    {
                                        <option value="@field.Id" data-label="@field.Label" data-type="@DupTypeFa(field.Type)" disabled>@field.Label</option>
                                    }
                                    else
                                    {
                                        <option value="@field.Id" data-label="@field.Label" data-type="@DupTypeFa(field.Type)">@field.Label</option>
                                    }
                                }
                            </select>
                            <button type="button" class="btn btn-studio-outline" data-dup-unique-add disabled>
                                <i class="bx bx-plus me-1"></i> افزودن
                            </button>
                        </div>
                    </div>

                    <label class="crm-dup-check">
                        <input type="checkbox" name="ignoreEmpty" value="true" @(ignoreEmpty ? "checked" : null) />
                        <span>
                            <strong>نادیده گرفتن مقادیر خالی</strong>
                            <small>هنگام بررسی موارد تکراری، مقادیر یکتای خالی را نادیده می‌گیرد</small>
                        </span>
                    </label>
                </div>
            </section>

            @* ── Step 2: match condition ── *@
            <section class="crm-dup-step">
                <aside class="crm-dup-step-rail">
                    <span class="crm-dup-step-num">۲</span>
                    <span class="crm-dup-step-title">شرط تکراری بودن</span>
                </aside>
                <div class="crm-dup-step-body">
                    <div class="crm-dup-radio-stack" role="radiogroup">
                        <label class="crm-dup-radio">
                            <input type="radio" name="mode" value="and" @(mode == "and" ? "checked" : null) />
                            <span>
                                <strong>فقط در صورتی تکراری در نظر گرفته شود که همه فیلدهای یکتا مطابقت داشته باشند</strong>
                                <small>حالت AND — ترکیب همه فیلدها باید یکی باشد</small>
                            </span>
                        </label>
                        <label class="crm-dup-radio">
                            <input type="radio" name="mode" value="or" @(mode != "and" ? "checked" : null) />
                            <span>
                                <strong>اگر حداقل یکی از فیلدهای یکتا مطابقت داشته باشد، تکراری در نظر گرفته شود</strong>
                                <small>حالت OR — هر فیلد جداگانه بررسی می‌شود</small>
                            </span>
                        </label>
                    </div>
                    <p class="crm-dup-note mb-0">
                        <i class="bx bx-info-circle"></i>
                        عملیات ذخیره با این گزینه‌ها ممکن است در ماژول‌های پرترافیک کمی کندتر شود؛ فقط فیلدهای ضروری را انتخاب کنید.
                    </p>
                </div>
            </section>

            @* ── Step 3: sync conflict policy ── *@
            <section class="crm-dup-step">
                <aside class="crm-dup-step-rail">
                    <span class="crm-dup-step-num">۳</span>
                    <span class="crm-dup-step-title">نوع مدیریت تکرار</span>
                </aside>
                <div class="crm-dup-step-body">
                    <p class="crm-dup-step-lead">روش برخورد با رکورد تکراری هنگام همگام‌سازی با اپلیکیشن خارجی</p>
                    <div class="crm-dup-radio-stack" role="radiogroup">
                        <label class="crm-dup-radio">
                            <input type="radio" name="syncPolicy" value="latest" @(syncPolicy == "latest" ? "checked" : null) />
                            <span>
                                <strong>ترجیح آخرین رکورد</strong>
                                <small>رکوردی که اخیراً به‌روزرسانی شده است ترجیح داده می‌شود</small>
                            </span>
                        </label>
                        <label class="crm-dup-radio">
                            <input type="radio" name="syncPolicy" value="internal" @(syncPolicy == "internal" ? "checked" : null) />
                            <span>
                                <strong>ترجیح رکورد داخلی</strong>
                                <small>رکورد داخلی بدون تغییر حفظ می‌شود</small>
                            </span>
                        </label>
                        <label class="crm-dup-radio">
                            <input type="radio" name="syncPolicy" value="external" @(syncPolicy == "external" ? "checked" : null) />
                            <span>
                                <strong>ترجیح رکورد خارجی</strong>
                                <small>دادهٔ ورودی از اپلیکیشن خارجی جایگزین می‌شود</small>
                            </span>
                        </label>
                    </div>
                </div>
            </section>

            @* ── Step 4: global phone detection ── *@
            <section class="crm-dup-step">
                <aside class="crm-dup-step-rail">
                    <span class="crm-dup-step-num">۴</span>
                    <span class="crm-dup-step-title">تشخیص تکراری سراسری</span>
                </aside>
                <div class="crm-dup-step-body">
                    <div class="crm-dup-banner mb-3">
                        <div class="crm-dup-banner-icon"><i class="bx bx-info-circle"></i></div>
                        <p class="mb-0">
                            با فعال‌سازی این قابلیت، سیستم هنگام ثبت هر رکورد جدید، مقدار فیلدهای انتخاب‌شده را
                            در <strong>تمام ماژول‌ها</strong> بررسی می‌کند تا از ایجاد رکوردهای تکراری در سطح کل CRM جلوگیری شود.
                        </p>
                    </div>

                    <label class="crm-dup-switch mb-3">
                        <input type="checkbox" name="globalEnabled" value="true" data-dup-global-enabled @(globalEnabled ? "checked" : null) />
                        <span class="crm-dup-switch-ui" aria-hidden="true"></span>
                        <span class="crm-dup-switch-label">فعال‌سازی تشخیص تکراری سراسری</span>
                    </label>

                    <div class="crm-dup-global-body @(globalEnabled ? null : "is-disabled")" data-dup-global-body>
                        <div class="crm-dup-cards" data-dup-global-cards>
                            @if (globalFields.Count == 0)
                            {
                                <div class="crm-dup-empty" data-dup-global-empty>فیلد شماره تماسی برای تشخیص سراسری انتخاب نشده است.</div>
                            }
                            @for (var i = 0; i < globalFields.Count; i++)
                            {
                                var field = globalFields[i];
                                <div class="crm-dup-card @cardTints[i % cardTints.Length]" data-dup-card data-field-id="@field.Id">
                                    <input type="hidden" name="globalFieldIds" value="@field.Id" />
                                    <div class="crm-dup-card-main">
                                        <span class="crm-dup-card-key"><i class="bx bx-key"></i></span>
                                        <div class="crm-dup-card-text">
                                            <strong>@field.Label</strong>
                                            <span class="crm-dup-card-type">(شماره تماس)</span>
                                        </div>
                                    </div>
                                    <div class="crm-dup-card-actions">
                                        <span class="crm-dup-card-handle" title="جابجایی"><i class="bx bx-grid-alt"></i></span>
                                        <div class="dropdown">
                                            <button type="button" class="crm-dup-card-edit dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="bx bx-edit-alt"></i><span>ویرایش</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <button type="button" class="dropdown-item text-danger" data-dup-global-remove>
                                                        <i class="bx bx-trash me-1"></i> حذف از تشخیص سراسری
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="crm-dup-picker">
                            <label class="crm-dup-picker-label" for="dupGlobalSelect">انتخاب فیلد تلفن</label>
                            <div class="crm-dup-picker-row">
                                <select id="dupGlobalSelect" class="form-select" data-dup-global-select>
                                    <option value="">انتخاب فیلد تلفن…</option>
                                    @foreach (var field in phoneFields)
                                    {
                                        if (field.IsGlobalUniqueCheck)
                                        {
                                            <option value="@field.Id" data-label="@field.Label" data-type="شماره تماس" disabled>@field.Label</option>
                                        }
                                        else
                                        {
                                            <option value="@field.Id" data-label="@field.Label" data-type="شماره تماس">@field.Label</option>
                                        }
                                    }
                                </select>
                                <button type="button" class="btn btn-studio-outline" data-dup-global-add disabled>
                                    <i class="bx bx-plus me-1"></i> افزودن
                                </button>
                            </div>
                            @if (phoneFields.Count == 0)
                            {
                                <p class="text-muted small mb-0 mt-2">در این ماژول فیلد تلفن تعریف نشده است.</p>
                            }
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="crm-dup-footer">
            <button type="submit" class="btn btn-studio-primary">
                <i class="bx bx-save me-1"></i> ذخیره تنظیمات تکرار
            </button>
        </div>
    </form>

    <template id="dupCardTemplate">
        <div class="crm-dup-card tint-sky" data-dup-card data-field-id="">
            <input type="hidden" value="" />
            <div class="crm-dup-card-main">
                <span class="crm-dup-card-key"><i class="bx bx-key"></i></span>
                <div class="crm-dup-card-text">
                    <strong data-label></strong>
                    <span class="crm-dup-card-type" data-type></span>
                </div>
            </div>
            <div class="crm-dup-card-actions">
                <span class="crm-dup-card-handle" title="جابجایی"><i class="bx bx-grid-alt"></i></span>
                <div class="dropdown">
                    <button type="button" class="crm-dup-card-edit dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bx bx-edit-alt"></i><span>ویرایش</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li>
                            <button type="button" class="dropdown-item text-danger" data-remove>
                                <i class="bx bx-trash me-1"></i> <span data-remove-label>حذف از معیار</span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </template>
}
else if (tab == "dependencies")
{
    var depMode = (ViewBag.DepMode as string) ?? "field";
    var isBlockMode = depMode == "block";
    var picklistControllers = fields
        .Where(f => f.Type is FieldType.Picklist or FieldType.MultiPicklist)
        .OrderBy(f => f.SortOrder)
        .ToList();
    var fieldLabel = fields.ToDictionary(f => f.Name, f => f.Label, StringComparer.OrdinalIgnoreCase);
    string ValueLabel(string fieldName, string value)
    {
        var f = fields.FirstOrDefault(x => string.Equals(x.Name, fieldName, StringComparison.OrdinalIgnoreCase));
        if (f is null) return value;
        var opt = f.PicklistValues.FirstOrDefault(p => string.Equals(p.Value, value, StringComparison.OrdinalIgnoreCase));
        return opt?.Label ?? value;
    }
    string Summarize(string? json)
    {
        var rule = VisibilityRuleHelper.Parse(json);
        if (rule is null) return "";
        return VisibilityRuleHelper.SummarizeConditionsFa(
            rule,
            n => fieldLabel.TryGetValue(n, out var l) ? l : n,
            ValueLabel);
    }
    var depFields = fields.Where(f => !string.IsNullOrWhiteSpace(f.VisibilityRuleJson)).OrderBy(f => f.SortOrder).ToList();
    var depBlocks = blocks.Where(b => !string.IsNullOrWhiteSpace(b.VisibilityRuleJson)).OrderBy(b => b.SortOrder).ToList();
    var nestedFieldIds = new HashSet<int>();
    if (isBlockMode)
    {
        foreach (var b in depBlocks)
        {
            foreach (var f in depFields.Where(x => x.BlockId == b.Id))
                nestedFieldIds.Add(f.Id);
        }
    }
    var picklistMeta = picklistControllers.ToDictionary(
        f => f.Name,
        f => f.PicklistValues.OrderBy(p => p.SortOrder).Select(p => new { value = p.Value, label = p.Label }).ToList());
    <div class="crm-studio-panel">
        <div class="crm-studio-panel-header">
            <h5>بلاک / فیلدهای وابسته</h5>
        </div>
        <div class="crm-studio-panel-body">
            <p class="text-muted small mb-3">
                فیلدها یا بلاک‌هایی که اینجا انتخاب می‌کنید در فرم مخفی می‌مانند و فقط وقتی همهٔ شرط‌ها برقرار باشند نمایش داده می‌شوند.
                فقط فیلدهای انتخابی (picklist) در شرط قابل استفاده‌اند. با «افزودن عمل» می‌توانید چند هدف را با هم تعریف کنید.
            </p>

            <div class="crm-dep-toolbar">
                <div class="crm-dep-mode" role="tablist">
                    <a class="crm-dep-mode-btn @(isBlockMode ? "active" : null)"
                       href="/App/customize/@module.Name?tab=dependencies&amp;dep=block">وابستگی بلاک</a>
                    <a class="crm-dep-mode-btn @(!isBlockMode ? "active" : null)"
                       href="/App/customize/@module.Name?tab=dependencies&amp;dep=field">وابستگی فیلد</a>
                </div>
                <button type="button" class="btn btn-primary btn-sm" id="crmDepAddBtn">
                    <i class="bx bx-plus"></i> افزودن وابستگی
                </button>
            </div>

            <div class="crm-dep-list" id="crmDepList" data-mode="@depMode" data-module="@module.Name">
                @if (isBlockMode)
                {
                    @if (depBlocks.Count == 0 && depFields.Count == 0)
                    {
                        <p class="text-muted small crm-dep-empty" data-dep-empty>هنوز هیچ فیلد یا بلاک وابسته‌ای تنظیم نشده است.</p>
                    }
                    @foreach (var block in depBlocks)
                    {
                        var rule = VisibilityRuleHelper.Parse(block.VisibilityRuleJson);
                        var children = depFields.Where(f => f.BlockId == block.Id).ToList();
                        <div class="crm-dep-group" data-dep-group data-kind="block" data-id="@block.Id"
                             data-rule="@(block.VisibilityRuleJson ?? "")">
                            <div class="crm-dep-row" data-dep-row data-kind="block" data-id="@block.Id"
                                 data-rule="@(block.VisibilityRuleJson ?? "")">
                                <div class="crm-dep-summary" data-dep-summary>
                                    <span class="crm-dep-target-label">@block.Label</span>
                                    <span class="crm-dep-sep" aria-hidden="true"></span>
                                    <span class="crm-dep-action-label">@VisibilityRuleHelper.ActionLabelFa(rule?.Action)</span>
                                    <span class="crm-dep-sep" aria-hidden="true"></span>
                                    <span class="crm-dep-cond-label">@Summarize(block.VisibilityRuleJson)</span>
                                    <div class="crm-dep-row-actions">
                                        <button type="button" class="btn btn-sm btn-label-primary" data-dep-edit>ویرایش</button>
                                        <form method="post" action="/App/customize/@module.Name/blocks/@block.Id/visibility/clear" class="d-inline"
                                              data-confirm="با حذف وابستگی بلاک، وابستگی فیلدهای داخل آن هم حذف می‌شود. ادامه می‌دهید؟">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="dep" value="block" />
                                            <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            @foreach (var child in children)
                            {
                                var cr = VisibilityRuleHelper.Parse(child.VisibilityRuleJson);
                                <div class="crm-dep-nest" data-dep-nest>
                                    <div class="crm-dep-nest-rail" aria-hidden="true"></div>
                                    <div class="crm-dep-row crm-dep-row-child" data-dep-row data-kind="field" data-id="@child.Id"
                                         data-name="@child.Name" data-block-id="@block.Id"
                                         data-rule="@(child.VisibilityRuleJson ?? "")">
                                        <div class="crm-dep-summary" data-dep-summary>
                                            <span class="crm-dep-target-label">@child.Label</span>
                                            <span class="crm-dep-sep" aria-hidden="true"></span>
                                            <span class="crm-dep-action-label">@VisibilityRuleHelper.ActionLabelFa(cr?.Action)</span>
                                            <span class="crm-dep-sep" aria-hidden="true"></span>
                                            <span class="crm-dep-cond-label">@Summarize(child.VisibilityRuleJson)</span>
                                            <div class="crm-dep-row-actions">
                                                <button type="button" class="btn btn-sm btn-label-primary" data-dep-edit>ویرایش</button>
                                                <form method="post" action="/App/customize/@module.Name/fields/@child.Id/visibility/clear" class="d-inline"
                                                      data-confirm="این وابستگی فیلد حذف شود؟">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="dep" value="block" />
                                                    <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    @* فیلدهای وابستهٔ مستقل (بلاکشان وابستگی ندارد) *@
                    @foreach (var field in depFields.Where(f => !nestedFieldIds.Contains(f.Id)))
                    {
                        var rule = VisibilityRuleHelper.Parse(field.VisibilityRuleJson);
                        <div class="crm-dep-row" data-dep-row data-kind="field" data-id="@field.Id"
                             data-name="@field.Name" data-rule="@(field.VisibilityRuleJson ?? "")"
                             data-block-id="@(field.BlockId?.ToString() ?? "")">
                            <div class="crm-dep-summary" data-dep-summary>
                                <span class="crm-dep-target-label">@field.Label</span>
                                <span class="crm-dep-sep" aria-hidden="true"></span>
                                <span class="crm-dep-action-label">@VisibilityRuleHelper.ActionLabelFa(rule?.Action)</span>
                                <span class="crm-dep-sep" aria-hidden="true"></span>
                                <span class="crm-dep-cond-label">@Summarize(field.VisibilityRuleJson)</span>
                                <div class="crm-dep-row-actions">
                                    <button type="button" class="btn btn-sm btn-label-primary" data-dep-edit>ویرایش</button>
                                    <form method="post" action="/App/customize/@module.Name/fields/@field.Id/visibility/clear" class="d-inline"
                                          data-confirm="این وابستگی حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="dep" value="block" />
                                        <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    @if (depFields.Count == 0)
                    {
                        <p class="text-muted small crm-dep-empty" data-dep-empty>هنوز وابستگی فیلدی تعریف نشده است.</p>
                    }
                    @foreach (var field in depFields)
                    {
                        var rule = VisibilityRuleHelper.Parse(field.VisibilityRuleJson);
                        <div class="crm-dep-row" data-dep-row data-kind="field" data-id="@field.Id"
                             data-name="@field.Name" data-rule="@(field.VisibilityRuleJson ?? "")"
                             data-block-id="@(field.BlockId?.ToString() ?? "")">
                            <div class="crm-dep-summary" data-dep-summary>
                                <span class="crm-dep-target-label">@field.Label</span>
                                <span class="crm-dep-sep" aria-hidden="true"></span>
                                <span class="crm-dep-action-label">@VisibilityRuleHelper.ActionLabelFa(rule?.Action)</span>
                                <span class="crm-dep-sep" aria-hidden="true"></span>
                                <span class="crm-dep-cond-label">@Summarize(field.VisibilityRuleJson)</span>
                                <div class="crm-dep-row-actions">
                                    <button type="button" class="btn btn-sm btn-label-primary" data-dep-edit>ویرایش</button>
                                    <form method="post" action="/App/customize/@module.Name/fields/@field.Id/visibility/clear" class="d-inline"
                                          data-confirm="این وابستگی حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="dep" value="field" />
                                        <button type="submit" class="btn btn-sm btn-label-danger">حذف</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <button type="button" class="crm-dep-add-link" id="crmDepAddLink">
                <i class="bx bx-plus"></i>
                @(isBlockMode ? "افزودن وابستگی بلاک" : "افزودن وابستگی فیلد")
            </button>

            <script type="application/json" id="crm-dep-meta">
@Html.Raw(JsonSerializer.Serialize(new {
    mode = depMode,
    module = module.Name,
    fields = fields.OrderBy(f => f.SortOrder).Select(f => new { id = f.Id, name = f.Name, label = f.Label, blockId = f.BlockId }),
    blocks = blocks.OrderBy(b => b.SortOrder).Select(b => new { id = b.Id, name = b.Name, label = b.Label }),
    controlling = picklistControllers.Select(f => new { name = f.Name, label = f.Label }),
    picklists = picklistMeta
}))
            </script>

            <template id="crm-dep-editor-tpl">
                <form method="post" action="/App/customize/@module.Name/visibility/batch" class="crm-dep-editor-form" data-dep-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="dep" value="@depMode" />
                    <input type="hidden" name="actionsJson" data-dep-actions-json />
                    <div class="crm-dep-actions" data-dep-actions></div>
                    <div class="crm-dep-editor-footer">
                        <button type="button" class="crm-dep-add-action" data-dep-add-action>
                            <i class="bx bx-plus"></i> افزودن عمل
                        </button>
                        <div class="crm-dep-editor-btns">
                            <button type="submit" class="crm-dep-ok" title="ذخیره"><i class="bx bx-check"></i></button>
                            <button type="button" class="crm-dep-cancel" data-dep-cancel title="انصراف"><i class="bx bx-x"></i></button>
                        </div>
                    </div>
                </form>
            </template>

            <template id="crm-dep-action-tpl">
                <div class="crm-dep-action" data-dep-action>
                    <div class="crm-dep-action-inner">
                        <div class="crm-dep-target-wrap">
                            <select class="form-select form-select-sm" data-dep-target required>
                                <option value="">انتخاب</option>
                            </select>
                        </div>
                        <div class="crm-dep-action-wrap">
                            <select class="form-select form-select-sm" data-dep-action-type disabled>
                                <option value="show" selected>نمایش (خواندن + نوشتن)</option>
                            </select>
                        </div>
                        <div class="crm-dep-conds" data-dep-conds>
                            <div class="crm-dep-cond" data-dep-cond>
                                <select class="form-select form-select-sm" data-dep-cfield>
                                    <option value="">فیلد</option>
                                </select>
                                <select class="form-select form-select-sm" data-dep-cop>
                                    <option value="eq">برابر با</option>
                                    <option value="neq">نابرابر با</option>
                                    <option value="contains">شامل شده باشد با</option>
                                </select>
                                <select class="form-select form-select-sm" data-dep-cvalue>
                                    <option value="">انتخاب</option>
                                </select>
                                <button type="button" class="crm-dep-cond-remove" data-dep-cond-remove title="حذف شرط" hidden>&times;</button>
                            </div>
                            <button type="button" class="crm-dep-add-cond" data-dep-add-cond>
                                <i class="bx bx-plus"></i> افزودن شرط
                            </button>
                        </div>
                        <button type="button" class="crm-dep-action-remove" data-dep-action-remove title="حذف عمل" hidden>&times;</button>
                    </div>
                </div>
            </template>
        </div>
    </div>
}
else if (tab == "layout")
{
    <div id="studio-layout" class="studio-layout">
        @foreach (var block in blocks.OrderBy(b => b.SortOrder).ThenBy(b => b.Id))
        {
            var blockFields = fieldsByBlock.GetValueOrDefault(block.Id) ?? new List<FieldDef>();
            var hiddenCount = blockFields.Count(f => !f.IsVisible);
            var collapseId = $"block-body-{block.Id}";
            var isCollapsed = block.IsCollapsed;
            <div class="studio-block @(isCollapsed ? "is-collapsed" : "")" data-block-id="@block.Id">
                <div class="studio-block-header studio-block-handle">
                    <div class="studio-block-title">
                        <i class="bx bx-grid-vertical"></i>
                        <strong>@block.Label</strong>
                        @if (hiddenCount > 0)
                        {
                            <span class="hint">(@hiddenCount پنهان)</span>
                        }
