@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.TeamUserEditModel
@{
    ViewData["PanelTitle"] = "تنظیمات";
    var roles = (List<Role>)ViewBag.Roles;
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-access.css" asp-append-version="true" />
}

<div class="crm-access">
    <div class="crm-access-hero">
        <div>
            <h4><i class="bx bx-edit"></i> ویرایش کاربر</h4>
            <p class="crm-access-hero-meta">@Model.FullName</p>
        </div>
        <a href="/App/access?tab=users" class="btn btn-outline-secondary btn-sm">بازگشت</a>
    </div>

    <partial name="_Alerts" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="crm-access-form-card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="crm-access-form-head">
            <strong>اطلاعات کاربر</strong>
        </div>
        <div class="crm-access-form-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" dir="ltr" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CrmRoleId" class="form-label">نقش *</label>
                    <select asp-for="CrmRoleId" class="form-select" required>
                        <option value="">— انتخاب نقش —</option>
                        @foreach (var r in roles)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6 d-flex flex-column justify-content-end gap-2">
                    <div class="form-check">
                        <input asp-for="IsTenantAdmin" class="form-check-input" />
                        <label asp-for="IsTenantAdmin" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="crm-access-hint mt-3">
                دسترسی ماژول‌ها از نقش کاربر می‌آید — از
                <a href="/App/access?tab=roles">درخت نقش‌ها</a> تنظیم کنید.
            </div>
        </div>
        <div class="crm-access-form-foot d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bx bx-save me-1"></i> ذخیره تغییرات
            </button>
            <a href="/App/access?tab=users" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
