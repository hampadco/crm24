@using System.Net
@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<WebForm>
@{
    var rows = Model.Select(form =>
    {
        var publicUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/f/{form.PublicKey}";
        var encUrl = WebUtility.HtmlEncode(publicUrl);
        var iframe = WebUtility.HtmlEncode($"<iframe src=\"{publicUrl}\" width=\"100%\" height=\"520\" frameborder=\"0\"></iframe>");
        var linkHtml =
            $"<div class=\"d-flex align-items-center gap-1\">" +
            $"<a href=\"{encUrl}\" target=\"_blank\" class=\"text-truncate\" style=\"max-width:220px\" dir=\"ltr\">{encUrl}</a>" +
            $"<button type=\"button\" class=\"crm-dt-action\" title=\"کپی کد iFrame\" onclick=\"navigator.clipboard.writeText('{iframe.Replace("'", "\\'")}')\">" +
            "<i class=\"bx bx-code-alt\"></i></button></div>";

        return new CrmTableRow
        {
            Id = form.Id.ToString(),
            EditUrl = $"/App/webforms/{form.Id}/edit",
            DeleteUrl = $"/App/webforms/{form.Id}/delete",
            DeleteConfirm = "حذف شود؟",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = CrmTableHtml.Strong(form.Name),
                ["module"] = CrmTableHtml.Muted(form.Module.PluralLabel),
                ["submissions"] = CrmTableHtml.Enc(form.SubmissionCount.ToString()),
                ["status"] = CrmTableHtml.Badge(
                    form.IsActive ? "فعال" : "غیرفعال",
                    form.IsActive ? "bg-label-success" : "bg-label-secondary"),
                ["link"] = linkHtml
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/webforms",
        ShowSearchBox = false,
        EmptyMessage = "وب‌فرمی ساخته نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "module", Label = "ماژول" },
            new CrmTableColumn { Key = "submissions", Label = "ارسال‌ها" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" },
            new CrmTableColumn { Key = "link", Label = "لینک عمومی" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-layout text-primary me-1"></i> وب‌فرم‌ها</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> وب‌فرم جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
