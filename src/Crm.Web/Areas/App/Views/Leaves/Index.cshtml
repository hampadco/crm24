@using Crm.Core.Entities
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@using Crm.Web.Services
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model List<LeaveRequest>
@{
    ViewData["PanelTitle"] = "منابع انسانی";
    Dictionary<int, string> users = ViewBag.Users;
    bool isAdmin = ViewBag.IsAdmin;
    var af = Antiforgery.GetAndStoreTokens(Context);
    var afInput = $"<input type=\"hidden\" name=\"{af.FormFieldName}\" value=\"{af.RequestToken}\" />";

    var columns = new List<CrmTableColumn>();
    if (isAdmin)
        columns.Add(new CrmTableColumn { Key = "user", Label = "پرسنل" });
    columns.AddRange(
    [
        new CrmTableColumn { Key = "type", Label = "نوع" },
        new CrmTableColumn { Key = "from", Label = "از" },
        new CrmTableColumn { Key = "to", Label = "تا" },
        new CrmTableColumn { Key = "reason", Label = "دلیل" },
        new CrmTableColumn { Key = "status", Label = "وضعیت" }
    ]);

    var rows = Model.Select(request =>
    {
        var cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (isAdmin)
            cells["user"] = CrmTableHtml.Text(users.GetValueOrDefault(request.UserId, "—"));
        cells["type"] = CrmTableHtml.Enc(LeavesController.TypeLabel(request.Type));
        cells["from"] = CrmTableHtml.Enc(PersianDateHelper.ToJalaliDate(request.FromUtc));
        cells["to"] = CrmTableHtml.Enc(PersianDateHelper.ToJalaliDate(request.ToUtc));
        cells["reason"] = CrmTableHtml.Text(request.Reason);
        cells["status"] = CrmTableHtml.Badge(
            LeavesController.StatusLabel(request.Status),
            request.Status switch
            {
                LeaveStatus.Approved => "bg-label-success",
                LeaveStatus.Rejected => "bg-label-danger",
                _ => "bg-label-warning"
            });

        string? extra = null;
        if (isAdmin && request.Status == LeaveStatus.Pending)
        {
            extra =
                $"<form action=\"/App/leaves/{request.Id}/review\" method=\"post\" class=\"d-inline\">{afInput}" +
                "<input type=\"hidden\" name=\"approve\" value=\"true\" />" +
                "<button type=\"submit\" class=\"crm-dt-action\" title=\"تأیید\"><i class=\"bx bx-check\"></i></button></form>" +
                $"<form action=\"/App/leaves/{request.Id}/review\" method=\"post\" class=\"d-inline\">{afInput}" +
                "<input type=\"hidden\" name=\"approve\" value=\"false\" />" +
                "<button type=\"submit\" class=\"crm-dt-action crm-dt-action--danger\" title=\"رد\"><i class=\"bx bx-x\"></i></button></form>";
        }

        return new CrmTableRow
        {
            Id = request.Id.ToString(),
            ExtraActionsHtml = extra,
            Cells = cells
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/leaves",
        ShowSearchBox = false,
        EmptyMessage = "درخواستی ثبت نشده است.",
        Columns = columns,
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-calendar-minus text-primary me-1"></i> مرخصی و مأموریت</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#leaveModal">
            <i class="bx bx-plus me-1"></i> درخواست جدید
        </button>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

<div class="modal fade" id="leaveModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/App/leaves/create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">درخواست مرخصی/مأموریت</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">نوع</label>
                    <select name="type" class="form-select">
                        <option value="Leave">مرخصی</option>
                        <option value="Mission">مأموریت</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">از تاریخ</label>
                        <input type="text" name="fromUtc" class="form-control jalali-date" autocomplete="off" dir="ltr" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">تا تاریخ</label>
                        <input type="text" name="toUtc" class="form-control jalali-date" autocomplete="off" dir="ltr" required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">دلیل</label>
                    <textarea name="reason" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-primary">ثبت درخواست</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
