@using Crm.Core.Entities
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model List<WorkflowRule>
@{
    ViewData["PanelTitle"] = "گردش‌کار";
    Dictionary<int, (int Count, int Failed)> logCounts = ViewBag.LogCounts;
    var af = Antiforgery.GetAndStoreTokens(Context);
    var afInput = $"<input type=\"hidden\" name=\"{af.FormFieldName}\" value=\"{af.RequestToken}\" />";

    var rows = Model.Select(rule =>
    {
        var stats = logCounts.GetValueOrDefault(rule.Id);
        var trigger = rule.Trigger switch
        {
            WorkflowTrigger.RecordCreated => "ایجاد رکورد",
            WorkflowTrigger.RecordUpdated => "ویرایش رکورد",
            _ => "زمان‌بندی " + (rule.Schedule switch
            {
                WorkflowSchedule.Hourly => "(ساعتی)",
                WorkflowSchedule.Monthly => "(ماهانه)",
                _ => "(روزانه)"
            })
        };
        var actionsHtml = string.Join(" ", rule.Actions.OrderBy(a => a.SortOrder)
            .Select(a => CrmTableHtml.Badge(WorkflowsController.ActionLabel(a.Type), "bg-label-primary me-1")));
        var logsHtml = CrmTableHtml.SoftLink($"/App/workflows/{rule.Id}/logs",
            $"{stats.Count} اجرا") +
            (stats.Failed > 0 ? $" <span class=\"text-danger\">({stats.Failed} خطا)</span>" : "");

        var extra =
            $"<form action=\"/App/workflows/{rule.Id}/toggle\" method=\"post\" class=\"d-inline\">{afInput}" +
            "<button type=\"submit\" class=\"crm-dt-action\" title=\"فعال/غیرفعال\"><i class=\"bx bx-power-off\"></i></button></form>";

        return new CrmTableRow
        {
            Id = rule.Id.ToString(),
            EditUrl = $"/App/workflows/{rule.Id}/edit",
            DeleteUrl = $"/App/workflows/{rule.Id}/delete",
            DeleteConfirm = "این قانون حذف شود؟",
            ExtraActionsHtml = extra,
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = CrmTableHtml.Strong(rule.Name),
                ["module"] = CrmTableHtml.Text(rule.Module.PluralLabel),
                ["trigger"] = CrmTableHtml.Enc(trigger),
                ["actions"] = string.IsNullOrWhiteSpace(actionsHtml) ? "—" : actionsHtml,
                ["logs"] = logsHtml,
                ["status"] = CrmTableHtml.Badge(
                    rule.IsActive ? "فعال" : "غیرفعال",
                    rule.IsActive ? "bg-label-success" : "bg-label-secondary")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/workflows",
        ShowSearchBox = false,
        EmptyMessage = "هنوز قانونی تعریف نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "module", Label = "ماژول" },
            new CrmTableColumn { Key = "trigger", Label = "محرک" },
            new CrmTableColumn { Key = "actions", Label = "اکشن‌ها" },
            new CrmTableColumn { Key = "logs", Label = "اجراها" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0"><i class="bx bx-git-branch text-primary me-1"></i> قوانین گردش‌کار</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> قانون جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
