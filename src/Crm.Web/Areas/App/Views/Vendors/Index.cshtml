@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<Vendor>
@{
    var rows = Model.Select(vendor => new CrmTableRow
    {
        Id = vendor.Id.ToString(),
        EditUrl = $"/App/vendors/{vendor.Id}/edit",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["name"] = CrmTableHtml.Strong(vendor.Name),
            ["phone"] = CrmTableHtml.Muted(vendor.Phone),
            ["email"] = CrmTableHtml.Muted(vendor.Email),
            ["status"] = CrmTableHtml.Badge(
                vendor.IsActive ? "فعال" : "غیرفعال",
                vendor.IsActive ? "bg-label-success" : "bg-label-secondary")
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/vendors",
        ShowSearchBox = false,
        EmptyMessage = "تأمین‌کننده‌ای ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "phone", Label = "تلفن" },
            new CrmTableColumn { Key = "email", Label = "ایمیل" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-store text-primary me-1"></i> تأمین‌کنندگان</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> تأمین‌کننده جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
