@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<Product>
@{
    ViewData["PanelTitle"] = "محصولات و سرویس‌ها";

    var rows = Model.Select(product =>
    {
        string inventory;
        if (product.IsService || !product.TrackInventory)
            inventory = CrmTableHtml.Muted("—");
        else if (product.StockQty <= product.ReorderPoint)
            inventory = CrmTableHtml.Badge($"{product.StockQty:0.##} — کمبود!", "bg-label-danger");
        else
            inventory = CrmTableHtml.Enc(product.StockQty.ToString("0.##"));

        var nameHtml = CrmTableHtml.Strong(product.Name,
            product.IsService ? CrmTableHtml.Badge("سرویس", "bg-label-info") : null);

        return new CrmTableRow
        {
            Id = product.Id.ToString(),
            EditUrl = $"/App/products/{product.Id}/edit",
            DeleteUrl = $"/App/products/{product.Id}/delete",
            DeleteConfirm = "این محصول حذف شود؟",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = nameHtml,
                ["sku"] = CrmTableHtml.Muted(product.Sku),
                ["unit"] = CrmTableHtml.Text(product.Unit),
                ["price"] = CrmTableHtml.Money(product.SalePrice),
                ["tax"] = product.TaxPercent > 0
                    ? CrmTableHtml.Enc(product.TaxPercent.ToString("0.#") + "%")
                    : "—",
                ["inventory"] = inventory,
                ["status"] = CrmTableHtml.Badge(
                    product.IsActive ? "فعال" : "غیرفعال",
                    product.IsActive ? "bg-label-success" : "bg-label-secondary")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/products",
        Search = ViewBag.Query as string,
        SearchPlaceholder = "جستجو در نام یا کد...",
        EmptyMessage = "هنوز محصولی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "sku", Label = "کد" },
            new CrmTableColumn { Key = "unit", Label = "واحد" },
            new CrmTableColumn { Key = "price", Label = "قیمت فروش" },
            new CrmTableColumn { Key = "tax", Label = "مالیات" },
            new CrmTableColumn { Key = "inventory", Label = "موجودی" },
            new CrmTableColumn
            {
                Key = "status",
                Label = "وضعیت",
                FilterKind = CrmTableFilterKind.Select,
                SelectOptions = [("true", "فعال"), ("false", "غیرفعال")]
            }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0">
            <i class="bx bx-package text-primary me-1"></i>
            محصولات و سرویس‌ها
            <span class="badge bg-label-secondary rounded-pill align-middle">@(ViewBag.TotalCount ?? Model.Count)</span>
        </h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> محصول جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
