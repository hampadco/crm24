@using Crm.Core.Entities
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@using Crm.Web.Services
@model List<Ticket>
@{
    ViewData["PanelTitle"] = "پشتیبانی";
    var currentStatus = ViewBag.Status as string ?? "";

    string PriorityBadge(TicketPriority p)
    {
        var cls = p switch
        {
            TicketPriority.Low => "bg-label-secondary",
            TicketPriority.Normal => "bg-label-info",
            TicketPriority.High => "bg-label-warning",
            _ => "bg-label-danger"
        };
        return CrmTableHtml.Badge(TicketsController.PriorityLabel(p), cls);
    }

    string StatusBadge(TicketStatus s)
    {
        var cls = s switch
        {
            TicketStatus.Open => "bg-label-primary",
            TicketStatus.InProgress => "bg-label-info",
            TicketStatus.WaitingCustomer => "bg-label-warning",
            TicketStatus.Resolved => "bg-label-success",
            _ => "bg-label-secondary"
        };
        return CrmTableHtml.Badge(TicketsController.StatusLabel(s), cls);
    }

    var rows = Model.Select(ticket =>
    {
        var subject = CrmTableHtml.Enc(ticket.Subject);
        if (ticket.EscalatedAtUtc is not null)
            subject += " " + CrmTableHtml.Badge("نقض SLA", "bg-label-danger");

        string dueHtml;
        if (ticket.DueAtUtc is DateTime due)
        {
            var overdue = ticket.FirstResponseAtUtc is null && due < DateTime.UtcNow;
            dueHtml = $"<span class=\"{(overdue ? "text-danger" : "text-muted")}\">{CrmTableHtml.Enc(PersianDateHelper.ToJalaliDate(due) + " " + due.ToString("HH:mm"))}</span>";
        }
        else
        {
            dueHtml = CrmTableHtml.Muted("—");
        }

        return new CrmTableRow
        {
            Id = ticket.Id.ToString(),
            DetailUrl = $"/App/tickets/{ticket.Id}",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["number"] = CrmTableHtml.Link($"/App/tickets/{ticket.Id}", ticket.Number),
                ["subject"] = subject,
                ["priority"] = PriorityBadge(ticket.Priority),
                ["status"] = StatusBadge(ticket.Status),
                ["due"] = dueHtml,
                ["created"] = CrmTableHtml.Muted(PersianDateHelper.ToJalaliDate(ticket.CreatedAtUtc))
            }
        };
    }).ToList();

    var formRoutes = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(currentStatus))
        formRoutes["status"] = currentStatus;

    var table = new CrmTableModel
    {
        ListPath = "/App/tickets",
        Search = ViewBag.Query as string,
        FormRouteValues = formRoutes,
        EmptyMessage = "تیکتی یافت نشد.",
        Columns =
        [
            new CrmTableColumn { Key = "number", Label = "#" },
            new CrmTableColumn { Key = "subject", Label = "موضوع" },
            new CrmTableColumn
            {
                Key = "priority",
                Label = "اولویت",
                FilterKind = CrmTableFilterKind.Select,
                SelectOptions = Enum.GetValues<TicketPriority>()
                    .Select(p => (p.ToString(), TicketsController.PriorityLabel(p)))
                    .ToList()
            },
            new CrmTableColumn
            {
                Key = "status",
                Label = "وضعیت",
                FilterKind = CrmTableFilterKind.Select,
                SelectOptions = Enum.GetValues<TicketStatus>()
                    .Select(s => (s.ToString(), TicketsController.StatusLabel(s)))
                    .ToList()
            },
            new CrmTableColumn { Key = "due", Label = "مهلت SLA" },
            new CrmTableColumn { Key = "created", Label = "ثبت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0">
            <i class="bx bx-support text-primary me-1"></i> تیکت‌ها
            <span class="badge bg-label-secondary rounded-pill align-middle">@(ViewBag.TotalCount ?? Model.Count)</span>
        </h4>
        <div class="d-flex gap-2">
            <a href="/App/tickets/sla" class="btn btn-outline-secondary"><i class="bx bx-timer me-1"></i> تنظیمات SLA</a>
            <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> تیکت جدید</a>
        </div>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
