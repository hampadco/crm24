@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<ReportDef>
@{
    ViewData["PanelTitle"] = "گزارش‌ها";

    var rows = Model.Select(report => new CrmTableRow
    {
        Id = report.Id.ToString(),
        DetailUrl = null,
        EditUrl = $"/App/reports/{report.Id}/edit",
        DeleteUrl = $"/App/reports/{report.Id}/delete",
        DeleteConfirm = "این گزارش حذف شود؟",
        ExtraActionsHtml =
            $"<a href=\"/App/reports/{report.Id}\" class=\"crm-dt-action\" title=\"اجرا\"><i class=\"bx bx-play\"></i></a>" +
            $"<a href=\"/App/reports/{report.Id}/excel\" class=\"crm-dt-action\" title=\"اکسل\"><i class=\"bx bx-download\"></i></a>",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["name"] = CrmTableHtml.Link($"/App/reports/{report.Id}", report.Name),
            ["module"] = CrmTableHtml.Text(report.Module.PluralLabel),
            ["groupby"] = CrmTableHtml.Text(report.GroupByField)
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/reports",
        ShowSearchBox = false,
        EmptyMessage = "هنوز گزارشی ساخته نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "module", Label = "ماژول" },
            new CrmTableColumn { Key = "groupby", Label = "گروه‌بندی" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0"><i class="bx bx-bar-chart-alt-2 text-primary me-1"></i> گزارش‌های ذخیره‌شده</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> گزارش جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
