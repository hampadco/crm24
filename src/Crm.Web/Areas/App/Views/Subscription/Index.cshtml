@using Crm.Core.Entities
@using Crm.Web.Services
@{
    var tenant = (Tenant)ViewBag.Tenant;
    var current = (Subscription?)ViewBag.Current;
    var plans = (List<Crm.Core.Entities.Plan>)ViewBag.Plans;
    var isAdmin = ViewBag.IsTenantAdmin as bool? == true;
}

<h4 class="mb-4"><i class="bx bx-badge-check text-primary me-1"></i> اشتراک و تمدید</h4>

<partial name="_Alerts" />

@if (Context.Request.Query["payment"] == "success")
{
    <div class="alert alert-success">پرداخت با موفقیت انجام و اشتراک تمدید شد.</div>
}
else if (Context.Request.Query["payment"] == "failed")
{
    <div class="alert alert-danger">پرداخت ناموفق بود.</div>
}

@if (isAdmin)
{
    var settings = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
    try
    {
        using var doc = System.Text.Json.JsonDocument.Parse(string.IsNullOrWhiteSpace(tenant.Settings) ? "{}" : tenant.Settings);
        if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            foreach (var p in doc.RootElement.EnumerateObject())
            {
                if (p.Value.ValueKind is System.Text.Json.JsonValueKind.String or System.Text.Json.JsonValueKind.Number)
                    settings[p.Name] = p.Value.ToString();
            }
        }
    }
    catch { /* ignore */ }

    string S(string key) => settings.GetValueOrDefault(key) ?? "";

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0"><i class="bx bx-buildings me-1"></i> اطلاعات شرکت برای چاپ</h5></div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                این مقادیر در قالب‌های چاپ با توکن‌هایی مثل
                <code>{$COMPANY.website}</code>،
                <code>{$COMPANY.address}</code>،
                <code>{$COMPANY.national_id}</code>
                و
                <code>{$COMPANY.registration_number}</code>
                جایگزین می‌شوند.
            </p>
            <form method="post" action="/App/subscription/company" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label">نام شرکت</label>
                    <input type="text" class="form-control" value="@tenant.Name" disabled />
                    <div class="form-text">نام سازمان از پروفایل Tenant می‌آید (<code>{$COMPANY.name}</code>).</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">وب‌سایت</label>
                    <input type="text" name="website" class="form-control" dir="ltr" value="@S("website")" placeholder="https://example.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">تلفن</label>
                    <input type="text" name="phone" class="form-control" dir="ltr" value="@S("phone")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">شناسه ملی</label>
                    <input type="text" name="national_id" class="form-control" dir="ltr" value="@S("national_id")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">شماره ثبت</label>
                    <input type="text" name="registration_number" class="form-control" dir="ltr" value="@S("registration_number")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">کد اقتصادی</label>
                    <input type="text" name="economic_code" class="form-control" dir="ltr" value="@S("economic_code")" />
                </div>
                <div class="col-12">
                    <label class="form-label">آدرس</label>
                    <textarea name="address" class="form-control" rows="2">@S("address")</textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bx bx-save me-1"></i> ذخیره اطلاعات شرکت
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0"><i class="bx bx-image me-1"></i> برندینگ چاپ اسناد</h5></div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                لوگوی شرکت شما روی سربرگ پیش‌فاکتور / فاکتور چاپ می‌شود (<code>{$COMPANY.logo}</code>). پایین هر چاپ هم عبارت «تهیه‌شده با BamaCRM» می‌آید.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (!string.IsNullOrWhiteSpace(tenant.LogoPath))
                {
                    <img src="@tenant.LogoPath" alt="لوگو" style="max-height:64px;max-width:160px;object-fit:contain;border:1px solid #e2e8f0;border-radius:8px;padding:6px;background:#fff" />
                    <form method="post" action="/App/subscription/logo/remove" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف لوگو</button>
                    </form>
                }
                <form method="post" action="/App/subscription/logo" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml" class="form-control form-control-sm" style="max-width:16rem" required />
                    <button type="submit" class="btn btn-sm btn-primary">آپلود لوگو</button>
                </form>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">وضعیت فعلی</h5></div>
            <div class="card-body">
                <p class="d-flex justify-content-between">
                    <span class="text-muted">وضعیت</span>
                    <span class="badge @(tenant.Status == TenantStatus.Active ? "bg-label-success" : tenant.Status == TenantStatus.Trial ? "bg-label-info" : "bg-label-danger")">
                        @(tenant.Status switch { TenantStatus.Active => "فعال", TenantStatus.Trial => "دوره آزمایشی", TenantStatus.Suspended => "معلق", _ => "منقضی" })
                    </span>
                </p>
                @if (current is not null)
                {
                    <p class="d-flex justify-content-between"><span class="text-muted">پلن</span><strong>@current.Plan.Name</strong></p>
                    <p class="d-flex justify-content-between mb-0"><span class="text-muted">پایان اشتراک</span><strong>@PersianDateHelper.ToJalaliDate(current.EndsAtUtc)</strong></p>
                }
                else if (tenant.TrialEndsAtUtc is DateTime trialEnd)
                {
                    <p class="d-flex justify-content-between mb-0"><span class="text-muted">پایان دوره آزمایشی</span><strong>@PersianDateHelper.ToJalaliDate(trialEnd)</strong></p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row g-3">
            @foreach (var plan in plans)
            {
                var yearly = plan.PriceYearly > 0 ? plan.PriceYearly : plan.PriceMonthly * 12;
                <div class="col-md-4">
                    <div class="card h-100 @(plan.IsFeatured ? "border border-primary" : "")">
                        <div class="card-body text-center d-flex flex-column">
                            <h5>@plan.Name</h5>
                            <h4 class="my-2">@yearly.ToString("N0") <small class="fs-6 text-muted">تومان/سال</small></h4>
                            <p class="text-muted small flex-grow-1">تا @plan.MaxUsers کاربر — @plan.MaxRecords.ToString("N0") رکورد</p>
                            <form asp-action="Renew" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@plan.Id" />
                                <button type="submit" class="btn @(plan.IsFeatured ? "btn-primary" : "btn-outline-primary") w-100">
                                    <i class="bx bx-credit-card me-1"></i> تمدید آنلاین
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
