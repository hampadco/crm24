@using Crm.Core.Entities
@using Crm.Web.Services
@using Crm.Web.Areas.App.Models
@model List<ServiceContract>
@{
    ViewData["PanelTitle"] = "پشتیبانی";

    var rows = Model.Select(contract =>
    {
        var expired = contract.EndUtc < DateTime.UtcNow;
        var ticketText = contract.TicketsUsed + (contract.MaxTickets > 0 ? $" از {contract.MaxTickets}" : " (نامحدود)");
        return new CrmTableRow
        {
            Id = contract.Id.ToString(),
            EditUrl = $"/App/contracts/{contract.Id}/edit",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = CrmTableHtml.Strong(contract.Name),
                ["customer"] = CrmTableHtml.Text(contract.CustomerName),
                ["range"] = CrmTableHtml.Enc(
                    $"{PersianDateHelper.ToJalaliDate(contract.StartUtc)} تا {PersianDateHelper.ToJalaliDate(contract.EndUtc)}"),
                ["tickets"] = CrmTableHtml.Enc(ticketText),
                ["status"] = CrmTableHtml.Badge(
                    expired ? "منقضی" : contract.IsActive ? "فعال" : "غیرفعال",
                    contract.IsActive && !expired ? "bg-label-success" : "bg-label-danger")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/contracts",
        ShowSearchBox = false,
        EmptyMessage = "قراردادی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "customer", Label = "مشتری" },
            new CrmTableColumn { Key = "range", Label = "بازه" },
            new CrmTableColumn { Key = "tickets", Label = "تیکت" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-file-blank text-primary me-1"></i> قراردادهای خدمات</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> قرارداد جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
