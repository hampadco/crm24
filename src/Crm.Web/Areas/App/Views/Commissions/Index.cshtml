@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@using Crm.Web.Services
@model CommissionsIndexViewModel
@{
    ViewData["PanelTitle"] = "مشارکت در فروش";
    ViewBag.Page = Model.Page;
    ViewBag.TotalPages = Model.TotalPages;
    ViewBag.TotalCount = Model.TotalCount;
    ViewBag.PageSize = Model.PageSize;
    ViewBag.PagingRoutes = new Dictionary<string, string?> { ["q"] = Model.Search };

    var rowNumber = (Model.Page - 1) * Model.PageSize;
    var rows = Model.Rules.Select(rule =>
    {
        rowNumber++;
        return new CrmTableRow
        {
            Id = rule.Id.ToString(),
            EditUrl = $"/App/commissions/{rule.Id}/edit",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["#"] = $"<span class=\"text-muted\">{rowNumber.ToFa()}</span>",
                ["name"] = CrmTableHtml.Strong(rule.Name),
                ["scope"] = CrmTableHtml.Text(rule.Product?.Name ?? "کل فاکتور"),
                ["percent"] = rule.Percent > 0
                    ? $"<span dir=\"ltr\">{CrmTableHtml.Enc(rule.Percent.ToString("0.#") + "%")}</span>"
                    : "—",
                ["fixed"] = rule.FixedAmount > 0
                    ? CrmTableHtml.Money(rule.FixedAmount)
                    : "—",
                ["min"] = rule.MinInvoiceAmount > 0
                    ? CrmTableHtml.Money(rule.MinInvoiceAmount)
                    : "—",
                ["status"] = CrmTableHtml.Badge(
                    rule.IsActive ? "فعال" : "غیرفعال",
                    rule.IsActive ? "bg-label-success" : "bg-label-secondary")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/commissions",
        Search = Model.Search,
        SearchPlaceholder = "جستجوی قانون یا محصول...",
        ShowColumnFilters = true,
        ShowSearchBox = false,
        EmptyMessage = "قانونی تعریف نشده است.",
        EmptyFilteredMessage = "نتیجه‌ای برای این جستجو یافت نشد.",
        Columns =
        [
            new CrmTableColumn { Key = "#", Label = "#", FilterKind = CrmTableFilterKind.None },
            new CrmTableColumn { Key = "name", Label = "نام قانون" },
            new CrmTableColumn { Key = "scope", Label = "دامنه" },
            new CrmTableColumn { Key = "percent", Label = "درصد" },
            new CrmTableColumn { Key = "fixed", Label = "مبلغ ثابت" },
            new CrmTableColumn { Key = "min", Label = "حداقل فاکتور" },
            new CrmTableColumn { Key = "status", Label = "وضعیت", FilterKind = CrmTableFilterKind.Select, SelectOptions = [("true", "فعال"), ("false", "غیرفعال")] }
        ],
        Rows = rows
    };

    var reportRow = 0;
    var reportRows = Model.Report.Select(row =>
    {
        reportRow++;
        return new CrmTableRow
        {
            Id = row.UserId.ToString(),
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["#"] = $"<span class=\"text-muted\">{reportRow.ToFa()}</span>",
                ["user"] = CrmTableHtml.Text(row.UserName),
                ["deals"] = CrmTableHtml.Enc(row.DealCount.ToFa()),
                ["total"] = $"<strong>{CrmTableHtml.Enc(row.Total.ToString("N0"))}</strong> <small class=\"text-muted\">تومان</small>"
            }
        };
    }).ToList();

    var reportTable = new CrmTableModel
    {
        ListPath = "/App/commissions",
        ShowSearchBox = false,
        ShowFilterBar = false,
        ShowFooter = false,
        ShowColumnFilters = false,
        SelectionEnabled = false,
        EmptyMessage = "هنوز پورسانتی محاسبه نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "#", Label = "#" },
            new CrmTableColumn { Key = "user", Label = "کارشناس" },
            new CrmTableColumn { Key = "deals", Label = "معامله" },
            new CrmTableColumn { Key = "total", Label = "جمع پورسانت" }
        ],
        Rows = reportRows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h4 class="mb-0">
            <i class="bx bx-gift text-primary me-1"></i>
            مشارکت در فروش (پورسانت)
            <span class="badge bg-label-secondary rounded-pill align-middle">@Model.TotalCount.ToFa()</span>
        </h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> قانون جدید</a>
    </div>

    <partial name="_Alerts" />

    <div class="row g-4">
        <div class="col-lg-8">
            <h5 class="mb-3">قوانین پورسانت</h5>
            <partial name="_CrmTable" model="table" />
        </div>
        <div class="col-lg-4">
            <h5 class="mb-3">گزارش کارشناسان</h5>
            <partial name="_CrmTable" model="reportTable" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
