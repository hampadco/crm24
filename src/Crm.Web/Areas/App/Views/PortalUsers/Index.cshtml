@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model List<PortalUser>
@{
    ViewData["PanelTitle"] = "پشتیبانی";
    Dictionary<int, string> contacts = ViewBag.Contacts;
    var af = Antiforgery.GetAndStoreTokens(Context);
    var afInput = $"<input type=\"hidden\" name=\"{af.FormFieldName}\" value=\"{af.RequestToken}\" />";

    var rows = Model.Select(user =>
    {
        var contactTitle = user.ContactRecordId is int cid && contacts.TryGetValue(cid, out var title) ? title : "—";
        var extra =
            $"<form action=\"/App/portal-users/{user.Id}/toggle\" method=\"post\" class=\"d-inline\">{afInput}" +
            "<button type=\"submit\" class=\"crm-dt-action\" title=\"فعال/غیرفعال\"><i class=\"bx bx-power-off\"></i></button></form>";

        return new CrmTableRow
        {
            Id = user.Id.ToString(),
            EditUrl = $"/App/portal-users/{user.Id}/edit",
            ExtraActionsHtml = extra,
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = CrmTableHtml.Strong(user.FullName),
                ["email"] = $"<span dir=\"ltr\">{CrmTableHtml.Enc(user.Email)}</span>",
                ["contact"] = CrmTableHtml.Text(contactTitle),
                ["status"] = CrmTableHtml.Badge(
                    user.IsActive ? "فعال" : "غیرفعال",
                    user.IsActive ? "bg-label-success" : "bg-label-secondary")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/portal-users",
        ShowSearchBox = false,
        EmptyMessage = "کاربر پورتالی ساخته نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "email", Label = "ایمیل" },
            new CrmTableColumn { Key = "contact", Label = "مخاطب مرتبط" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-user-circle text-primary me-1"></i> کاربران پورتال مشتریان</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#portalUserModal">
            <i class="bx bx-plus me-1"></i> کاربر جدید
        </button>
    </div>

    <partial name="_Alerts" />

    <div class="alert alert-info small mb-3">
        مشتریان از <a href="/Portal/Account/Login" target="_blank"><strong>/Portal/Account/Login</strong></a> وارد می‌شوند — نه از /App/Account/Login.
    </div>

    <partial name="_CrmTable" model="table" />
</div>

<div class="modal fade" id="portalUserModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/App/portal-users/create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">کاربر پورتال جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">نام و نام خانوادگی</label>
                    <input type="text" name="fullName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">ایمیل</label>
                    <input type="email" name="email" class="form-control" dir="ltr" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">رمز عبور</label>
                    <input type="password" name="password" class="form-control" dir="ltr" minlength="6" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">مخاطب مرتبط (برای نمایش فاکتورها)</label>
                    <select name="contactRecordId" class="form-select">
                        <option value="">— انتخاب کنید —</option>
                        @foreach (var (id, title) in contacts)
                        {
                            <option value="@id">@title</option>
                        }
                    </select>
                    <div class="form-text">مخاطب را از <a href="/App/m/contacts">مخاطبین CRM</a> بسازید.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-primary">ساخت کاربر</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
