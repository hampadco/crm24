@using Crm.Core.Entities
@model List<PrintTemplate>
@{
    var moduleLabels = (Dictionary<int, string>)(ViewBag.ModuleLabels ?? new Dictionary<int, string>());
    var modules = (IReadOnlyList<ModuleDef>)(ViewBag.Modules ?? Array.Empty<ModuleDef>());
    int? filterModuleId = ViewBag.FilterModuleId as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-print-designer.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bx bx-printer text-primary me-1"></i> قالب‌های چاپ</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> قالب جدید</a>
</div>

<partial name="_Alerts" />

<form method="get" class="card mb-3" style="max-width:480px">
    <div class="card-body d-flex gap-2 align-items-end">
        <div class="flex-grow-1">
            <label class="form-label">فیلتر ماژول</label>
            <select name="moduleId" class="form-select" onchange="this.form.submit()">
                <option value="">همه ماژول‌ها</option>
                @foreach (var m in modules)
                {
                    <option value="@m.Id" selected="@(filterModuleId == m.Id)">@m.PluralLabel</option>
                }
            </select>
        </div>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>ماژول</th>
                    <th>صفحه</th>
                    <th>فونت</th>
                    <th>اشتراک</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">قالب چاپی ثبت نشده است.</td></tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td>
                        <strong>@t.Name</strong>
                        @if (t.IsDefault)
                        {
                            <span class="badge bg-label-primary ms-1">پیش‌فرض</span>
                        }
                        @if (t.WatermarkEnabled)
                        {
                            <span class="badge bg-label-info ms-1">واترمارک</span>
                        }
                    </td>
                    <td>@(moduleLabels.GetValueOrDefault(t.ModuleId) ?? $"#{t.ModuleId}")</td>
                    <td class="text-nowrap">@t.PageSize @(t.Landscape ? "افقی" : "عمودی")</td>
                    <td class="text-nowrap">@PrintFonts.Label(t.FontFamily) / @t.FontSize pt</td>
                    <td>@(t.ShareWithAllRoles ? "همه نقش‌ها" : "نقش‌های انتخابی")</td>
                    <td>
                        @if (t.IsActive)
                        {
                            <span class="badge bg-label-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">غیرفعال</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Design" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary" title="طراحی محتوا">
                            <i class="bx bx-edit-alt"></i>
                        </a>
                        <a asp-action="Settings" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary" title="تنظیمات">
                            <i class="bx bx-cog"></i>
                        </a>
                        <a asp-action="Preview" asp-route-id="@t.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="پیش‌نمایش">
                            <i class="bx bx-show"></i>
                        </a>
                        <form asp-action="Duplicate" asp-route-id="@t.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="کپی"><i class="bx bx-copy"></i></button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" data-confirm="حذف شود؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bx bx-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_AppPagination" />
