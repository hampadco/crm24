@using System.Globalization
@using Crm.Core.Entities
@using Crm.Web.Areas.App.Controllers
@model PurchaseOrdersController.PoFormModel
@{
    var vendors = (List<Vendor>)ViewBag.Vendors;
    var products = (List<Product>)ViewBag.Products;

    string FormatPrice(decimal n) =>
        Math.Round(n, 0, MidpointRounding.AwayFromZero).ToString("N0", CultureInfo.InvariantCulture);
}

<h4 class="mb-4"><i class="bx bx-cart-download text-primary me-1"></i> @ViewData["Title"]</h4>

<partial name="_Alerts" />

<form asp-action="Save" method="post" id="poForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="card mb-4">
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">تأمین‌کننده *</label>
                <select name="VendorId" class="form-select crm-select2"
                        data-placeholder="جستجوی تأمین‌کننده…"
                        data-allow-clear="true"
                        data-ajax-url="/App/lookup/vendors"
                        required>
                    <option value=""></option>
                    @foreach (var vendor in vendors.Where(v => v.Id == Model.VendorId))
                    {
                        <option value="@vendor.Id" selected>@vendor.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">یادداشت</label>
                <input type="text" name="Note" value="@Model.Note" class="form-control" />
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">آیتم‌ها</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addLine()"><i class="bx bx-plus me-1"></i> افزودن ردیف</button>
        </div>
        <div class="table-responsive">
            <table class="table" id="linesTable">
                <thead><tr><th style="min-width:150px">محصول</th><th style="min-width:150px">شرح *</th><th style="min-width:70px">تعداد</th><th style="min-width:120px">قیمت واحد خرید</th><th style="min-width:40px"></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr>
                            <td>
                                <select name="Lines[@i].ProductId" class="form-select form-select-sm product-select crm-select2"
                                        data-placeholder="جستجوی محصول…" data-allow-clear="true"
                                        data-ajax-url="/App/lookup/products">
                                    <option value=""></option>
                                    @foreach (var product in products.Where(p => p.Id == Model.Lines[i].ProductId))
                                    {
                                        <option value="@product.Id" data-name="@product.Name" data-cost="@product.SalePrice.ToString(CultureInfo.InvariantCulture)" selected>@product.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input type="text" name="Lines[@i].Title" value="@Model.Lines[i].Title" class="form-control form-control-sm" /></td>
                            <td><input type="text" inputmode="decimal" dir="ltr" name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity.ToString("0.##")" class="form-control form-control-sm" /></td>
                            <td><input type="text" inputmode="numeric" dir="ltr" name="Lines[@i].UnitCost" value="@FormatPrice(Model.Lines[i].UnitCost)" class="form-control form-control-sm money-int" /></td>
                            <td><button type="button" class="btn btn-sm btn-text-danger" onclick="removeLine(this)"><i class="bx bx-x"></i></button></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="crm-line-add-row">
                        <td colspan="5" class="p-2 bg-light">
                            <button type="button" class="btn btn-sm btn-outline-primary w-100" style="border-style:dashed;font-weight:600" onclick="addLine()">
                                <i class="bx bx-plus me-1"></i> افزودن ردیف
                            </button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bx bx-save me-1"></i> ذخیره</button>
        <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
    </div>
</form>

@section Scripts {
<script>
    function fmtInt(n) {
        return Math.round(Number(n) || 0).toLocaleString('en-US', { maximumFractionDigits: 0, minimumFractionDigits: 0 });
    }

    function parseMoney(v) {
        const n = parseFloat(String(v || '').replace(/,/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function bindMoney(input) {
        if (!input || input.dataset.moneyBound) return;
        input.dataset.moneyBound = '1';
        input.addEventListener('input', () => {
            const raw = String(input.value || '').replace(/[^\d]/g, '');
            const pos = input.selectionStart || 0;
            const digitsBefore = String(input.value).slice(0, pos).replace(/[^\d]/g, '').length;
            if (!raw) { input.value = ''; return; }
            const formatted = fmtInt(raw);
            input.value = formatted;
            let seen = 0, newPos = formatted.length;
            for (let i = 0; i < formatted.length; i++) {
                if (/\d/.test(formatted[i])) {
                    seen++;
                    if (seen >= digitsBefore) { newPos = i + 1; break; }
                }
            }
            try { input.setSelectionRange(newPos, newPos); } catch (e) {}
        });
        input.addEventListener('blur', () => { input.value = fmtInt(parseMoney(input.value)); });
    }

    function bindProductSelect(sel) {
        if (!sel) return;
        if (window.initCrmSelect2) window.initCrmSelect2(sel.parentElement || sel);
        const handler = () => fillProduct(sel);
        if (window.jQuery) window.jQuery(sel).off('change.po').on('change.po', handler);
        else sel.addEventListener('change', handler);
    }

    function addLine() {
        const tbody = document.querySelector('#linesTable tbody');
        const first = tbody.querySelector('tr');
        if (!first) return;
        const $old = window.jQuery ? window.jQuery(first).find('select.crm-select2') : null;
        if ($old && $old.hasClass('select2-hidden-accessible')) {
            // clone without select2 chrome
        }
        const clone = first.cloneNode(true);
        clone.querySelectorAll('.select2-container').forEach(el => el.remove());
        const sel = clone.querySelector('select');
        if (sel) {
            sel.classList.remove('select2-hidden-accessible');
            sel.removeAttribute('data-select2-id');
            sel.removeAttribute('aria-hidden');
            sel.removeAttribute('tabindex');
            sel.querySelectorAll('option').forEach(o => o.removeAttribute('data-select2-id'));
            sel.selectedIndex = 0;
        }
        clone.querySelectorAll('input').forEach(i => {
            if (i.name && i.name.includes('Quantity')) i.value = '1';
            else if (i.classList.contains('money-int')) i.value = '0';
            else i.value = '';
            delete i.dataset.moneyBound;
        });
        tbody.appendChild(clone);
        reindex();
        bindProductSelect(clone.querySelector('select'));
        clone.querySelectorAll('.money-int').forEach(bindMoney);
    }

    function removeLine(btn) {
        const tbody = document.querySelector('#linesTable tbody');
        if (tbody.querySelectorAll('tr').length <= 1) return;
        const row = btn.closest('tr');
        if (window.jQuery) {
            const $sel = window.jQuery(row).find('select.crm-select2');
            if ($sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
        }
        row.remove();
        reindex();
    }

    function reindex() {
        document.querySelectorAll('#linesTable tbody tr').forEach((tr, idx) => {
            tr.querySelectorAll('select, input').forEach(el => {
                el.name = el.name.replace(/Lines\[\d+\]/, `Lines[${idx}]`);
            });
        });
    }

    function fillProduct(select) {
        const option = select.selectedOptions[0];
        const row = select.closest('tr');
        const title = row.querySelector('input[name$=".Title"]');
        const cost = row.querySelector('input[name$=".UnitCost"]');
        let name = option && option.value ? (option.dataset.name || option.textContent.trim()) : '';
        let price = option && option.dataset.cost ? option.dataset.cost : null;
        if (window.jQuery) {
            const s2 = window.jQuery(select).select2('data');
            if (s2 && s2[0] && s2[0].id) {
                name = s2[0].text || name;
                if (s2[0].price != null) price = String(s2[0].price);
            }
        }
        if (!name) return;
        if (title) title.value = name;
        if (cost && price) cost.value = fmtInt(price);
    }

    document.getElementById('poForm').addEventListener('submit', () => {
        document.querySelectorAll('#linesTable .money-int').forEach(el => {
            el.value = String(el.value || '').replace(/,/g, '');
        });
    });

    document.querySelectorAll('#linesTable tbody select.crm-select2').forEach(bindProductSelect);
    document.querySelectorAll('#linesTable .money-int').forEach(bindMoney);
</script>
}
