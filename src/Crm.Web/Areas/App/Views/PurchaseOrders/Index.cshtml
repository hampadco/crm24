@using Crm.Core.Entities
@using Crm.Web.Services
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@model List<PurchaseOrder>
@{
    string StatusBadge(PurchaseOrderStatus status)
    {
        var cls = status switch
        {
            PurchaseOrderStatus.Draft => "bg-label-secondary",
            PurchaseOrderStatus.Ordered => "bg-label-warning",
            PurchaseOrderStatus.Received => "bg-label-success",
            _ => "bg-label-danger"
        };
        return CrmTableHtml.Badge(PurchaseOrdersController.StatusLabel(status), cls);
    }

    var rows = Model.Select(order => new CrmTableRow
    {
        Id = order.Id.ToString(),
        DetailUrl = $"/App/purchase-orders/{order.Id}",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["number"] = CrmTableHtml.Link($"/App/purchase-orders/{order.Id}", order.Number),
            ["vendor"] = CrmTableHtml.Text(order.Vendor.Name),
            ["date"] = CrmTableHtml.Muted(PersianDateHelper.ToJalaliDate(order.IssueDateUtc)),
            ["total"] = CrmTableHtml.Enc(order.Total.ToString("N0")),
            ["paid"] = CrmTableHtml.Enc(order.Payments.Sum(p => p.Amount).ToString("N0")),
            ["status"] = StatusBadge(order.Status)
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/purchase-orders",
        ShowSearchBox = false,
        EmptyMessage = "سفارش خریدی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "number", Label = "شماره" },
            new CrmTableColumn { Key = "vendor", Label = "تأمین‌کننده" },
            new CrmTableColumn { Key = "date", Label = "تاریخ" },
            new CrmTableColumn { Key = "total", Label = "مبلغ" },
            new CrmTableColumn { Key = "paid", Label = "پرداخت‌شده" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-cart-download text-primary me-1"></i> سفارش‌های خرید</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> سفارش جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
