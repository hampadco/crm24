@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<KbArticle>
@{
    ViewData["PanelTitle"] = "پشتیبانی";

    var rows = Model.Select(article => new CrmTableRow
    {
        Id = article.Id.ToString(),
        EditUrl = $"/App/kb/{article.Id}/edit",
        DeleteUrl = $"/App/kb/{article.Id}/delete",
        DeleteConfirm = "این مقاله حذف شود؟",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["title"] = CrmTableHtml.Strong(article.Title),
            ["category"] = CrmTableHtml.Text(article.Category),
            ["portal"] = CrmTableHtml.Badge(
                article.IsPublishedToPortal ? "منتشر در پورتال" : "داخلی",
                article.IsPublishedToPortal ? "bg-label-success" : "bg-label-secondary")
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/kb",
        Search = ViewBag.Query as string,
        SearchPlaceholder = "جستجو در مقالات...",
        EmptyMessage = "مقاله‌ای ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "title", Label = "عنوان" },
            new CrmTableColumn { Key = "category", Label = "دسته" },
            new CrmTableColumn { Key = "portal", Label = "پورتال" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-book-open text-primary me-1"></i> پایگاه دانش</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> مقاله جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
