@using Crm.Core.Entities
@using ElementorBuilder.Models
@model KbArticle
@{
    ViewData["PanelTitle"] = "پشتیبانی";
    var isNew = Model.Id == 0;
}

@section Styles {
    <style>
        .crm-kb-editor-shell { margin-top: 1rem; }
        .crm-kb-editor-shell .elementor-editor-host {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px rgba(15, 23, 42, 0.06);
        }
        .crm-kb-meta-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            padding: 1.1rem 1.2rem;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="mb-0">
        <i class="bx bx-book-open text-primary me-1"></i> @ViewData["Title"]
    </h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bx bx-right-arrow-alt me-1"></i> بازگشت به لیست
    </a>
</div>

<partial name="_Alerts" />

<form asp-action="Save" method="post" id="kbArticleForm" data-elementor-form>
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="crm-kb-meta-card mb-3">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label fw-semibold">عنوان *</label>
                <input type="text" name="title" class="form-control" value="@Model.Title" required maxlength="300" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">دسته‌بندی</label>
                <input type="text" name="category" class="form-control" value="@Model.Category" maxlength="100" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input type="checkbox" name="isPublishedToPortal" value="true" class="form-check-input" id="pub"
                           checked="@Model.IsPublishedToPortal" />
                    <label class="form-check-label" for="pub">نمایش در پورتال مشتریان نهایی</label>
                </div>
            </div>
        </div>
    </div>

    <div class="crm-kb-editor-shell">
        <label class="form-label fw-semibold mb-2">محتوای مقاله (Elementor)</label>
        <input type="hidden" name="body" id="body" value="@Model.Body" />
        @await Component.InvokeAsync("ElementorEditor", new ElementorEditorViewModel
        {
            ContentFieldId = "body",
            Content = Model.Body,
            DraftStorageKey = isNew ? "kb-article-new" : $"kb-article-{Model.Id}",
            CancelUrl = Url.Action("Index")!
        })
    </div>

    <div class="mt-3 d-flex gap-2 sticky-bottom py-3">
        <button type="submit" class="btn btn-primary">
            <i class="bx bx-save me-1"></i> ذخیره
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/elementor-form.js" asp-append-version="true"></script>
}
