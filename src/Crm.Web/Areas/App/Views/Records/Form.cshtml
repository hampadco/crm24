@model Crm.Web.Areas.App.Models.RecordFormViewModel
@{
    ViewData["PanelTitle"] = Model.Module.PluralLabel;
    var isEdit = Model.RecordId is not null;
    var title = isEdit ? $"ویرایش {Model.Module.SingularLabel}" : $"{Model.Module.SingularLabel} جدید";
    ViewData["Title"] = title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-record-form.css" asp-append-version="true" />
}

<div class="crm-rf">
    <div class="crm-rf-header">
        <div class="crm-rf-header-main">
            <div class="crm-rf-avatar" aria-hidden="true">
                <i class="bx @Model.Module.Icon"></i>
            </div>
            <div>
                <div class="crm-rf-breadcrumb">
                    <a href="/App/m/@Model.Module.Name">@Model.Module.PluralLabel</a>
                    <span>/</span>
                    @if (isEdit && Model.RecordId is int rid)
                    {
                        <a href="/App/m/@Model.Module.Name/@rid">جزئیات</a>
                        <span>/</span>
                        <span>ویرایش</span>
                    }
                    else
                    {
                        <span>ایجاد</span>
                    }
                </div>
                <h1 class="crm-rf-title">@title</h1>
                <p class="crm-rf-sub">فیلدهای ستاره‌دار اجباری هستند. تغییرات با ذخیره اعمال می‌شوند.</p>
            </div>
        </div>
        <div class="crm-rf-header-actions">
            @if (isEdit && Model.RecordId is int detailId)
            {
                <a href="/App/m/@Model.Module.Name/@detailId" class="btn btn-outline-secondary btn-sm">
                    <i class="bx bx-show me-1"></i> جزئیات
                </a>
            }
            <a asp-action="Index" asp-route-moduleName="@Model.Module.Name" class="btn btn-outline-secondary btn-sm">
                <i class="bx bx-right-arrow-alt me-1"></i> بازگشت
            </a>
        </div>
    </div>

    <partial name="_Alerts" />

    <form method="post"
          class="crm-rf-form"
          asp-action="@(isEdit ? "Edit" : "Create")"
          asp-route-moduleName="@Model.Module.Name"
          asp-route-id="@Model.RecordId">
        <div class="crm-rf-body">
            <partial name="_DynamicForm" model="Model" />
        </div>

        <div class="crm-rf-footer">
            <div class="crm-rf-footer-inner">
                <button type="submit" class="btn btn-primary">
                    <i class="bx bx-save me-1"></i> ذخیره
                </button>
                @if (isEdit && Model.RecordId is int cancelId)
                {
                    <a href="/App/m/@Model.Module.Name/@cancelId" class="btn btn-label-secondary">انصراف</a>
                }
                else
                {
                    <a asp-action="Index" asp-route-moduleName="@Model.Module.Name" class="btn btn-label-secondary">انصراف</a>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/crm-form-deps.js" asp-append-version="true"></script>
}
