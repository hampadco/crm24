@using Crm.Web.Areas.App.Models
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model RecycleBinViewModel
@{
    ViewData["PanelTitle"] = "سطل بازیابی";
    var af = Antiforgery.GetAndStoreTokens(Context);
    var afInput = $"<input type=\"hidden\" name=\"{af.FormFieldName}\" value=\"{af.RequestToken}\" />";
    var rowNumber = 0;

    var rows = Model.Records.Select(record =>
    {
        rowNumber++;
        var deleted = record.DeletedAtUtc is DateTime d
            ? Crm.Web.Services.PersianDateHelper.ToJalaliDateTime(d)
            : "—";
        return new CrmTableRow
        {
            Id = record.Id.ToString(),
            ExtraActionsHtml =
                $"<form action=\"/App/recycle-bin/{record.Id}/restore\" method=\"post\" class=\"d-inline\">{afInput}" +
                "<button type=\"submit\" class=\"btn btn-sm btn-outline-success\"><i class=\"bx bx-undo me-1\"></i> بازیابی</button></form>",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["#"] = $"<span class=\"text-muted\">{rowNumber}</span>",
                ["title"] = CrmTableHtml.Text(record.Title),
                ["module"] = CrmTableHtml.Text(record.Module.PluralLabel),
                ["deleted"] = $"<span dir=\"ltr\">{CrmTableHtml.Enc(deleted)}</span>"
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/recycle-bin",
        ShowSearchBox = false,
        ShowFooter = false,
        EmptyMessage = "سطل بازیابی خالی است.",
        Columns =
        [
            new CrmTableColumn { Key = "#", Label = "#" },
            new CrmTableColumn { Key = "title", Label = "عنوان" },
            new CrmTableColumn { Key = "module", Label = "ماژول" },
            new CrmTableColumn { Key = "deleted", Label = "تاریخ حذف" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <h4 class="mb-4"><i class="bx bx-recycle text-primary me-1"></i> سطل بازیابی</h4>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
