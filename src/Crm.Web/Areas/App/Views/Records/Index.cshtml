@model Crm.Web.Areas.App.Models.RecordListViewModel
@{
    ViewData["PanelTitle"] = Model.Module.PluralLabel;
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crm-column-manager.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="crm-list-page-head d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <h4 class="mb-0 fw-bold">@Model.Module.PluralLabel</h4>
            <div class="crm-view-toggle btn-group" role="group">
                <a href="/App/m/@Model.Module.Name" class="btn btn-sm btn-primary">
                    <i class="bx bx-list-ul me-1"></i> لیست
                </a>
                @if (Model.HasKanban)
                {
                    <a href="/App/kanban/@Model.Module.Name" class="btn btn-sm btn-outline-secondary">
                        <i class="bx bx-columns me-1"></i> کاریز
                    </a>
                }
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bx bx-cog me-1"></i> سفارشی‌سازی
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li>
                        <a class="dropdown-item" href="/App/customize/@Model.Module.Name">
                            <i class="bx bx-customize me-1"></i> سفارشی‌سازی ماژول
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/App/customize/@Model.Module.Name?tab=fields">
                            <i class="bx bx-list-ul me-1"></i> ویرایش فیلدها
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="/App/customize/@Model.Module.Name?tab=relations">
                            <i class="bx bx-link-alt me-1"></i> روابط
                        </a>
                    </li>
                </ul>
            </div>
            <a asp-action="Export" asp-route-moduleName="@Model.Module.Name" asp-route-q="@Model.Search" class="btn btn-outline-secondary btn-sm">
                <i class="bx bx-download me-1"></i> خروجی اکسل
            </a>
            @if (Model.CanCreate)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importModal">
                    <i class="bx bx-upload me-1"></i> ورود CSV
                </button>
                <a asp-action="Create" asp-route-moduleName="@Model.Module.Name" class="btn btn-primary btn-sm">
                    <i class="bx bx-plus me-1"></i> ایجاد @Model.Module.SingularLabel
                </a>
            }
        </div>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmDataTable" model="Model" />
    <partial name="_ColumnManagerModal" model="Model" />
</div>

<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Import" asp-route-moduleName="@Model.Module.Name" method="post" enctype="multipart/form-data" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ورود از فایل CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    ردیف اول باید نام ستون‌ها باشد. ستون‌ها با نام سیستمی یا برچسب فیلد تطبیق داده می‌شوند:
                    @string.Join("، ", Model.Fields.Select(f => f.Label))
                </p>
                <input type="file" name="file" class="form-control" accept=".csv" required />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-primary">شروع ورود</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
    <script src="~/js/crm-column-manager.js" asp-append-version="true"></script>
}
