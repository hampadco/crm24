@using System.Text.Json
@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.RecordDetailViewModel
@{
    ViewData["PanelTitle"] = Model.Module.PluralLabel;
    var highlights = Model.HighlightFields();
    var keyFields = Model.SummaryFields();

    string AuditActionLabel(string action) => action switch
    {
        "Create" => "ایجاد",
        "Update" => "ویرایش",
        "Delete" => "حذف",
        "Restore" => "بازیابی",
        "Convert" => "تبدیل",
        "Payment" => "ثبت پرداخت",
        "Confirm" => "تأیید",
        "Installments" => "ایجاد اقساط",
        _ => action
    };

    string AuditUserLabel(int? userId) =>
        userId is int uid && Model.AuditUserNames.TryGetValue(uid, out var n) ? n : "سیستم";

    string FieldLabel(string fieldName) =>
        Model.Fields.FirstOrDefault(f => string.Equals(f.Name, fieldName, StringComparison.OrdinalIgnoreCase))?.Label
        ?? fieldName;

    string FormatFieldDisplay(FieldDef field)
    {
        var text = Model.DisplayValue(field);
        if (text is null) return "—";

        if ((field.Type is FieldType.Date or FieldType.DateTime)
            && DateTime.TryParse(Model.Values.GetValueOrDefault(field.Name), out var dt))
        {
            return field.Type == FieldType.Date
                ? PersianDateHelper.ToJalaliDate(DateTime.SpecifyKind(dt, DateTimeKind.Local))
                : PersianDateHelper.ToJalaliDateTime(DateTime.SpecifyKind(dt, DateTimeKind.Local));
        }

        return text;
    }

    string IconForField(FieldDef field) => field.Type switch
    {
        FieldType.Email => "bx-envelope",
        FieldType.Phone => "bx-phone",
        FieldType.Url => "bx-link-alt",
        FieldType.Picklist => "bx-purchase-tag-alt",
        FieldType.Date or FieldType.DateTime => "bx-calendar",
        FieldType.Currency or FieldType.Number or FieldType.Decimal => "bx-dollar",
        FieldType.Lookup => "bx-link",
        _ => field.Name.Contains("status", StringComparison.OrdinalIgnoreCase) || field.Name.Contains("stage", StringComparison.OrdinalIgnoreCase)
            ? "bx-flag"
            : field.Name.Contains("industry", StringComparison.OrdinalIgnoreCase) ? "bx-buildings"
            : field.Name.Contains("web", StringComparison.OrdinalIgnoreCase) ? "bx-globe"
            : "bx-info-circle"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-record-detail.css" asp-append-version="true" />
}

<div class="crm-rd" @(string.Equals(Model.Module.Name, "pricebooks", StringComparison.OrdinalIgnoreCase) && Model.LineBlock is not null ? "data-default-panel=products" : null)>
    <div class="crm-rd-header">
        <div class="crm-rd-header-main">
            <div class="crm-rd-avatar" aria-hidden="true">
                <i class="bx @Model.Module.Icon"></i>
            </div>
            <div>
                <div class="crm-rd-breadcrumb">
                    <a href="/App/m/@Model.Module.Name">@Model.Module.PluralLabel</a>
                    <span>/</span>
                    <span>جزئیات</span>
                </div>
                <h1 class="crm-rd-title">@Model.Record.Title</h1>
                <div class="crm-rd-meta">
                    <span class="crm-rd-chip"><i class="bx bx-cube"></i> @Model.Module.SingularLabel</span>
                    <span class="crm-rd-chip"><i class="bx bx-time-five"></i> ایجاد @PersianDateHelper.ToJalaliDateTime(Model.Record.CreatedAtUtc)@(string.IsNullOrWhiteSpace(Model.CreatedByName) ? null : $" — {Model.CreatedByName}")</span>
                    @if (Model.Record.UpdatedAtUtc is DateTime updated)
                    {
                        <span class="crm-rd-chip"><i class="bx bx-refresh"></i> ویرایش @PersianDateHelper.ToJalaliDateTime(updated)@(string.IsNullOrWhiteSpace(Model.UpdatedByName) ? null : $" — {Model.UpdatedByName}")</span>
                    }
                    @if (Model.Module.Name is "quotes" or "sales_orders" or "invoices")
                    {
                        if (Model.PriceBookId is int pbId && !string.IsNullOrWhiteSpace(Model.PriceBookName))
                        {
                            <a class="crm-rd-chip" href="/App/m/pricebooks/@pbId"><i class="bx bx-book"></i> دفترچه قیمت: @Model.PriceBookName</a>
                        }
                        else
                        {
                            <span class="crm-rd-chip"><i class="bx bx-book"></i> قیمت پایه محصول</span>
                        }
                    }
                    @if (string.Equals(Model.Module.Name, "invoices", StringComparison.OrdinalIgnoreCase))
                    {
                        var payStatus = Model.Values.GetValueOrDefault("status") ?? "";
                        var payLabel = payStatus switch
                        {
                            "Paid" => "پرداخت کامل",
                            "PartiallyPaid" => "نیمه‌پرداخت",
                            "Canceled" => "لغو شده",
                            _ => Model.InvoicePaidAmount > 0 ? "نیمه‌پرداخت" : "پرداخت‌نشده"
                        };
                        <span class="crm-rd-chip"><i class="bx bx-money"></i> @payLabel — پرداخت‌شده @Model.InvoicePaidAmount.ToString("N0") / مانده @Model.InvoiceRemainingAmount.ToString("N0")</span>
                    }
                </div>
            </div>
        </div>
        <div class="crm-rd-actions">
            <a asp-action="Index" asp-route-moduleName="@Model.Module.Name" class="btn btn-outline-secondary btn-sm">
                <i class="bx bx-right-arrow-alt me-1"></i> بازگشت
            </a>
            @if (string.Equals(Model.Module.Name, "leads", StringComparison.OrdinalIgnoreCase) && Model.CanEdit)
            {
                <form asp-action="Convert" asp-route-id="@Model.Record.Id" method="post" class="d-inline"
                      data-confirm="این سرنخ به مخاطب و فرصت فروش تبدیل شود؟">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bx bx-transfer me-1"></i> تبدیل سرنخ
                    </button>
                </form>
            }
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id"
                   class="btn btn-primary btn-sm">
                    <i class="bx bx-edit me-1"></i> ویرایش
                </a>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="modal" data-bs-target="#printExportModal"
                    @(Model.PrintTemplates.Count == 0 ? "disabled" : null)
                    title="@(Model.PrintTemplates.Count == 0 ? "قالب چاپی تعریف نشده است" : "چاپ و خروجی")">
                <i class="bx bx-printer me-1"></i> چاپ PDF
            </button>
            <form asp-action="Clone" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id"
                  method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bx bx-copy me-1"></i> کپی
                </button>
            </form>
            @if (Model.Module.DocumentKind != DocumentKind.None)
            {
                var st = Model.Values.GetValueOrDefault("status") ?? "";
                if (string.Equals(st, "Draft", StringComparison.OrdinalIgnoreCase) && Model.CanEdit)
                {
                    <form asp-action="ConfirmDocument" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id"
                          method="post" class="d-inline" data-confirm="سند تأیید شود؟">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bx bx-check me-1"></i> تأیید سند
                        </button>
                    </form>
                }
                if (!string.IsNullOrWhiteSpace(Model.Module.ConvertsToModule)
                    && !string.Equals(st, "Converted", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(st, "Canceled", StringComparison.OrdinalIgnoreCase)
                    && Model.CanEdit)
                {
                    <form asp-action="ConvertDocument" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id"
                          method="post" class="d-inline" data-confirm="سند به مرحله بعد تبدیل شود؟">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="bx bx-transfer me-1"></i> تبدیل
                        </button>
                    </form>
                }
            }
            @if (string.Equals(Model.Module.Name, "invoices", StringComparison.OrdinalIgnoreCase) && Model.CanEdit)
            {
                var canPay = Model.InvoiceRemainingAmount > 0.01m;
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#payModal"
                        @(canPay ? null : "disabled")
                        title="@(canPay ? "ثبت پرداخت جدید" : "مانده‌ای برای پرداخت نیست")">
                    <i class="bx bx-money me-1"></i> ثبت پرداخت
                </button>
            }
            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id"
                      method="post" class="d-inline" data-confirm="این رکورد به سطل بازیابی منتقل شود؟">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bx bx-trash me-1"></i> حذف
                    </button>
                </form>
            }
        </div>
    </div>

    <partial name="_Alerts" />

    @if (highlights.Count > 0)
    {
        <div class="crm-rd-highlights">
            @foreach (var field in highlights)
            {
                var display = FormatFieldDisplay(field);
                var lookupMod = Model.LookupModuleFor(field);
                var lookupId = Model.LookupRecordId(field);
                <div class="crm-rd-hcard">
                    <div class="crm-rd-hcard-icon"><i class="bx @IconForField(field)"></i></div>
                    <div class="crm-rd-hcard-body">
                        <div class="crm-rd-hcard-label">@field.Label</div>
                        <div class="crm-rd-hcard-value">
                            @if (lookupMod is not null && lookupId is not null && display != "—")
                            {
                                <a href="/App/m/@lookupMod/@lookupId">@display</a>
                            }
                            else if (field.Type == FieldType.Url && display != "—")
                            {
                                <a href="@(display.StartsWith("http") ? display : "https://" + display)" target="_blank" rel="noopener">@display</a>
                            }
                            else if (field.Type == FieldType.Email && display != "—")
                            {
                                <a href="mailto:@display">@display</a>
                            }
                            else if (field.Type == FieldType.Phone && display != "—")
                            {
                                <a href="tel:@display" dir="ltr">@display</a>
                            }
                            else if (field.Type == FieldType.Picklist && Model.Values.TryGetValue(field.Name, out var pv) && pv is not null)
                            {
                                var pick = field.PicklistValues.FirstOrDefault(p => p.Value == pv);
                                <span class="crm-rd-pill" style="--pill:@(pick?.Color ?? "#2f6fed")">@(pick?.Label ?? pv)</span>
                            }
                            else
                            {
                                <span>@display</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="crm-rd-layout">
        <div class="crm-rd-main">
            <section id="summary" class="crm-rd-panel is-active" data-crm-rd-panel="summary">
                <div class="crm-rd-masonry">
                    <article class="crm-rd-card">
                        <header class="crm-rd-card-head">
                            <h3>فیلدهای کلیدی</h3>
                        </header>
                        <div class="crm-rd-card-body">
                            <dl class="crm-rd-kv">
                                @foreach (var field in keyFields)
                                {
                                    var display = FormatFieldDisplay(field);
                                    <div class="crm-rd-kv-row">
                                        <dt>@field.Label</dt>
                                        <dd>
                                            @{
                                                var lookupMod = Model.LookupModuleFor(field);
                                                var lookupId = Model.LookupRecordId(field);
                                            }
                                            @if (lookupMod is not null && lookupId is not null && display != "—")
                                            {
                                                <a href="/App/m/@lookupMod/@lookupId">@display</a>
                                            }
                                            else if (field.Type == FieldType.Picklist && Model.Values.TryGetValue(field.Name, out var pv) && pv is not null)
                                            {
                                                var pick = field.PicklistValues.FirstOrDefault(p => p.Value == pv);
                                                <span class="crm-rd-pill" style="--pill:@(pick?.Color ?? "#2f6fed")">@(pick?.Label ?? pv)</span>
                                            }
                                            else
                                            {
                                                @display
                                            }
                                        </dd>
                                    </div>
                                }
                            </dl>
                        </div>
                    </article>

                    @foreach (var (block, groupFields) in Model.GroupedFields().Take(4))
                    {
                        <article class="crm-rd-card">
                            <header class="crm-rd-card-head">
                                <h3>@(block?.Label ?? "اطلاعات")</h3>
                            </header>
                            <div class="crm-rd-card-body">
                                <dl class="crm-rd-kv">
                                    @foreach (var field in groupFields.Take(8))
                                    {
                                        var display = FormatFieldDisplay(field);
                                        <div class="crm-rd-kv-row">
                                            <dt>@field.Label</dt>
                                            <dd>@display</dd>
                                        </div>
                                    }
                                </dl>
                            </div>
                        </article>
                    }

                    <article class="crm-rd-card">
                        <header class="crm-rd-card-head">
                            <h3>فعالیت‌ها</h3>
                            @if (Model.Activities.Count > 0)
                            {
                                <button type="button" class="crm-rd-card-link" data-crm-rd-jump="activities">مشاهده همه</button>
                            }
                        </header>
                        <div class="crm-rd-card-body">
                            @if (Model.Activities.Count == 0)
                            {
                                <div class="crm-rd-empty-sm">فعالیت مرتبطی ثبت نشده</div>
                            }
                            else
                            {
                                @foreach (var item in Model.Activities.Take(4))
                                {
                                    <a class="crm-rd-activity" href="/App/m/@item.ModuleName/@item.RecordId">
                                        <span class="crm-rd-activity-badge">@item.ModuleLabel</span>
                                        <span class="crm-rd-activity-title">@item.Title</span>
                                    </a>
                                }
                            }
                        </div>
                    </article>

                    <article class="crm-rd-card">
                        <header class="crm-rd-card-head">
                            <h3>یادداشت‌ها</h3>
                            <button type="button" class="crm-rd-card-link" data-crm-rd-jump="notes">مدیریت</button>
                        </header>
                        <div class="crm-rd-card-body">
                            @if (Model.Notes.Count == 0)
                            {
                                <div class="crm-rd-empty-sm">یادداشتی پیدا نشد</div>
                            }
                            else
                            {
                                @foreach (var note in Model.Notes.Take(3))
                                {
                                    <div class="crm-rd-note-preview">
                                        <div class="crm-rd-note-meta">@PersianDateHelper.ToJalaliDateTime(note.CreatedAtUtc)</div>
                                        <div class="crm-rd-note-text">@(note.Body.Length > 140 ? note.Body[..140] + "…" : note.Body)</div>
                                    </div>
                                }
                            }
                        </div>
                    </article>

                    <article class="crm-rd-card">
                        <header class="crm-rd-card-head">
                            <h3>اسناد</h3>
                            <button type="button" class="crm-rd-card-link" data-crm-rd-jump="attachments">مدیریت</button>
                        </header>
                        <div class="crm-rd-card-body">
                            @if (Model.Attachments.Count == 0)
                            {
                                <div class="crm-rd-empty-sm">سندی پیدا نشد</div>
                            }
                            else
                            {
                                @foreach (var file in Model.Attachments.Take(4))
                                {
                                    <a class="crm-rd-file" href="/App/m/@Model.Module.Name/@Model.Record.Id/attachments/@file.Id">
                                        <i class="bx bx-file"></i>
                                        <span>@file.FileName</span>
                                        <small>@(Math.Max(1, file.SizeBytes / 1024)) KB</small>
                                    </a>
                                }
                            }
                        </div>
                    </article>

                    @foreach (var group in Model.Relations.Take(4))
                    {
                        <article class="crm-rd-card">
                            <header class="crm-rd-card-head">
                                <h3>@group.Label</h3>
                                <button type="button" class="crm-rd-card-link" data-crm-rd-jump="@group.TabKey">مشاهده</button>
                            </header>
                            <div class="crm-rd-card-body">
                                @if (group.Records.Count == 0)
                                {
                                    <div class="crm-rd-empty-sm">موردی ثبت نشده</div>
                                }
                                else
                                {
                                    @foreach (var item in group.Records.Take(5))
                                    {
                                        <a class="crm-rd-rel-chip" href="/App/m/@item.ModuleName/@item.RecordId">@item.Title</a>
                                    }
                                }
                            </div>
                        </article>
                    }

                    <article class="crm-rd-card">
                        <header class="crm-rd-card-head">
                            <h3>تگ‌ها</h3>
                        </header>
                        <div class="crm-rd-card-body">
                            @if (Model.Tags.Count == 0)
                            {
                                <div class="crm-rd-empty-sm">تگی متصل نیست</div>
                            }
                            else
                            {
                                @foreach (var tag in Model.Tags)
                                {
                                    <span class="crm-rd-tag" style="@(string.IsNullOrWhiteSpace(tag.Color) ? null : $"--tag:{tag.Color}")">
                                        <i class="bx bx-purchase-tag"></i> @tag.Name
                                    </span>
                                }
                            }
                        </div>
                    </article>
                </div>
            </section>

            <section id="information" class="crm-rd-panel" data-crm-rd-panel="information">
                <h5 class="crm-rd-panel-title">اطلاعات کامل</h5>
                @foreach (var (block, groupFields) in Model.GroupedFields())
                {
                    <div class="crm-rd-block-card">
                        @if (block is not null)
                        {
                            <h6>@block.Label</h6>
                        }
                        <dl class="crm-rd-dl">
                            @foreach (var field in groupFields)
                            {
                                <div>
                                    <dt>@field.Label</dt>
                                    <dd>
                                        @{
                                            var lookupMod = Model.LookupModuleFor(field);
                                            var lookupId = Model.LookupRecordId(field);
                                            var display = FormatFieldDisplay(field);
                                        }
                                        @if (lookupMod is not null && lookupId is not null && display != "—")
                                        {
                                            <a href="/App/m/@lookupMod/@lookupId">@display</a>
                                        }
                                        else if (field.Type == FieldType.Url && display != "—")
                                        {
                                            <a href="@display" target="_blank" rel="noopener">@display</a>
                                        }
                                        else if (field.Type == FieldType.Email && display != "—")
                                        {
                                            <a href="mailto:@display">@display</a>
                                        }
                                        else if (field.Type == FieldType.MultilineText)
                                        {
                                            <span style="white-space: pre-wrap">@display</span>
                                        }
                                        else if (field.Type == FieldType.Picklist && Model.Values.TryGetValue(field.Name, out var pv) && pv is not null)
                                        {
                                            var pick = field.PicklistValues.FirstOrDefault(p => p.Value == pv);
                                            <span class="crm-rd-pill" style="--pill:@(pick?.Color ?? "#2f6fed")">@(pick?.Label ?? pv)</span>
                                        }
                                        else
                                        {
                                            @display
                                        }
                                    </dd>
                                </div>
                            }
                        </dl>
                    </div>
                }
            </section>

            <section id="updates" class="crm-rd-panel" data-crm-rd-panel="updates">
                <h5 class="crm-rd-panel-title">بروزرسانی‌ها</h5>
                @if (Model.AuditLogs.Count == 0)
                {
                    <div class="crm-rd-empty">هنوز تغییری ثبت نشده است.</div>
                }
                else
                {
                    <ul class="crm-rd-timeline">
                        @foreach (var log in Model.AuditLogs)
                        {
                            <li>
                                <div class="fw-semibold">@AuditActionLabel(log.Action)</div>
                                <div class="crm-rd-time">
                                    @AuditUserLabel(log.UserId)
                                    · @PersianDateHelper.ToJalaliDateTime(log.AtUtc)
                                </div>
                                @if (!string.IsNullOrWhiteSpace(log.Changes) && log.Changes != "{}")
                                {
                                    <div class="small text-muted mt-1" style="word-break: break-word;">
                                        @{
                                            try
                                            {
                                                using var doc = JsonDocument.Parse(log.Changes);
                                                if (string.Equals(log.Action, "Convert", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    var contactId = doc.RootElement.TryGetProperty("ContactId", out var cEl) ? cEl.ToString() : null;
                                                    var orgId = doc.RootElement.TryGetProperty("OrganizationId", out var oEl) ? oEl.ToString() : null;
                                                    var oppId = doc.RootElement.TryGetProperty("OpportunityId", out var pEl) ? pEl.ToString() : null;
                                                    <div>تبدیل سرنخ
                                                        @if (!string.IsNullOrWhiteSpace(contactId) && contactId != "null")
                                                        { <text>به مخاطب #@contactId </text> }
                                                        @if (!string.IsNullOrWhiteSpace(orgId) && orgId != "null")
                                                        { <text>و سازمان #@orgId </text> }
                                                        @if (!string.IsNullOrWhiteSpace(oppId) && oppId != "null")
                                                        { <text>و فرصت #@oppId</text> }
                                                    </div>
                                                }
                                                else if (string.Equals(log.Action, "Payment", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    var amt = doc.RootElement.TryGetProperty("amount", out var aEl) ? aEl.ToString() : null;
                                                    var method = doc.RootElement.TryGetProperty("method", out var mEl) ? mEl.ToString() : null;
                                                    <div>مبلغ @(amt ?? "—") · روش @(method ?? "—")</div>
                                                }
                                                else
                                                {
                                                    foreach (var prop in doc.RootElement.EnumerateObject().Take(12))
                                                    {
                                                        string? oldVal = null, newVal = null;
                                                        if (prop.Value.ValueKind == JsonValueKind.Object)
                                                        {
                                                            if (prop.Value.TryGetProperty("old", out var oldEl)
                                                                || prop.Value.TryGetProperty("Old", out oldEl))
                                                                oldVal = oldEl.ValueKind == JsonValueKind.Null ? null : oldEl.ToString();
                                                            if (prop.Value.TryGetProperty("new", out var newEl)
                                                                || prop.Value.TryGetProperty("New", out newEl))
                                                                newVal = newEl.ValueKind == JsonValueKind.Null ? null : newEl.ToString();
                                                        }

                                                        if (oldVal is not null || newVal is not null)
                                                        {
                                                            var fromText = string.IsNullOrWhiteSpace(oldVal) ? "خالی" : oldVal;
                                                            var toText = string.IsNullOrWhiteSpace(newVal) ? "خالی" : newVal;
                                                            <div><strong>@FieldLabel(prop.Name)</strong>: از @fromText شد @toText</div>
                                                        }
                                                        else if (prop.Name is not "ContactId" and not "OrganizationId" and not "OpportunityId")
                                                        {
                                                            <div><strong>@FieldLabel(prop.Name)</strong>: @prop.Value.ToString()</div>
                                                        }
                                                    }
                                                }
                                            }
                                            catch
                                            {
                                                <span>@log.Changes</span>
                                            }
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section id="notes" class="crm-rd-panel" data-crm-rd-panel="notes">
                <h5 class="crm-rd-panel-title">یادداشت‌ها</h5>
                <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/notes" class="crm-rd-note-form">
                    @Html.AntiForgeryToken()
                    <textarea id="noteText" name="text" class="form-control" rows="3" maxlength="4000" required
                              placeholder="متن یادداشت را بنویسید..."></textarea>
                    <div class="mt-2 text-end">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bx bx-plus me-1"></i> افزودن یادداشت
                        </button>
                    </div>
                </form>

                @if (Model.Notes.Count == 0)
                {
                    <div class="crm-rd-empty">یادداشتی ثبت نشده است.</div>
                }
                else
                {
                    @foreach (var note in Model.Notes)
                    {
                        <div class="crm-rd-note">
                            <div class="crm-rd-note-meta">@PersianDateHelper.ToJalaliDateTime(note.CreatedAtUtc)</div>
                            <div style="white-space: pre-wrap">@note.Body</div>
                        </div>
                    }
                }
            </section>

            <section id="activities" class="crm-rd-panel" data-crm-rd-panel="activities">
                <h5 class="crm-rd-panel-title">فعالیت‌ها</h5>
                @if (Model.Activities.Count == 0)
                {
                    <div class="crm-rd-empty">فعالیت مرتبطی یافت نشد.</div>
                }
                else
                {
                    <div class="crm-rd-rel-list">
                        @foreach (var item in Model.Activities)
                        {
                            <a class="crm-rd-rel-row" href="/App/m/@item.ModuleName/@item.RecordId">
                                <span class="crm-rd-activity-badge">@item.ModuleLabel</span>
                                <span class="crm-rd-rel-row-title">@item.Title</span>
                                <i class="bx bx-chevron-left"></i>
                            </a>
                        }
                    </div>
                }
            </section>

            <section id="attachments" class="crm-rd-panel" data-crm-rd-panel="attachments">
                <h5 class="crm-rd-panel-title">اسناد و پیوست‌ها</h5>
                <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/attachments"
                      enctype="multipart/form-data" class="crm-rd-upload">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" class="form-control" required />
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bx bx-upload me-1"></i> آپلود
                    </button>
                </form>

                @if (Model.Attachments.Count == 0)
                {
                    <div class="crm-rd-empty">
                        <i class="bx bx-paperclip bx-md d-block mb-2"></i>
                        هنوز پیوستی بارگذاری نشده است.
                    </div>
                }
                else
                {
                    <div class="crm-rd-rel-list">
                        @foreach (var file in Model.Attachments)
                        {
                            <div class="crm-rd-rel-row crm-rd-file-row">
                                <a href="/App/m/@Model.Module.Name/@Model.Record.Id/attachments/@file.Id" class="crm-rd-file-link">
                                    <i class="bx bx-file"></i>
                                    <span>@file.FileName</span>
                                    <small class="text-muted">@(Math.Max(1, file.SizeBytes / 1024)) KB · @PersianDateHelper.ToJalaliDate(file.CreatedAtUtc)</small>
                                </a>
                                @if (Model.CanEdit)
                                {
                                    <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/attachments/@file.Id/delete"
                                          data-confirm="این پیوست حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-icon btn-text-danger" title="حذف">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            <section id="tags" class="crm-rd-panel" data-crm-rd-panel="tags">
                <h5 class="crm-rd-panel-title">تگ‌ها</h5>
                @if (Model.Tags.Count == 0)
                {
                    <div class="crm-rd-empty">تگی به این رکورد متصل نیست.</div>
                }
                else
                {
                    <div>
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="crm-rd-tag" style="@(string.IsNullOrWhiteSpace(tag.Color) ? null : $"--tag:{tag.Color}")">
                                <i class="bx bx-purchase-tag"></i> @tag.Name
                            </span>
                        }
                    </div>
                }
            </section>

            @if (Model.LineBlock is not null)
            {
                var isPriceBook = string.Equals(Model.Module.Name, "pricebooks", StringComparison.OrdinalIgnoreCase);
                <section id="products" class="crm-rd-panel" data-crm-rd-panel="products">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h5 class="crm-rd-panel-title mb-0 border-0 pb-0">@(isPriceBook ? "لیست قیمت‌ها" : "محصولات و اقلام")</h5>
                        @if (Model.CanEdit)
                        {
                            <a class="btn btn-sm btn-outline-primary"
                               href="/App/m/@Model.Module.Name/@Model.Record.Id/edit">
                                <i class="bx bx-edit me-1"></i> @(isPriceBook ? "ویرایش قیمت‌ها" : "ویرایش اقلام")
                            </a>
                        }
                    </div>
                    @if (Model.LineItems.Count == 0)
                    {
                        <div class="crm-rd-empty">@(isPriceBook ? "هنوز قیمتی در این دفترچه ثبت نشده است." : "هنوز محصولی برای این سند ثبت نشده است.")</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:3rem">#</th>
                                        @foreach (var f in Model.LineFields)
                                        {
                                            <th>@f.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rowNo = 0; }
                                    @foreach (var row in Model.LineItems)
                                    {
                                        rowNo++;
                                        <tr>
                                            <td class="text-muted">@rowNo</td>
                                            @foreach (var f in Model.LineFields)
                                            {
                                                var display = Model.LineDisplayValue(f, row) ?? "—";
                                                var isNum = f.Type is FieldType.Currency or FieldType.Decimal
                                                    or FieldType.Number or FieldType.Percent;
                                                <td class="@(isNum ? "text-start" : null)" dir="@(isNum ? "ltr" : null)">@display</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!isPriceBook)
                        {
                            <div class="d-flex flex-wrap justify-content-end gap-4 mt-3 small">
                                @if (!string.IsNullOrWhiteSpace(Model.Values.GetValueOrDefault("subTotal")))
                                {
                                    <div>جمع جزء: <strong>@(decimal.TryParse(Model.Values["subTotal"], out var st) ? st.ToString("N0") : Model.Values["subTotal"])</strong></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Values.GetValueOrDefault("taxTotal")))
                                {
                                    <div>مالیات: <strong>@(decimal.TryParse(Model.Values["taxTotal"], out var tx) ? tx.ToString("N0") : Model.Values["taxTotal"])</strong></div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Values.GetValueOrDefault("grandTotal")))
                                {
                                    <div>جمع کل: <strong class="text-primary">@(decimal.TryParse(Model.Values["grandTotal"], out var gt) ? gt.ToString("N0") : Model.Values["grandTotal"])</strong></div>
                                }
                            </div>
                        }
                    }
                </section>
            }

            @if (string.Equals(Model.Module.Name, "invoices", StringComparison.OrdinalIgnoreCase))
            {
                <section id="payments" class="crm-rd-panel" data-crm-rd-panel="payments">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h5 class="crm-rd-panel-title mb-0 border-0 pb-0">پرداخت‌ها</h5>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-secondary" href="/App/m/payments">
                                <i class="bx bx-list-ul me-1"></i> همه پرداخت‌ها
                            </a>
                            @if (Model.CanEdit && Model.InvoiceRemainingAmount > 0.01m)
                            {
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#payModal">
                                    <i class="bx bx-plus me-1"></i> پرداخت جدید
                                </button>
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-4 mb-3 small">
                        <div>جمع فاکتور: <strong>@Model.InvoiceGrandTotal.ToString("N0")</strong></div>
                        <div>پرداخت‌شده: <strong class="text-success">@Model.InvoicePaidAmount.ToString("N0")</strong></div>
                        <div>مانده: <strong class="@(Model.InvoiceRemainingAmount > 0 ? "text-warning" : "text-success")">@Model.InvoiceRemainingAmount.ToString("N0")</strong></div>
                    </div>
                    @if (Model.InvoicePayments.Count == 0)
                    {
                        <div class="crm-rd-empty">هنوز پرداختی برای این فاکتور ثبت نشده است.</div>
                    }
                    else
                    {
                        var methodLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                        {
                            ["cash"] = "نقد", ["card"] = "کارت", ["transfer"] = "حواله", ["cheque"] = "چک"
                        };
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>مبلغ</th>
                                        <th>روش</th>
                                        <th>تاریخ</th>
                                        <th>پیگیری</th>
                                        <th>توضیح</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var pNo = 0; }
                                    @foreach (var pay in Model.InvoicePayments)
                                    {
                                        pNo++;
                                        var amt = pay.GetValueOrDefault("amount");
                                        var method = pay.GetValueOrDefault("method") ?? "";
                                        var methodLabel = methodLabels.TryGetValue(method, out var ml) ? ml : method;
                                        <tr>
                                            <td class="text-muted">@pNo</td>
                                            <td dir="ltr">@(decimal.TryParse(amt, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var pa) ? pa.ToString("N0") : amt)</td>
                                            <td>@methodLabel</td>
                                            <td>@(pay.GetValueOrDefault("paidAt") ?? "—")</td>
                                            <td>@(pay.GetValueOrDefault("reference") ?? "—")</td>
                                            <td>@(pay.GetValueOrDefault("description") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }

            @foreach (var group in Model.Relations)
            {
                var createHref = !string.IsNullOrWhiteSpace(group.LinkFieldName)
                    ? $"/App/m/{group.ModuleName}/create?f_{group.LinkFieldName}={group.ParentRecordId}"
                    : $"/App/m/{group.ModuleName}/create";
                <section id="@group.TabKey" class="crm-rd-panel" data-crm-rd-panel="@group.TabKey">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h5 class="crm-rd-panel-title mb-0 border-0 pb-0">@group.Label</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @if (!string.IsNullOrWhiteSpace(group.LinkFieldName))
                            {
                                <a class="btn btn-sm btn-primary" href="@createHref">
                                    <i class="bx bx-plus me-1"></i> ایجاد مرتبط
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@createHref">
                                    <i class="bx bx-plus me-1"></i> افزودن مرتبط
                                </a>
                            }
                        </div>
                    </div>

                    @if (group.IsManyToMany && group.RelationId is int m2mRelId)
                    {
                        <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/link-related"
                              class="crm-rd-link-form mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="relatedModule" value="@group.ModuleName" />
                            <input type="hidden" name="relationId" value="@m2mRelId" />
                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div class="flex-grow-1" style="min-width:12rem">
                                    <label class="form-label small mb-1">اتصال رکورد موجود</label>
                                    <select name="relatedRecordId" class="form-select form-select-sm crm-select2"
                                            data-placeholder="جستجو و انتخاب…" data-allow-clear="true"
                                            data-ajax-url="/App/m/@Model.Module.Name/@Model.Record.Id/link-candidates?relatedModule=@Uri.EscapeDataString(group.ModuleName)&relationId=@m2mRelId"
                                            required>
                                        <option value="">— انتخاب کنید —</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-link me-1"></i> اتصال
                                </button>
                            </div>
                        </form>
                    }
                    else if (!string.IsNullOrWhiteSpace(group.LinkFieldName))
                    {
                        <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/link-related"
                              class="crm-rd-link-form mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="relatedModule" value="@group.ModuleName" />
                            <input type="hidden" name="linkField" value="@group.LinkFieldName" />
                            <div class="d-flex flex-wrap gap-2 align-items-end">
                                <div class="flex-grow-1" style="min-width:12rem">
                                    <label class="form-label small mb-1">اتصال رکورد موجود</label>
                                    <select name="relatedRecordId" class="form-select form-select-sm crm-select2"
                                            data-placeholder="جستجو و انتخاب…" data-allow-clear="true"
                                            data-ajax-url="/App/m/@Model.Module.Name/@Model.Record.Id/link-candidates?relatedModule=@Uri.EscapeDataString(group.ModuleName)&linkField=@Uri.EscapeDataString(group.LinkFieldName!)"
                                            required>
                                        <option value="">— انتخاب کنید —</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bx bx-link me-1"></i> اتصال
                                </button>
                            </div>
                        </form>
                    }

                    @if (group.Records.Count == 0)
                    {
                        <div class="crm-rd-empty">موردی ثبت نشده است.</div>
                    }
                    else
                    {
                        <div class="crm-rd-rel-list">
                            @foreach (var item in group.Records)
                            {
                                <div class="crm-rd-rel-row d-flex align-items-center gap-2">
                                    <a class="flex-grow-1 text-decoration-none text-body d-flex align-items-center gap-2"
                                       href="/App/m/@item.ModuleName/@item.RecordId">
                                        <span class="crm-rd-rel-row-title">@item.Title</span>
                                        <span class="text-muted small">@item.ModuleLabel</span>
                                        <i class="bx bx-chevron-left ms-auto"></i>
                                    </a>
                                    @if (group.IsManyToMany && group.RelationId is int unlinkRel)
                                    {
                                        <form method="post" action="/App/m/@Model.Module.Name/@Model.Record.Id/unlink-related" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="relationId" value="@unlinkRel" />
                                            <input type="hidden" name="relatedRecordId" value="@item.RecordId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="قطع اتصال">
                                                <i class="bx bx-unlink"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>

        <aside class="crm-rd-sidebar">
            <nav class="crm-rd-nav" data-crm-rd-nav>
                <button type="button" class="nav-link active" data-crm-rd-target="summary">
                    <i class="bx bx-grid-alt"></i> <span>خلاصه اطلاعات</span>
                </button>
                <button type="button" class="nav-link" data-crm-rd-target="information">
                    <i class="bx bx-detail"></i> <span>اطلاعات</span>
                </button>
                <button type="button" class="nav-link" data-crm-rd-target="updates">
                    <i class="bx bx-history"></i> <span>بروزرسانی‌ها</span>
                </button>
                <button type="button" class="nav-link" data-crm-rd-target="notes">
                    <i class="bx bx-note"></i> <span>یادداشت‌ها</span>
                    @if (Model.Notes.Count > 0)
                    {
                        <span class="crm-rd-count">@Model.Notes.Count</span>
                    }
                </button>
                <button type="button" class="nav-link" data-crm-rd-target="activities">
                    <i class="bx bx-calendar-check"></i> <span>فعالیت‌ها</span>
                    @if (Model.Activities.Count > 0)
                    {
                        <span class="crm-rd-count">@Model.Activities.Count</span>
                    }
                </button>
                <button type="button" class="nav-link" data-crm-rd-target="attachments">
                    <i class="bx bx-paperclip"></i> <span>اسناد</span>
                    @if (Model.Attachments.Count > 0)
                    {
                        <span class="crm-rd-count">@Model.Attachments.Count</span>
                    }
                </button>
                @if (Model.LineBlock is not null)
                {
                    <button type="button" class="nav-link" data-crm-rd-target="products">
                        <i class="bx bx-package"></i>
                        <span>@(string.Equals(Model.Module.Name, "pricebooks", StringComparison.OrdinalIgnoreCase) ? "لیست قیمت‌ها" : "محصولات")</span>
                        @if (Model.LineItems.Count > 0)
                        {
                            <span class="crm-rd-count">@Model.LineItems.Count</span>
                        }
                    </button>
                }
                @if (string.Equals(Model.Module.Name, "invoices", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="nav-link" data-crm-rd-target="payments">
                        <i class="bx bx-money"></i> <span>پرداخت‌ها</span>
                        @if (Model.InvoicePayments.Count > 0)
                        {
                            <span class="crm-rd-count">@Model.InvoicePayments.Count</span>
                        }
                    </button>
                }
                @foreach (var group in Model.Relations)
                {
                    <button type="button" class="nav-link" data-crm-rd-target="@group.TabKey">
                        <i class="bx bx-link-alt"></i> <span>@group.Label</span>
                        @if (group.Records.Count > 0)
                        {
                            <span class="crm-rd-count">@group.Records.Count</span>
                        }
                    </button>
                }
                <button type="button" class="nav-link" data-crm-rd-target="tags">
                    <i class="bx bx-purchase-tag"></i> <span>تگ‌ها</span>
                </button>
            </nav>
        </aside>
    </div>
</div>

@if (string.Equals(Model.Module.Name, "invoices", StringComparison.OrdinalIgnoreCase) && Model.CanEdit && Model.InvoiceRemainingAmount > 0.01m)
{
    <div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="AddPayment" asp-route-moduleName="@Model.Module.Name" asp-route-id="@Model.Record.Id" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">ثبت پرداخت</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        جمع فاکتور: <strong>@Model.InvoiceGrandTotal.ToString("N0")</strong>
                        · پرداخت‌شده: <strong>@Model.InvoicePaidAmount.ToString("N0")</strong>
                        · مانده: <strong>@Model.InvoiceRemainingAmount.ToString("N0")</strong>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">مبلغ</label>
                        <input type="text" inputmode="decimal" name="amount" class="form-control" dir="ltr" required
                               value="@Model.InvoiceRemainingAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">روش</label>
                        <select name="method" class="form-select">
                            <option value="transfer">حواله</option>
                            <option value="cash">نقد</option>
                            <option value="card">کارت</option>
                            <option value="cheque">چک</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">شماره پیگیری</label>
                        <input type="text" name="reference" class="form-control" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">یادداشت</label>
                        <textarea name="note" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ثبت</button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.PrintTemplates.Count > 0)
{
    var defaultTpl = Model.PrintTemplates.FirstOrDefault(t => t.IsDefault) ?? Model.PrintTemplates[0];
    <div class="modal fade" id="printExportModal" tabindex="-1" aria-labelledby="printExportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content crm-print-export">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title" id="printExportModalLabel">
                            <i class="bx bx-printer text-primary me-1"></i> خروجی چاپ
                        </h5>
                        <div class="text-muted small mt-1">قالب موردنظر را انتخاب کنید، سپس خروجی بگیرید.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body pt-3">
                    <label class="form-label fw-semibold" for="printTemplateSelect">قالب</label>
                    <select id="printTemplateSelect" class="form-select crm-select2"
                            data-placeholder="جستجو و انتخاب قالب…"
                            data-dropdown-parent="#printExportModal"
                            data-allow-clear="false">
                        @foreach (var tpl in Model.PrintTemplates)
                        {
                            var pageLabel = tpl.Landscape ? $"{tpl.PageSize} افقی" : $"{tpl.PageSize} عمودی";
                            var label = tpl.IsDefault ? $"{tpl.Name} (پیش‌فرض)" : tpl.Name;
                            if (tpl.Id == defaultTpl.Id)
                            {
                                <option value="@tpl.Id" selected
                                        data-allow-pdf="@(tpl.AllowPdf ? "1" : "0")"
                                        data-allow-word="@(tpl.AllowWord ? "1" : "0")"
                                        data-page="@pageLabel"
                                        data-default="@(tpl.IsDefault ? "1" : "0")">@label</option>
                            }
                            else
                            {
                                <option value="@tpl.Id"
                                        data-allow-pdf="@(tpl.AllowPdf ? "1" : "0")"
                                        data-allow-word="@(tpl.AllowWord ? "1" : "0")"
                                        data-page="@pageLabel"
                                        data-default="@(tpl.IsDefault ? "1" : "0")">@label</option>
                            }
                        }
                    </select>
                    <div class="crm-print-export-meta mt-2" id="printTemplateMeta">
                        <span class="badge bg-label-secondary" id="printTemplatePage"></span>
                        <span class="badge bg-label-primary d-none" id="printTemplateDefault">پیش‌فرض</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                    <div class="ms-auto d-flex flex-wrap gap-2">
                        <a id="printWordBtn" class="btn btn-outline-primary"
                           href="@Url.Action("ExportWord", new { moduleName = Model.Module.Name, id = Model.Record.Id, templateId = defaultTpl.Id })">
                            <i class="bx bx-file me-1"></i> ذخیره Word
                        </a>
                        <a id="printPdfBtn" class="btn btn-primary" target="_blank"
                           href="@Url.Action("Print", new { moduleName = Model.Module.Name, id = Model.Record.Id, templateId = defaultTpl.Id })">
                            <i class="bx bx-printer me-1"></i> ذخیره PDF
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    var root = document.querySelector('.crm-rd');
    if (!root) return;

    var nav = root.querySelector('[data-crm-rd-nav]');
    var panels = root.querySelectorAll('[data-crm-rd-panel]');
    if (nav) {
        function showPanel(id, pushHash) {
            panels.forEach(function (p) {
                p.classList.toggle('is-active', p.getAttribute('data-crm-rd-panel') === id);
            });
            nav.querySelectorAll('[data-crm-rd-target]').forEach(function (btn) {
                btn.classList.toggle('active', btn.getAttribute('data-crm-rd-target') === id);
            });
            if (pushHash) history.replaceState(null, '', '#' + id);
            var active = root.querySelector('[data-crm-rd-panel="' + id + '"]');
            if (active) active.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        nav.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-crm-rd-target]');
            if (!btn) return;
            e.preventDefault();
            showPanel(btn.getAttribute('data-crm-rd-target'), true);
        });

        root.addEventListener('click', function (e) {
            var jump = e.target.closest('[data-crm-rd-jump]');
            if (!jump) return;
            e.preventDefault();
            showPanel(jump.getAttribute('data-crm-rd-jump'), true);
        });

        var hash = (location.hash || '').replace(/^#/, '');
        if (hash && root.querySelector('[data-crm-rd-panel="' + hash + '"]')) {
            showPanel(hash, false);
        } else if (root.getAttribute('data-default-panel')) {
            var def = root.getAttribute('data-default-panel');
            if (root.querySelector('[data-crm-rd-panel="' + def + '"]'))
                showPanel(def, false);
        }
    }

    // ── مودال انتخاب قالب چاپ ───────────────────────────────────
    var modal = document.getElementById('printExportModal');
    var select = document.getElementById('printTemplateSelect');
    if (!modal || !select) return;

    var pdfBtn = document.getElementById('printPdfBtn');
    var wordBtn = document.getElementById('printWordBtn');
    var pageBadge = document.getElementById('printTemplatePage');
    var defaultBadge = document.getElementById('printTemplateDefault');
    var moduleName = '@Model.Module.Name';
    var recordId = '@Model.Record.Id';

    function selectedOption() {
        if (window.jQuery && jQuery(select).data('select2')) {
            var data = jQuery(select).select2('data');
            if (data && data[0] && data[0].element) return data[0].element;
        }
        return select.options[select.selectedIndex] || null;
    }

    function syncExportButtons() {
        var opt = selectedOption();
        if (!opt) return;
        var id = opt.value;
        var allowPdf = opt.getAttribute('data-allow-pdf') === '1';
        var allowWord = opt.getAttribute('data-allow-word') === '1';
        var page = opt.getAttribute('data-page') || '';
        var isDefault = opt.getAttribute('data-default') === '1';

        if (pageBadge) pageBadge.textContent = page;
        if (defaultBadge) defaultBadge.classList.toggle('d-none', !isDefault);

        if (pdfBtn) {
            pdfBtn.href = '/App/m/' + encodeURIComponent(moduleName) + '/' + recordId + '/print?templateId=' + encodeURIComponent(id);
            pdfBtn.classList.toggle('disabled', !allowPdf);
            pdfBtn.setAttribute('aria-disabled', allowPdf ? 'false' : 'true');
            if (!allowPdf) pdfBtn.addEventListener('click', blockDisabled, { once: false });
        }
        if (wordBtn) {
            wordBtn.href = '/App/m/' + encodeURIComponent(moduleName) + '/' + recordId + '/word?templateId=' + encodeURIComponent(id);
            wordBtn.classList.toggle('disabled', !allowWord);
            wordBtn.setAttribute('aria-disabled', allowWord ? 'false' : 'true');
        }
    }

    function blockDisabled(e) {
        if (this.classList.contains('disabled')) e.preventDefault();
    }

    if (pdfBtn) pdfBtn.addEventListener('click', blockDisabled);
    if (wordBtn) wordBtn.addEventListener('click', blockDisabled);

    select.addEventListener('change', syncExportButtons);
    if (window.jQuery) {
        jQuery(select).on('change.select2', syncExportButtons);
    }

    modal.addEventListener('shown.bs.modal', function () {
        if (window.initCrmSelect2) window.initCrmSelect2(modal);
        syncExportButtons();
        if (window.jQuery && jQuery(select).data('select2')) {
            jQuery(select).select2('focus');
        }
    });

    syncExportButtons();
})();
</script>
}
