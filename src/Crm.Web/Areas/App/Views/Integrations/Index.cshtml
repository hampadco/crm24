@using Crm.Core.Entities
@using Crm.Infrastructure.Services
@using Crm.Web.Services
@{
    var config = (IntegrationConfig)ViewBag.Config;
    var apiKeys = (List<ApiKey>)ViewBag.ApiKeys;
}

<h4 class="mb-4"><i class="bx bx-plug text-primary me-1"></i> یکپارچگی‌ها و API</h4>

<partial name="_Alerts" />

@if (TempData["NewApiKey"] is string newKey)
{
    <div class="alert alert-warning">
        <strong>کلید را کپی کنید:</strong>
        <div class="input-group mt-2" dir="ltr">
            <input id="crm-new-api-key" type="text" class="form-control font-monospace" readonly value="@newKey" />
            <button type="button" class="btn btn-warning" data-crm-copy="#crm-new-api-key">کپی</button>
        </div>
    </div>
}
@if (TempData["NewWebhookSecret"] is string newSecret)
{
    <div class="alert alert-warning">
        <strong>رمز امضای وب‌هوک (فقط همین یک بار):</strong>
        <code dir="ltr" class="user-select-all d-block mt-2 fs-5">@newSecret</code>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-envelope me-1"></i> ایمیل (SMTP)</h5></div>
                <div class="card-body row g-3">
                    <div class="col-md-8"><label class="form-label">سرور SMTP</label><input type="text" name="SmtpHost" value="@config.SmtpHost" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label">پورت</label><input type="number" name="SmtpPort" value="@config.SmtpPort" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label">نام کاربری</label><input type="text" name="SmtpUser" value="@config.SmtpUser" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label">رمز عبور</label><input type="password" name="SmtpPassword" value="@config.SmtpPassword" class="form-control" dir="ltr" /></div>
                    <div class="col-md-4"><label class="form-label">فرستنده</label><input type="text" name="SmtpFrom" value="@config.SmtpFrom" class="form-control" dir="ltr" /></div>
                </div>
            </div>

            <div class="card mb-4" id="sms">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-message me-1"></i> پنل پیامک</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <div class="text-muted small mb-2">هر مستأجر فقط یک پنل دارد. کاوه‌نگار هنوز آماده نیست.</div>
                        <div class="d-flex flex-wrap gap-2">
                            <label class="border rounded px-3 py-2 mb-0">
                                <input type="radio" name="SmsProvider" value="" class="form-check-input me-1" checked="@(string.IsNullOrWhiteSpace(config.SmsProvider))" />
                                بدون پنل
                            </label>
                            <label class="border rounded px-3 py-2 mb-0">
                                <input type="radio" name="SmsProvider" value="ippanel" class="form-check-input me-1" checked="@config.IsIpPanel" />
                                آی‌پی‌پنل
                            </label>
                            <label class="border rounded px-3 py-2 mb-0 text-muted">
                                <input type="radio" name="SmsProvider" value="kavenegar" class="form-check-input me-1" checked="@config.IsKavenegar" />
                                کاوه‌نگار (به‌زودی)
                            </label>
                        </div>
                    </div>
                    <div class="col-12 sms-ippanel-only">
                        <label class="form-check">
                            <input type="checkbox" name="SmsEnabled" value="true" class="form-check-input" checked="@config.SmsEnabled" />
                            <span class="form-check-label">فعال — کاربران بتوانند پیامک بفرستند</span>
                        </label>
                    </div>
                    <div class="col-md-6 sms-ippanel-only">
                        <label class="form-label">کلید API</label>
                        <input type="password" name="SmsApiKey" value="" class="form-control" dir="ltr" autocomplete="new-password"
                               placeholder="@(string.IsNullOrWhiteSpace(config.SmsApiKey) ? "از پنل آی‌پی‌پنل، بخش Access Keys" : "ذخیره شده — برای تغییر، مقدار جدید وارد کنید")" />
                    </div>
                    <div class="col-md-6 sms-ippanel-only">
                        <label class="form-label">شماره خط</label>
                        <input type="text" name="SmsFrom" value="@config.SmsFrom" class="form-control" dir="ltr" placeholder="3000505" />
                    </div>
                    <div class="col-12 sms-ippanel-only">
                        <label class="form-label">آدرس وب‌سرویس</label>
                        <input type="text" name="SmsApiUrl" value="@(config.SmsApiUrl ?? "https://edge.ippanel.com/v1")" class="form-control" dir="ltr" />
                    </div>
                    <div class="col-12 sms-kavenegar-only" hidden>
                        <div class="alert alert-secondary mb-0">کاوه‌نگار ذخیره می‌شود ولی هنوز پیامی ارسال نمی‌کند.</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-chat me-1"></i> پیام‌رسان بله</h5></div>
                <div class="card-body">
                    <label class="form-label">توکن بات</label>
                    <input type="text" name="BaleBotToken" value="@config.BaleBotToken" class="form-control" dir="ltr" />
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-calculator me-1"></i> حسابداری</h5></div>
                <div class="card-body">
                    <label class="form-label">آدرس وب‌سرویس مقصد (فاکتورهای تأییدشده با صف و retry ارسال می‌شوند)</label>
                    <input type="text" name="AccountingWebhookUrl" value="@config.AccountingWebhookUrl" class="form-control" dir="ltr" />
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-phone-call me-1"></i> VoIP سانترال</h5></div>
                <div class="card-body">
                    <label class="form-check">
                        <input type="checkbox" name="VoipEnabled" value="true" class="form-check-input" checked="@config.VoipEnabled" />
                        <span class="form-check-label">فعال — سانترال رویداد تماس ورودی را به <code dir="ltr">POST /api/v1/voip/incoming</code> (با X-Api-Key) بفرستد</span>
                    </label>
                </div>
            </div>

            @{
                var origin = (string)(ViewBag.TelefonchyOrigin ?? "");
                var secret = config.TelefonchyHookSecret ?? "";
                var cdrUrl = $"{origin}/api/v1/telefonchy/cdr/{secret}";
                var eventsUrl = $"{origin}/api/v1/telefonchy/events/{secret}";
            }
            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0"><i class="bx bx-phone me-1"></i> تلفنچی</h5></div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label class="form-check">
                            <input type="checkbox" name="TelefonchyEnabled" value="true" class="form-check-input" checked="@config.TelefonchyEnabled" />
                            <span class="form-check-label">فعال‌سازی اتصال به تلفنچی</span>
                        </label>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">آدرس وب‌سرویس</label>
                        <input type="text" name="TelefonchyBaseUrl" value="@(config.TelefonchyBaseUrl ?? "https://panel.telefonchy.com/webservice/v1")" class="form-control" dir="ltr" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">شناسه سرویس (service_id)</label>
                        <input type="text" name="TelefonchyServiceId" value="@config.TelefonchyServiceId" class="form-control" dir="ltr" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">توکن وب‌سرویس</label>
                        <input type="password" name="TelefonchyToken" value="" class="form-control" dir="ltr" autocomplete="new-password" placeholder="@(string.IsNullOrWhiteSpace(config.TelefonchyToken) ? "" : "ذخیره شده — برای تغییر، مقدار جدید وارد کنید")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">داخلی پیش‌فرض Click-to-Call</label>
                        <input type="text" name="TelefonchyDefaultExten" value="@config.TelefonchyDefaultExten" class="form-control" dir="ltr" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-check">
                            <input type="checkbox" name="TelefonchySyncEnabled" value="true" class="form-check-input" checked="@config.TelefonchySyncEnabled" />
                            <span class="form-check-label">سینک دوره‌ای تماس‌ها</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="form-check">
                            <input type="checkbox" name="TelefonchyAutoLogCalls" value="true" class="form-check-input" checked="@config.TelefonchyAutoLogCalls" />
                            <span class="form-check-label">ثبت خودکار در ماژول تماس</span>
                        </label>
                    </div>
                    <div class="col-md-4">
                        <label class="form-check">
                            <input type="checkbox" name="TelefonchyRecordingEnabled" value="true" class="form-check-input" checked="@config.TelefonchyRecordingEnabled" />
                            <span class="form-check-label">پخش فایل ضبط مکالمه</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info mb-0">
                            <div class="fw-semibold mb-2">آدرس‌های وب‌هوک برای پنل تلفنچی</div>
                            <div class="small mb-2">ارسال اطلاعات تماس (CDR)</div>
                            <code dir="ltr" class="user-select-all d-block mb-3">@cdrUrl</code>
                            <div class="small mb-2">ارسال ایونت تماس</div>
                            <code dir="ltr" class="user-select-all d-block">@eventsUrl</code>
                            @if (config.TelefonchyLastSyncUtc is DateTime lastSync)
                            {
                                <div class="text-muted small mt-2">آخرین سینک: @PersianDateHelper.ToJalaliDate(lastSync)</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <button type="submit" class="btn btn-primary"><i class="bx bx-save me-1"></i> ذخیره تنظیمات</button>
            </div>
        </form>
        <div class="d-flex flex-wrap gap-2 mb-4">
            <form asp-action="TestSms" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary"><i class="bx bx-message-check me-1"></i> تست پیامک</button>
            </form>
            <a href="/App/sms" class="btn btn-outline-primary"><i class="bx bx-send me-1"></i> ارسال پیامک</a>
            <form asp-action="TestTelefonchy" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary"><i class="bx bx-check-circle me-1"></i> تست اتصال</button>
            </form>
            <form asp-action="TelefonchyExtens" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary"><i class="bx bx-list-ul me-1"></i> نمایش داخلی‌های سرویس</button>
            </form>
            <form asp-action="SyncTelefonchy" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary"><i class="bx bx-refresh me-1"></i> سینک تاریخچه (۳۰ روز)</button>
            </form>
            <a href="/App/telephony/report" class="btn btn-outline-secondary"><i class="bx bx-bar-chart me-1"></i> گزارش تماس</a>
            <a href="/App/telephony/trace" class="btn btn-outline-dark"><i class="bx bx-terminal me-1"></i> لاگ تلفنچی</a>
        </div>
        @if (TempData["TelefonchyExtens"] is string extensReport && !string.IsNullOrWhiteSpace(extensReport))
        {
            <div class="alert alert-secondary">
                <div class="fw-semibold mb-2">داخلی‌های ثبت‌شده در تلفنچی</div>
                <div class="small text-muted mb-2">
                    مقدار «داخلی تلفنچی» هر کاربر باید یکی از شماره‌های زیر باشد، وگرنه تماس سریع خطای
                    <span dir="ltr">Active operator was not found</span> می‌دهد.
                </div>
                <pre dir="ltr" class="mb-0 small bg-transparent border-0 p-0">@extensReport</pre>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h5 class="mb-0"><i class="bx bx-key me-1"></i> کلیدهای API</h5></div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    هدر <code dir="ltr">X-Api-Key</code> یا <code dir="ltr">Authorization: Bearer</code>.
                    <a href="/App/integrations/swagger">Swagger این سازمان</a>
                    —
                    <a href="/App/integrations/api-docs">راهنمای اتصال سایت</a>
                </p>
                <p class="text-muted small mb-0">ساخت کلید و وب‌هوک پایین همین صفحه است.</p>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var key in apiKeys)
                {
                    var fullKey = key.Key ?? "";
                    var hasFullKey = fullKey.StartsWith("crm_", StringComparison.Ordinal);
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="flex-grow-1" style="min-width:0">
                                <strong>@key.Name</strong>
                                <span class="badge @(key.IsActive ? "bg-label-success" : "bg-label-secondary") ms-1">@(key.IsActive ? "فعال" : "غیرفعال")</span>
                                <span class="badge bg-label-info ms-1">@(key.Kind == "public" ? "عمومی" : "محرمانه")</span>
                                @if (hasFullKey)
                                {
                                    <div class="input-group input-group-sm mt-2" dir="ltr">
                                        <input id="crm-api-key-@key.Id" type="text" class="form-control font-monospace" readonly value="@fullKey" />
                                        <button type="button" class="btn btn-outline-primary" data-crm-copy="#crm-api-key-@key.Id">کپی</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted mt-2">متن کامل این کلید ذخیره نشده و قابل کپی نیست.</div>
                                    <form asp-action="ReissueApiKey" asp-route-id="@key.Id" method="post" class="mt-2" onsubmit="return confirm('کلید قبلی از کار می‌افتد و یک کلید تازهٔ قابل کپی ساخته می‌شود. ادامه می‌دهید؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">صدور کلید جدید قابل کپی</button>
                                    </form>
                                }
                                <div class="text-muted small mt-1">
                                    @key.RequestCount درخواست
                                    @if (key.LastUsedAtUtc is DateTime lastUsed)
                                    {
                                        <span> — آخرین استفاده @PersianDateHelper.ToJalaliDate(lastUsed)</span>
                                    }
                                </div>
                            </div>
                            <div class="d-flex gap-1">
                                <form asp-action="ToggleApiKey" asp-route-id="@key.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(key.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(key.IsActive ? "ابطال" : "فعال")
                                    </button>
                                </form>
                                <form asp-action="DeleteApiKey" asp-route-id="@key.Id" method="post" onsubmit="return confirm('کلید حذف شود؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">حذف</button>
                                </form>
                            </div>
                        </div>
                    </li>
                }
                @if (apiKeys.Count == 0)
                {
                    <li class="list-group-item text-muted text-center py-3">کلیدی ساخته نشده است.</li>
                }
            </ul>
        </div>
    </div>
</div>

@{
    var apiModules = ViewBag.ApiModules as System.Collections.IEnumerable;
    var apiUsers = ViewBag.ApiUsers as System.Collections.IEnumerable;
    var webhooks = (List<ApiWebhook>)(ViewBag.ApiWebhooks ?? new List<ApiWebhook>());
}

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">کلید تازه</h5></div>
            <div class="card-body">
                <form asp-action="CreateApiKey" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label">نام</label>
                        <input type="text" name="name" class="form-control" placeholder="مثلاً فروشگاه" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">نوع</label>
                        <select name="kind" class="form-select" id="api-key-kind">
                            <option value="secret">محرمانه — سرور سایت</option>
                            <option value="public">عمومی — فرم داخل مرورگر</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">مالک رکوردها</label>
                        <select name="actAsUserId" class="form-select">
                            <option value="">کاربر فعلی</option>
                            @if (apiUsers is not null)
                            {
                                foreach (dynamic user in apiUsers)
                                {
                                    <option value="@user.Id">@user.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">انقضا</label>
                        <input type="date" name="expiresAt" class="form-control" dir="ltr" />
                    </div>
                    <div class="col-12" id="api-key-origins">
                        <label class="form-label">دامنه‌های مجاز کلید عمومی</label>
                        <textarea name="origins" class="form-control" rows="2" dir="ltr" placeholder="https://shop.example.com"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-check">
                            <input type="checkbox" name="fullAccess" value="true" class="form-check-input" checked />
                            <span class="form-check-label">دسترسی کامل به همهٔ ماژول‌ها (فقط کلید محرمانه)</span>
                        </label>
                    </div>
                    <div class="col-12">
                        <div class="form-label">یا انتخاب ماژول</div>
                        <div class="row g-2">
                            @if (apiModules is not null)
                            {
                                foreach (dynamic module in apiModules)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label small mb-1">@module.PluralLabel</label>
                                        <select name="scopes" class="form-select form-select-sm">
                                            <option value="">بدون دسترسی</option>
                                            <option value="@(module.Name):r">فقط خواندن</option>
                                            <option value="@(module.Name):rw">خواندن و نوشتن</option>
                                        </select>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">ساخت کلید</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">وب‌هوک خروجی</h5></div>
            <div class="card-body">
                <form asp-action="CreateWebhook" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">آدرس</label>
                        <input type="url" name="url" class="form-control" dir="ltr" placeholder="https://shop.example.com/crm-hook" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">ماژول‌ها</label>
                        <input type="text" name="modules" class="form-control" dir="ltr" placeholder="* یا leads,products" />
                    </div>
                    <div class="col-12 d-flex flex-wrap gap-3">
                        <label class="form-check"><input class="form-check-input" type="checkbox" name="events" value="record.created" checked /> <span class="form-check-label">ساخته شد</span></label>
                        <label class="form-check"><input class="form-check-input" type="checkbox" name="events" value="record.updated" checked /> <span class="form-check-label">ویرایش شد</span></label>
                        <label class="form-check"><input class="form-check-input" type="checkbox" name="events" value="record.deleted" checked /> <span class="form-check-label">حذف شد</span></label>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">افزودن وب‌هوک</button>
                    </div>
                </form>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var hook in webhooks)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between gap-2">
                            <div>
                                <div dir="ltr" class="small text-break">@hook.Url</div>
                                <div class="text-muted small mt-1">
                                    @(hook.IsActive ? "فعال" : "غیرفعال")
                                    — آخرین وضعیت: @(hook.LastStatus ?? "—")
                                    — خطاهای پیاپی: @hook.FailCount
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <form asp-action="TestWebhook" asp-route-id="@hook.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-primary" type="submit">تست</button>
                                </form>
                                <form asp-action="ToggleWebhook" asp-route-id="@hook.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@(hook.IsActive ? "خاموش" : "روشن")</button>
                                </form>
                                <form asp-action="DeleteWebhook" asp-route-id="@hook.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">حذف</button>
                                </form>
                            </div>
                        </div>
                    </li>
                }
                @if (webhooks.Count == 0)
                {
                    <li class="list-group-item text-muted text-center">وب‌هوکی ثبت نشده است.</li>
                }
            </ul>
        </div>
    </div>
</div>

<script>
    (function () {
        const radios = document.querySelectorAll('input[name="SmsProvider"]');
        const ip = document.querySelectorAll('.sms-ippanel-only');
        const kv = document.querySelectorAll('.sms-kavenegar-only');
        function sync() {
            const value = document.querySelector('input[name="SmsProvider"]:checked')?.value || '';
            ip.forEach(el => el.hidden = value !== 'ippanel');
            kv.forEach(el => el.hidden = value !== 'kavenegar');
        }
        radios.forEach(r => r.addEventListener('change', sync));
        sync();

        document.addEventListener('click', function (event) {
            const button = event.target.closest('[data-crm-copy]');
            if (!button) return;
            const input = document.querySelector(button.getAttribute('data-crm-copy'));
            if (!input) return;
            const text = input.value;
            const mark = function () {
                const previous = button.textContent;
                button.textContent = 'کپی شد';
                setTimeout(function () { button.textContent = previous; }, 1500);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(mark).catch(function () {
                    input.focus();
                    input.select();
                    document.execCommand('copy');
                    mark();
                });
            } else {
                input.focus();
                input.select();
                document.execCommand('copy');
                mark();
            }
        });
    })();
</script>
