@using Crm.Core.Entities
@using Crm.Web.Services
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@model List<Project>
@{
    var wonOpportunities = (Dictionary<int, string>)ViewBag.WonOpportunities;

    string StatusBadge(ProjectStatus status)
    {
        var cls = status switch
        {
            ProjectStatus.Active => "bg-label-success",
            ProjectStatus.OnHold => "bg-label-warning",
            ProjectStatus.Completed => "bg-label-info",
            _ => "bg-label-secondary"
        };
        return CrmTableHtml.Badge(ProjectsController.StatusLabel(status), cls);
    }

    var rows = Model.Select(project =>
    {
        var progress = project.Tasks.Count == 0 ? 0 : (int)project.Tasks.Average(t => t.ProgressPercent);
        var progressHtml =
            $"<div style=\"min-width:120px\"><div class=\"progress\" style=\"height:8px\"><div class=\"progress-bar\" style=\"width:{progress}%\"></div></div>" +
            $"<small class=\"text-muted\">{progress}%</small></div>";

        return new CrmTableRow
        {
            Id = project.Id.ToString(),
            DetailUrl = $"/App/projects/{project.Id}",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["name"] = CrmTableHtml.Link($"/App/projects/{project.Id}", project.Name),
                ["customer"] = CrmTableHtml.Text(project.CustomerName),
                ["status"] = StatusBadge(project.Status),
                ["range"] = CrmTableHtml.Muted(
                    $"{PersianDateHelper.ToJalaliDate(project.StartUtc)} تا {PersianDateHelper.ToJalaliDate(project.EndUtc)}"),
                ["budget"] = CrmTableHtml.Enc(project.Budget.ToString("N0")),
                ["progress"] = progressHtml
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/projects",
        ShowSearchBox = false,
        EmptyMessage = "پروژه‌ای ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "customer", Label = "مشتری" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" },
            new CrmTableColumn { Key = "range", Label = "بازه" },
            new CrmTableColumn { Key = "budget", Label = "بودجه" },
            new CrmTableColumn { Key = "progress", Label = "پیشرفت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-briefcase-alt-2 text-primary me-1"></i> پروژه‌ها</h4>
        <div class="d-flex gap-2">
            @if (wonOpportunities.Count > 0)
            {
                <div class="dropdown">
                    <button class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bx bx-transfer me-1"></i> تبدیل فرصت برنده
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var opportunity in wonOpportunities)
                        {
                            <li>
                                <form asp-action="FromOpportunity" asp-route-recordId="@opportunity.Key" method="post" class="dropdown-item p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link dropdown-item">@opportunity.Value</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            }
            <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> پروژه جدید</a>
        </div>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
