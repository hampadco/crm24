@using Crm.Core.Entities
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@using Crm.Web.Services
@model List<SalesDocument>
@{
    SalesDocumentKind kind = ViewBag.Kind;
    string kindSlug = ViewBag.KindSlug;
    var kindLabel = FinanceController.KindLabel(kind);
    ViewData["PanelTitle"] = "مالی";

    var filters = ViewBag.ColumnFilters as Dictionary<string, (string Op, string? Value)>
                  ?? new Dictionary<string, (string Op, string? Value)>(StringComparer.OrdinalIgnoreCase);
    var sortField = ViewBag.SortField as string ?? "number";
    var sortDir = ViewBag.SortDir as string ?? "desc";

    string StatusBadge(SalesDocumentStatus status)
    {
        var cls = status switch
        {
            SalesDocumentStatus.Draft => "bg-label-secondary",
            SalesDocumentStatus.Confirmed => "bg-label-info",
            SalesDocumentStatus.Converted => "bg-label-primary",
            SalesDocumentStatus.PartiallyPaid => "bg-label-warning",
            SalesDocumentStatus.Paid => "bg-label-success",
            _ => "bg-label-danger"
        };
        return CrmTableHtml.Badge(FinanceController.StatusLabel(status), cls);
    }

    var statusOptions = Enum.GetValues<SalesDocumentStatus>()
        .Select(s => (s.ToString(), FinanceController.StatusLabel(s)))
        .ToList();

    var rows = Model.Select(doc => new CrmTableRow
    {
        Id = doc.Id.ToString(),
        DetailUrl = $"/App/finance/doc/{doc.Id}",
        ExtraActionsHtml = $"<a href=\"/App/finance/doc/{doc.Id}/print\" target=\"_blank\" class=\"crm-dt-action\" title=\"چاپ\"><i class=\"bx bx-printer\"></i></a>",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["number"] = CrmTableHtml.Link($"/App/finance/doc/{doc.Id}", doc.Number),
            ["customer"] = CrmTableHtml.Text(doc.CustomerName),
            ["date"] = CrmTableHtml.Muted(PersianDateHelper.ToJalaliDate(doc.IssueDateUtc)),
            ["total"] = CrmTableHtml.Money(doc.GrandTotal),
            ["status"] = StatusBadge(doc.Status)
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = $"/App/finance/{kindSlug}",
        SortField = sortField,
        SortDir = sortDir,
        Filters = filters,
        SelectionEnabled = true,
        ShowColumnFilters = true,
        ShowSearchBox = false,
        EmptyMessage = "هنوز سندی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "number", Label = "شماره" },
            new CrmTableColumn { Key = "customer", Label = "مشتری" },
            new CrmTableColumn { Key = "date", Label = "تاریخ صدور" },
            new CrmTableColumn { Key = "total", Label = "مبلغ کل" },
            new CrmTableColumn
            {
                Key = "status",
                Label = "وضعیت",
                FilterKind = CrmTableFilterKind.Select,
                SelectOptions = statusOptions
            }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a href="/App/finance/quotes" class="btn btn-sm @(kindSlug == "quotes" ? "btn-primary" : "btn-outline-primary")">پیش‌فاکتور</a>
        <a href="/App/finance/orders" class="btn btn-sm @(kindSlug == "orders" ? "btn-primary" : "btn-outline-primary")">سفارش فروش</a>
        <a href="/App/finance/invoices" class="btn btn-sm @(kindSlug == "invoices" ? "btn-primary" : "btn-outline-primary")">فاکتور</a>
    </div>
    <div class="crm-list-page-head d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h4 class="mb-0 fw-bold">
            @(kindLabel)ها
            <span class="badge bg-label-secondary rounded-pill align-middle">@(ViewBag.TotalCount ?? Model.Count)</span>
        </h4>
        <a href="/App/finance/@kindSlug/create" class="btn btn-primary btn-sm">
            <i class="bx bx-plus me-1"></i> @kindLabel جدید
        </a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
