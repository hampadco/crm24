@using Crm.Core.Entities
@using Crm.Web.Services
@using Crm.Web.Areas.App.Models
@model List<Warranty>
@{
    ViewData["PanelTitle"] = "پشتیبانی";

    var rows = Model.Select(warranty =>
    {
        var valid = warranty.EndUtc > DateTime.UtcNow;
        return new CrmTableRow
        {
            Id = warranty.Id.ToString(),
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["serial"] = CrmTableHtml.Strong(warranty.SerialNumber),
                ["product"] = CrmTableHtml.Text(warranty.Product?.Name),
                ["customer"] = CrmTableHtml.Text(warranty.CustomerName),
                ["range"] = CrmTableHtml.Enc(
                    $"{PersianDateHelper.ToJalaliDate(warranty.StartUtc)} تا {PersianDateHelper.ToJalaliDate(warranty.EndUtc)}"),
                ["status"] = CrmTableHtml.Badge(
                    valid ? "معتبر" : "منقضی",
                    valid ? "bg-label-success" : "bg-label-danger")
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/warranties",
        Search = ViewBag.Query as string,
        SearchPlaceholder = "جستجوی سریال یا مشتری...",
        EmptyMessage = "گارانتی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "serial", Label = "سریال" },
            new CrmTableColumn { Key = "product", Label = "محصول" },
            new CrmTableColumn { Key = "customer", Label = "مشتری" },
            new CrmTableColumn { Key = "range", Label = "بازه گارانتی" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-shield-quarter text-primary me-1"></i> گارانتی‌ها</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> گارانتی جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
