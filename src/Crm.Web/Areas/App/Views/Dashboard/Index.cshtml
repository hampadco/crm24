@model Crm.Web.Areas.App.Controllers.DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "داشبورد";
    ViewData["PanelTitle"] = Model.Tenant.Name;
    var fa = CultureInfo.GetCultureInfo("fa-IR");
    string Fa(int n) => n.ToString("N0", fa);
    var tone = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/panel-assets/vendor/libs/apex-charts/apex-charts.css" />
    <link rel="stylesheet" href="~/css/crm-dashboard.css" asp-append-version="true" />
}

<partial name="_Alerts" />

<div class="crm-dash" data-dash-live="@(Model.Widgets.Count > 0 ? "1" : "0")">
    <form class="d-none">@Html.AntiForgeryToken()</form>

    <section class="crm-dash-hero">
        <div class="crm-dash-hero-text">
            <h1>@Model.Tenant.Name</h1>
            <p>ثبت‌شده‌های @Model.MonthLabel</p>
        </div>
        <button type="button" class="crm-dash-add" data-bs-toggle="modal" data-bs-target="#widgetModal">
            افزودن ویجت
            <i class="bx bx-plus"></i>
        </button>
        @if (Model.TrialDaysLeft is int days)
        {
            <div class="crm-dash-trial">
                <i class="bx bx-calendar"></i>
                <span>@Fa(days) روز باقی‌مانده</span>
            </div>
        }
    </section>

    <div class="crm-dash-board">
        <p class="crm-dash-board-hint">دستگیره کارت را بکشید، حتی به گروه دیگر. گوشه اندازه را عوض می‌کند؛ کنار یک نمودار سه کارت عدد جا می‌شود. عنوان گروه را هم می‌توانید عوض کنید.</p>
        <div id="dashGroups">
            @foreach (var group in Model.Groups)
            {
                <section class="crm-dash-group">
                    <header class="crm-dash-group-head">
                        <button type="button" class="crm-dash-grip" data-group-grip title="جابه‌جایی گروه" aria-label="جابه‌جایی گروه"><i class="bx bx-grid-vertical"></i></button>
                        <h2 contenteditable="true" spellcheck="false" data-group-title>@group.Title</h2>
                        <button type="button" class="crm-dash-tool" data-group-remove title="حذف گروه" aria-label="حذف گروه"><i class="bx bx-x"></i></button>
                    </header>
                    <div class="crm-dash-grid" data-grid>
                        @foreach (var cell in group.Cells)
                        {
                            var box = $"--gx:{cell.X};--gy:{cell.Y};--gw:{cell.W};--gh:{cell.H}";
                            if (cell.Kind == "chart" && cell.Widget is { } chart)
                            {
                                <article class="crm-dash-card is-chart" data-key="w:@chart.Widget.Id" data-kind="chart" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <header class="crm-dash-card-head">
                                        <div class="crm-dash-card-title">
                                            <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                            <span>@chart.Widget.Title</span>
                                        </div>
                                        <div class="crm-dash-card-tools">
                                            @if (!string.IsNullOrWhiteSpace(chart.Widget.FieldName))
                                            {
                                                <div class="crm-dash-types" data-widget-types="@chart.Widget.Id" role="group" aria-label="نوع نمودار">
                                                    <button type="button" data-type="bar" class="@(chart.Widget.Type == "bar" ? "is-on" : "")" title="میله‌ای"><i class="bx bx-bar-chart-alt-2"></i></button>
                                                    <button type="button" data-type="pie" class="@(chart.Widget.Type == "pie" ? "is-on" : "")" title="دایره‌ای"><i class="bx bx-doughnut-chart"></i></button>
                                                    <button type="button" data-type="funnel" class="@(chart.Widget.Type == "funnel" ? "is-on" : "")" title="قیف"><i class="bx bx-filter-alt"></i></button>
                                                </div>
                                            }
                                            @if (chart.Widget.Type == "monthly")
                                            {
                                                <select class="crm-dash-range" data-widget-range="@chart.Widget.Id" aria-label="بازه روند">
                                                    <option value="3">۳ ماه</option>
                                                    <option value="6" selected>۶ ماه</option>
                                                    <option value="12">۱۲ ماه</option>
                                                </select>
                                            }
                                            <form action="/App/dashboard/widgets/@chart.Widget.Id/remove" method="post" data-confirm="این ویجت از داشبورد برداشته شود؟">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="crm-dash-tool" title="حذف ویجت" aria-label="حذف ویجت"><i class="bx bx-trash"></i></button>
                                            </form>
                                        </div>
                                    </header>
                                    <div class="widget-chart" data-widget-id="@chart.Widget.Id" data-type="@chart.Widget.Type" data-module="@chart.Module?.Name" data-field="@chart.Widget.FieldName">
                                        <div class="crm-dash-loading"><div class="spinner-border spinner-border-sm" role="status"></div>در حال بارگذاری…</div>
                                    </div>
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                            else if (cell.Kind == "counter" && cell.Widget is { } counter)
                            {
                                var toneClass = "t" + (tone++ % 5);
                                <article class="crm-dash-card is-counter" data-key="w:@counter.Widget.Id" data-kind="counter" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                    <a class="crm-dash-counter-link" href="/App/m/@counter.Module?.Name">
                                        <div class="crm-dash-card-title">
                                            <span class="crm-dash-ico @toneClass"><i class="bx @(counter.Module?.Icon ?? "bx-cube")"></i></span>
                                            <span>@counter.Widget.Title</span>
                                        </div>
                                        <div class="crm-dash-metric"><strong data-widget-counter="@counter.Widget.Id">@Fa(counter.CounterValue)</strong></div>
                                    </a>
                                    <form action="/App/dashboard/widgets/@counter.Widget.Id/remove" method="post" data-confirm="این ویجت از داشبورد برداشته شود؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="crm-dash-tool" title="حذف ویجت" aria-label="حذف ویجت"><i class="bx bx-trash"></i></button>
                                    </form>
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                            else if (cell.Kind == "users")
                            {
                                <article class="crm-dash-tile" data-key="u" data-kind="users" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                    <span class="crm-dash-tile-body">
                                        <i class="bx bx-group"></i>
                                        <span><em>کاربران فعال</em><strong>@Fa(Model.UserCount)</strong></span>
                                    </span>
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                            else if (cell.Kind == "month" && cell.Month is { } item)
                            {
                                <article class="crm-dash-tile" data-key="m:@item.Name" data-kind="month" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                    <a href="/App/m/@item.Name">
                                        <i class="bx @item.Icon"></i>
                                        <span><em>@item.Label</em><strong>@Fa(item.Count)</strong></span>
                                    </a>
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                            else if (cell.Kind == "quick")
                            {
                                <article class="crm-dash-panel is-quick" data-key="q" data-kind="quick" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <header>
                                        <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                        <h2>دسترسی سریع</h2>
                                        <i class="bx bx-bolt-circle"></i>
                                    </header>
                                    <a href="/App/calendar"><i class="bx bx-calendar"></i><span>تقویم</span></a>
                                    <a href="/App/reports"><i class="bx bx-bar-chart-alt-2"></i><span>گزارش‌ها</span></a>
                                    <a href="/App/workflows"><i class="bx bx-git-branch"></i><span>گردش‌کار</span></a>
                                    <a href="/App/approvals"><i class="bx bx-check-shield"></i><span>تأییدیه‌ها</span></a>
                                    <a href="/App/sms"><i class="bx bx-message-rounded-dots"></i><span>پیامک</span></a>
                                    <a href="/App/access"><i class="bx bx-user-circle"></i><span>مدیریت کاربر</span></a>
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                            else if (cell.Kind == "events")
                            {
                                <article class="crm-dash-panel is-events" data-key="e" data-kind="events" data-min-w="@cell.MinW" data-min-h="@cell.MinH" data-max-h="@cell.MaxH" style="@box">
                                    <header>
                                        <button type="button" class="crm-dash-grip" title="جابه‌جایی" aria-label="جابه‌جایی"><i class="bx bx-grid-vertical"></i></button>
                                        <h2>آخرین رویدادها</h2>
                                    </header>
                                    @if (Model.RecentEvents.Count == 0)
                                    {
                                        <p class="crm-dash-panel-empty">هنوز رکوردی ثبت نشده است.</p>
                                    }
                                    else
                                    {
                                        foreach (var ev in Model.RecentEvents)
                                        {
                                            <a class="crm-dash-event" href="@ev.Href">
                                                <span class="crm-dash-avatar t@(ev.Tone)">@ev.Initial</span>
                                                <span class="crm-dash-event-who"><strong>@ev.Who</strong><em>@ev.Sub</em></span>
                                                <span class="crm-dash-event-text">@ev.Text</span>
                                                <time>@ev.When</time>
                                            </a>
                                        }
                                    }
                                    <button type="button" class="crm-dash-resize" aria-label="تغییر اندازه" title="تغییر اندازه"></button>
                                </article>
                            }
                        }
                    </div>
                </section>
            }
        </div>
        <button type="button" class="crm-dash-new-group" id="dashAddGroup">گروه تازه</button>
    </div>

    <template id="dashGroupTpl">
        <section class="crm-dash-group">
            <header class="crm-dash-group-head">
                <button type="button" class="crm-dash-grip" data-group-grip title="جابه‌جایی گروه" aria-label="جابه‌جایی گروه"><i class="bx bx-grid-vertical"></i></button>
                <h2 contenteditable="true" spellcheck="false" data-group-title>گروه تازه</h2>
                <button type="button" class="crm-dash-tool" data-group-remove title="حذف گروه" aria-label="حذف گروه"><i class="bx bx-x"></i></button>
            </header>
            <div class="crm-dash-grid" data-grid></div>
        </section>
    </template>
</div>

<div class="modal fade" id="widgetModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="/App/dashboard/widgets/add" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">افزودن ویجت</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">نوع ویجت</label>
                    <select name="type" class="form-select" id="widgetType">
                        <option value="counter">شمارنده رکوردها</option>
                        <option value="pie">نمودار دایره‌ای (گروه‌بندی)</option>
                        <option value="bar">نمودار میله‌ای (گروه‌بندی)</option>
                        <option value="funnel">قیف فروش</option>
                        <option value="monthly">روند ماهانه رکوردها</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">ماژول</label>
                    <select name="moduleId" class="form-select" id="widgetModule">
                        @foreach (var module in Model.AllModules)
                        {
                            <option value="@module.Id">@module.PluralLabel</option>
                        }
                    </select>
                </div>
                <div class="mb-3" id="widgetFieldBox" style="display:none">
                    <label class="form-label">فیلد گروه‌بندی</label>
                    <select name="fieldName" class="form-select" id="widgetField"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">عنوان (اختیاری)</label>
                    <input type="text" name="title" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="submit" class="btn btn-primary">افزودن</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="~/panel-assets/vendor/libs/apex-charts/apexcharts.js"></script>
<script src="~/js/crm-dashboard.js" asp-append-version="true"></script>
<script>
    let picklistFields = {};
    let picklistLoaded = false;

    function refreshWidgetFields() {
        const type = document.getElementById('widgetType').value;
        const moduleId = document.getElementById('widgetModule').value;
        const box = document.getElementById('widgetFieldBox');
        const needsField = type === 'pie' || type === 'bar' || type === 'funnel';
        box.style.display = needsField ? '' : 'none';
        if (needsField) {
            const fields = picklistFields[moduleId] || [];
            const preferred = type === 'funnel' ? 'stage' : null;
            document.getElementById('widgetField').innerHTML =
                fields.map(f => `<option value="${f.name}"${preferred && f.name === preferred ? ' selected' : ''}>${f.label}</option>`).join('');
        }
    }

    async function ensurePicklistFields() {
        if (picklistLoaded) return;
        try {
            const res = await fetch('/App/dashboard/picklist-fields');
            picklistFields = await res.json();
            picklistLoaded = true;
            refreshWidgetFields();
        } catch (_) { /* ignore */ }
    }

    document.getElementById('widgetType').addEventListener('change', refreshWidgetFields);
    document.getElementById('widgetModule').addEventListener('change', refreshWidgetFields);
    document.getElementById('widgetModal')?.addEventListener('show.bs.modal', ensurePicklistFields);
    refreshWidgetFields();
</script>
}
