@using System.Net
@using Crm.Core.Entities
@using Crm.Web.Areas.App.Models
@model List<Survey>
@{
    var rows = Model.Select(survey =>
    {
        var publicUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/s/{survey.PublicKey}";
        var badges = "";
        if (survey.IsTicketSurvey)
            badges += " " + CrmTableHtml.Badge("نظرسنجی تیکت", "bg-label-info");
        if (survey.ConvertToLead)
            badges += " " + CrmTableHtml.Badge("تبدیل به سرنخ", "bg-label-warning");

        return new CrmTableRow
        {
            Id = survey.Id.ToString(),
            EditUrl = $"/App/surveys/{survey.Id}/edit",
            Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["title"] = CrmTableHtml.Strong(survey.Title, string.IsNullOrWhiteSpace(badges) ? null : badges.Trim()),
                ["questions"] = CrmTableHtml.Enc(survey.Questions.Count.ToString()),
                ["responses"] = CrmTableHtml.SoftLink($"/App/surveys/{survey.Id}/responses", $"{survey.Responses.Count} پاسخ"),
                ["status"] = CrmTableHtml.Badge(
                    survey.IsActive ? "فعال" : "غیرفعال",
                    survey.IsActive ? "bg-label-success" : "bg-label-secondary"),
                ["link"] = $"<a href=\"{WebUtility.HtmlEncode(publicUrl)}\" target=\"_blank\" dir=\"ltr\" class=\"text-truncate d-inline-block\" style=\"max-width:220px\">{WebUtility.HtmlEncode(publicUrl)}</a>"
            }
        };
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/surveys",
        ShowSearchBox = false,
        EmptyMessage = "نظرسنجی ساخته نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "title", Label = "عنوان" },
            new CrmTableColumn { Key = "questions", Label = "سوالات" },
            new CrmTableColumn { Key = "responses", Label = "پاسخ‌ها" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" },
            new CrmTableColumn { Key = "link", Label = "لینک عمومی" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-poll text-primary me-1"></i> نظرسنجی‌ها</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> نظرسنجی جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
