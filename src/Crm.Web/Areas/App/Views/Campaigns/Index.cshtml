@using Crm.Core.Entities
@using Crm.Web.Services
@using Crm.Web.Areas.App.Controllers
@using Crm.Web.Areas.App.Models
@model List<Campaign>
@{
    string StatusBadge(CampaignStatus status)
    {
        var cls = status switch
        {
            CampaignStatus.Active => "bg-label-success",
            CampaignStatus.Planned => "bg-label-info",
            CampaignStatus.Finished => "bg-label-secondary",
            _ => "bg-label-danger"
        };
        return CrmTableHtml.Badge(CampaignsController.StatusLabel(status), cls);
    }

    var rows = Model.Select(campaign => new CrmTableRow
    {
        Id = campaign.Id.ToString(),
        DetailUrl = $"/App/campaigns/{campaign.Id}",
        Cells = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["name"] = CrmTableHtml.Link($"/App/campaigns/{campaign.Id}", campaign.Name),
            ["channel"] = CrmTableHtml.Muted(campaign.Channel),
            ["range"] = CrmTableHtml.Muted(
                $"{PersianDateHelper.ToJalaliDate(campaign.StartUtc)} تا {PersianDateHelper.ToJalaliDate(campaign.EndUtc)}"),
            ["budget"] = CrmTableHtml.Enc(campaign.Budget.ToString("N0")),
            ["members"] = CrmTableHtml.Enc(campaign.Members.Count.ToString()),
            ["status"] = StatusBadge(campaign.Status)
        }
    }).ToList();

    var table = new CrmTableModel
    {
        ListPath = "/App/campaigns",
        ShowSearchBox = false,
        EmptyMessage = "کمپینی ثبت نشده است.",
        Columns =
        [
            new CrmTableColumn { Key = "name", Label = "نام" },
            new CrmTableColumn { Key = "channel", Label = "کانال" },
            new CrmTableColumn { Key = "range", Label = "بازه" },
            new CrmTableColumn { Key = "budget", Label = "بودجه" },
            new CrmTableColumn { Key = "members", Label = "اعضا" },
            new CrmTableColumn { Key = "status", Label = "وضعیت" }
        ],
        Rows = rows
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/crm-datatable.css" asp-append-version="true" />
}

<div class="crm-list-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bx bx-broadcast text-primary me-1"></i> کمپین‌های تبلیغاتی</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="bx bx-plus me-1"></i> کمپین جدید</a>
    </div>

    <partial name="_Alerts" />
    <partial name="_CrmTable" model="table" />
</div>

@section Scripts {
    <script src="~/js/crm-datatable.js" asp-append-version="true"></script>
}
