@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.RecordFormViewModel
@{
    var block = (FieldBlock)ViewData["LineBlock"]!;
    var lineFields = Model.LineFields;
    var productsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ProductOptions.Select(p => new { id = p.Id, title = p.Title, price = p.SalePrice, tax = p.TaxPercent }));
}

<section class="crm-rf-block crm-line-items" data-line-items>
    <header class="crm-rf-block-head">
        <div class="crm-rf-block-icon" aria-hidden="true"><i class="bx bx-list-ul"></i></div>
        <div>
            <h2 class="crm-rf-block-title">@block.Label</h2>
            <p class="crm-rf-block-hint">محصولات و خدمات این سند</p>
        </div>
        <button type="button" class="btn btn-sm btn-primary ms-auto" data-add-line>
            <i class="bx bx-plus me-1"></i> افزودن سطر
        </button>
    </header>
    <div class="crm-rf-block-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" data-lines-table>
                <thead>
                    <tr>
                        <th style="min-width:160px">محصول</th>
                        <th style="min-width:140px">عنوان</th>
                        <th style="width:90px">تعداد</th>
                        <th style="width:110px">قیمت</th>
                        <th style="width:80px">تخفیف٪</th>
                        <th style="width:80px">مالیات٪</th>
                        <th style="width:110px">جمع</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody data-lines-body>
                    @for (var i = 0; i < Model.LineItems.Count; i++)
                    {
                        var row = Model.LineItems[i];
                        <tr data-line-row>
                            <td>
                                <input type="hidden" name="li[@i][__id]" value="@(row.GetValueOrDefault("__id"))" />
                                <select name="li[@i][product]" class="form-select form-select-sm crm-select2" data-line-product>
                                    <option value="">—</option>
                                    @foreach (var p in Model.ProductOptions)
                                    {
                                        <option value="@p.Id"
                                                data-price="@p.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-tax="@p.TaxPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                selected="@(row.GetValueOrDefault("product") == p.Id.ToString())">@p.Title</option>
                                    }
                                </select>
                            </td>
                            <td><input type="text" name="li[@i][title]" class="form-control form-control-sm" value="@(row.GetValueOrDefault("title"))" data-line-title /></td>
                            <td><input type="text" inputmode="decimal" dir="ltr" name="li[@i][quantity]" class="form-control form-control-sm" value="@(row.GetValueOrDefault("quantity") ?? "1")" data-line-qty /></td>
                            <td><input type="text" inputmode="decimal" dir="ltr" name="li[@i][unitPrice]" class="form-control form-control-sm" value="@(row.GetValueOrDefault("unitPrice"))" data-line-price /></td>
                            <td><input type="text" inputmode="decimal" dir="ltr" name="li[@i][discountPercent]" class="form-control form-control-sm" value="@(row.GetValueOrDefault("discountPercent") ?? "0")" data-line-disc /></td>
                            <td><input type="text" inputmode="decimal" dir="ltr" name="li[@i][taxPercent]" class="form-control form-control-sm" value="@(row.GetValueOrDefault("taxPercent") ?? "0")" data-line-tax /></td>
                            <td><input type="text" dir="ltr" class="form-control form-control-sm" value="@(row.GetValueOrDefault("lineTotal"))" readonly data-line-total /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line title="حذف"><i class="bx bx-trash"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end gap-4 mt-3 small">
            <div>جمع جزء: <strong data-sum-sub>0</strong></div>
            <div>مالیات: <strong data-sum-tax>0</strong></div>
            <div>جمع کل: <strong data-sum-grand>0</strong></div>
        </div>
    </div>
</section>

<template id="line-row-template">
    <tr data-line-row>
        <td>
            <input type="hidden" name="li[__IDX__][__id]" value="" />
            <select name="li[__IDX__][product]" class="form-select form-select-sm" data-line-product>
                <option value="">—</option>
                @foreach (var p in Model.ProductOptions)
                {
                    <option value="@p.Id"
                            data-price="@p.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-tax="@p.TaxPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.Title</option>
                }
            </select>
        </td>
        <td><input type="text" name="li[__IDX__][title]" class="form-control form-control-sm" data-line-title /></td>
        <td><input type="text" inputmode="decimal" dir="ltr" name="li[__IDX__][quantity]" class="form-control form-control-sm" value="1" data-line-qty /></td>
        <td><input type="text" inputmode="decimal" dir="ltr" name="li[__IDX__][unitPrice]" class="form-control form-control-sm" value="0" data-line-price /></td>
        <td><input type="text" inputmode="decimal" dir="ltr" name="li[__IDX__][discountPercent]" class="form-control form-control-sm" value="0" data-line-disc /></td>
        <td><input type="text" inputmode="decimal" dir="ltr" name="li[__IDX__][taxPercent]" class="form-control form-control-sm" value="0" data-line-tax /></td>
        <td><input type="text" dir="ltr" class="form-control form-control-sm" value="0" readonly data-line-total /></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-line><i class="bx bx-trash"></i></button></td>
    </tr>
</template>

<script>
    window.__crmProducts = @Html.Raw(productsJson);
</script>
