@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.RecordFormViewModel

@* فرم داینامیک: بلاک‌ها به‌صورت کارت؛ فیلدها گرید چندستونه؛ بلاک آیتم جدا *@
@foreach (var (block, groupFields) in Model.GroupedFields())
{
    if (block?.Kind == BlockKind.LineItems)
    {
        @await Html.PartialAsync("_DynamicFormLineItems", Model, new ViewDataDictionary(ViewData) { ["LineBlock"] = block })
        continue;
    }

    var blockLabel = block?.Label ?? "اطلاعات";
    var hasRule = block is not null && !string.IsNullOrWhiteSpace(block.VisibilityRuleJson);

    <section class="crm-rf-block crm-dep-target"
             @if (hasRule)
             {
                 <text>data-visibility-rule="@block!.VisibilityRuleJson"</text>
             }>
        <header class="crm-rf-block-head">
            <div class="crm-rf-block-icon" aria-hidden="true">
                <i class="bx bx-layer"></i>
            </div>
            <div>
                <h2 class="crm-rf-block-title">@blockLabel</h2>
                <p class="crm-rf-block-hint">@groupFields.Count فیلد در این بخش</p>
            </div>
        </header>
        <div class="crm-rf-block-body">
            <div class="row g-3">
                @foreach (var field in groupFields)
                {
                    @await Html.PartialAsync("_DynamicFormField", Model, new ViewDataDictionary(ViewData) { ["FormField"] = field })
                }
            </div>
        </div>
    </section>
}
