@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.RecordFormViewModel

@* فرم داینامیک: از روی FieldDef های ماژول ساخته می‌شود؛ دسترسی per-field پروفایل اعمال می‌شود. *@
@foreach (var (block, groupFields) in Model.GroupedFields())
{
    if (block is not null)
    {
        <div class="mb-4 crm-dep-target"
             @if (!string.IsNullOrWhiteSpace(block.VisibilityRuleJson))
             {
                 <text>data-visibility-rule="@block.VisibilityRuleJson"</text>
             }>
            <h6 class="text-muted text-uppercase small mb-3 border-bottom pb-2">@block.Label</h6>
            <div class="row g-3">
                @foreach (var field in groupFields)
                {
                    @await Html.PartialAsync("_DynamicFormField", Model, new ViewDataDictionary(ViewData) { ["FormField"] = field })
                }
            </div>
        </div>
    }
    else if (Model.Blocks.Count > 0)
    {
        <div class="mb-4">
            <div class="row g-3">
                @foreach (var field in groupFields)
                {
                    @await Html.PartialAsync("_DynamicFormField", Model, new ViewDataDictionary(ViewData) { ["FormField"] = field })
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var field in groupFields)
            {
                @await Html.PartialAsync("_DynamicFormField", Model, new ViewDataDictionary(ViewData) { ["FormField"] = field })
            }
        </div>
    }
}
