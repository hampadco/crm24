@inject Crm.Infrastructure.Services.MetadataService Metadata
@inject Crm.Core.Abstractions.ITenantContext Tenant
@using Crm.Web.Services
@{
    var currentPath = Context.Request.Path.Value ?? "";
    var modules = (await Metadata.GetActiveModulesAsync())
        .Where(m => m.ShowInMenu && !m.IsChildModule)
        .OrderBy(m => m.SortOrder)
        .ThenBy(m => m.Id)
        .ToList();

    IEnumerable<Crm.Core.Entities.ModuleDef> Group(string g) =>
        modules.Where(m => string.Equals(m.MenuGroup, g, StringComparison.OrdinalIgnoreCase));

    string ModHref(Crm.Core.Entities.ModuleDef m) => $"/App/m/{m.Name}";
    bool IsActiveMod(Crm.Core.Entities.ModuleDef m) =>
        currentPath.StartsWith($"/App/m/{m.Name}", StringComparison.OrdinalIgnoreCase);

    string OnPath(string href) =>
        currentPath.Equals(href, StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    string Icon(Crm.Core.Entities.ModuleDef m) => m.Name switch
    {
        "leads" => "fi-rr-user-add",
        "campaigns" => "fi-rr-megaphone",
        "contacts" => "fi-rr-address-book",
        "organizations" => "fi-rr-building",
        "opportunities" => "fi-rr-handshake",
        "quotes" => "fi-rr-file-invoice",
        "sales_orders" => "fi-rr-shopping-bag",
        "invoices" => "fi-rr-receipt",
        "payments" => "fi-rr-coin",
        "commissions" => "fi-rr-percentage",
        "pricebooks" => "fi-rr-tags",
        "products" => "fi-rr-box",
        "vendors" => "fi-rr-shop",
        "purchase_orders" => "fi-rr-shopping-cart",
        "warehouses" => "fi-rr-warehouse-alt",
        "tickets" => "fi-rr-headset",
        "contracts" => "fi-rr-document-signed",
        "warranties" => "fi-rr-shield-check",
        "services" => "fi-rr-life-ring",
        "calls" => "fi-rr-phone-call",
        "projects" => "fi-rr-briefcase",
        "project_tasks" => "fi-rr-list-check",
        "project_phases" => "fi-rr-layers",
        "leaves" => "fi-rr-umbrella-beach",
        "tasks" => "fi-rr-checkbox",
        "events" => "fi-rr-calendar-day",
        "documents" => "fi-rr-folder",
        _ => "fi-rr-apps"
    };

    string DetectActiveCat()
    {
        if (currentPath.StartsWith("/App/dashboard", StringComparison.OrdinalIgnoreCase) || currentPath.Equals("/App", StringComparison.OrdinalIgnoreCase) || currentPath.StartsWith("/App/reports", StringComparison.OrdinalIgnoreCase))
            return "dashboard";
        if (currentPath.StartsWith("/App/webforms", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("/App/surveys", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("/App/templates", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("/App/sms", StringComparison.OrdinalIgnoreCase)
            || Group("marketing").Any(IsActiveMod))
            return "marketing";
        if (currentPath.StartsWith("/App/kanban", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("/App/finance", StringComparison.OrdinalIgnoreCase)
            || Group("sales").Any(IsActiveMod))
            return "sales";
        if (Group("inventory").Any(IsActiveMod)) return "inventory";
        if (currentPath.StartsWith("/App/kb", StringComparison.OrdinalIgnoreCase)
            || currentPath.StartsWith("/App/portal-users", StringComparison.OrdinalIgnoreCase)
            || Group("support").Any(IsActiveMod))
            return "support";
        if (currentPath.StartsWith("/App/projects", StringComparison.OrdinalIgnoreCase)
            || Group("projects").Any(IsActiveMod)
            || modules.Any(m => m.Name is "tasks" or "events" or "documents" && IsActiveMod(m)))
            return "work";
        return "settings";
    }

    var activeCat = DetectActiveCat();
    var cats = new (string Id, string Icon, string Title, int Badge)[]
    {
        ("dashboard", "fi-br-house-blank", "داشبورد", 0),
        ("marketing", "fi-br-megaphone", "بازاریابی", 0),
        ("sales", "fi-br-shopping-cart", "فروش", 0),
        ("inventory", "fi-br-box", "خرید و موجودی", 0),
        ("support", "fi-br-headset", "پشتیبانی", 0),
        ("work", "fi-br-briefcase", "کارها", 0),
        ("settings", "fi-br-settings", "تنظیمات", 0)
    };
}
@await Component.InvokeAsync("MenuBadges")
@{
    var badges = Context.Items["MenuBadges"] as MenuBadgeCounts ?? new MenuBadgeCounts();
    cats = new (string Id, string Icon, string Title, int Badge)[]
    {
        ("dashboard", "fi-br-house-blank", "داشبورد", 0),
        ("marketing", "fi-br-megaphone", "بازاریابی", 0),
        ("sales", "fi-br-shopping-cart", "فروش", 0),
        ("inventory", "fi-br-box", "خرید و موجودی", 0),
        ("support", "fi-br-headset", "پشتیبانی", badges.Tickets),
        ("work", "fi-br-briefcase", "کارها", badges.Work),
        ("settings", "fi-br-settings", "تنظیمات", 0)
    };

    string BadgeHtml(int count) => count > 0
        ? $"<span class=\"nx-menu-badge\">{(count > 99 ? "۹۹+" : count.ToFa())}</span>"
        : "";
}
<aside class="app-menubar-tabs" id="appMenubar">
    <div class="app-navbar-brand">
        <a class="navbar-brand-logo" href="/App/dashboard">
            <img src="~/nexlink/images/logo.svg" alt="@BrandingAccessor.Value.LatinName" />
        </a>
    </div>
    <div class="app-navbar-tabs" data-simplebar>
        <ul class="nav" role="tablist">
            @foreach (var cat in cats)
            {
                var on = activeCat == cat.Id;
                <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="@cat.Title">
                    <a class="menu-link @(on ? "active" : "")" href="#nx-@cat.Id" data-bs-toggle="tab" role="tab" aria-selected="@(on ? "true" : "false")">
                        <i class="fi @cat.Icon"></i>
                        @Html.Raw(BadgeHtml(cat.Badge))
                    </a>
                </li>
            }
            <li class="nav-item-hr"></li>
            <li class="nav-item mt-auto">
                <a class="menu-link @OnPath("/App/calendar")" href="/App/calendar" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="تقویم">
                    <i class="fi fi-br-calendar"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="menu-link @OnPath("/App/approvals")" href="/App/approvals" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="تأییدیه‌ها">
                    <i class="fi fi-br-check"></i>
                    @Html.Raw(BadgeHtml(badges.Approvals))
                </a>
            </li>
        </ul>
    </div>
    <div class="app-tab-content">
        <div class="app-side-brands">
            <a class="navbar-brand-text" href="/App/dashboard">@BrandingAccessor.Value.LatinName</a>
        </div>
        <div class="app-content-inner">
            <div class="tab-content">
                <div class="tab-pane fade @(activeCat == "dashboard" ? "show active" : "")" id="nx-dashboard">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">داشبورد</span></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/dashboard")" href="/App/dashboard"><i class="fi fi-rr-house-blank"></i><span class="menu-label">داشبورد اصلی</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/reports")" href="/App/reports"><i class="fi fi-rr-chart-histogram"></i><span class="menu-label">گزارش‌ها</span></a></li>
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "marketing" ? "show active" : "")" id="nx-marketing">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">بازاریابی</span></li>
                            @foreach (var m in Group("marketing"))
                            {
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span></a></li>
                            }
                            <li class="menu-item"><a class="menu-link @OnPath("/App/webforms")" href="/App/webforms"><i class="fi fi-rr-form"></i><span class="menu-label">وب‌فرم‌ها</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/surveys")" href="/App/surveys"><i class="fi fi-rr-comment-alt"></i><span class="menu-label">نظرسنجی‌ها</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/templates")" href="/App/templates"><i class="fi fi-rr-comment"></i><span class="menu-label">قالب‌های پیام</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/sms")" href="/App/sms"><i class="fi fi-rr-comment-sms"></i><span class="menu-label">پیامک</span></a></li>
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "sales" ? "show active" : "")" id="nx-sales">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">فروش</span></li>
                            @foreach (var m in Group("sales"))
                            {
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span></a></li>
                            }
                            <li class="menu-item"><a class="menu-link @OnPath("/App/kanban/opportunities")" href="/App/kanban/opportunities"><i class="fi fi-rr-columns-3"></i><span class="menu-label">کاریز فروش</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/finance")" href="/App/finance"><i class="fi fi-rr-chart-line-up"></i><span class="menu-label">مالی</span></a></li>
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "inventory" ? "show active" : "")" id="nx-inventory">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">خرید و موجودی</span></li>
                            @foreach (var m in Group("inventory"))
                            {
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span></a></li>
                            }
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "support" ? "show active" : "")" id="nx-support">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">پشتیبانی</span></li>
                            @foreach (var m in Group("support"))
                            {
                                var mark = m.Name == "tickets" ? badges.Tickets : 0;
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span>@Html.Raw(BadgeHtml(mark))</a></li>
                            }
                            <li class="menu-item"><a class="menu-link @OnPath("/App/kb")" href="/App/kb"><i class="fi fi-rr-book-alt"></i><span class="menu-label">پایگاه دانش</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/portal-users")" href="/App/portal-users"><i class="fi fi-rr-users"></i><span class="menu-label">کاربران پورتال</span></a></li>
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "work" ? "show active" : "")" id="nx-work">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">کارها</span></li>
                            @if (!Group("projects").Any(m => m.Name == "projects"))
                            {
                                <li class="menu-item"><a class="menu-link @OnPath("/App/projects")" href="/App/projects"><i class="fi fi-rr-briefcase"></i><span class="menu-label">پروژه‌ها</span></a></li>
                            }
                            @foreach (var m in Group("projects").Concat(modules.Where(m => m.Name is "tasks" or "events" or "documents")))
                            {
                                var mark = m.Name == "tasks" ? badges.Tasks : m.Name == "project_tasks" ? badges.ProjectTasks : 0;
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span>@Html.Raw(BadgeHtml(mark))</a></li>
                            }
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane fade @(activeCat == "settings" ? "show active" : "")" id="nx-settings">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">تنظیمات</span></li>
                            @if (Tenant.IsTenantAdmin)
                            {
                                <li class="menu-item"><a class="menu-link @OnPath("/App/customize")" href="/App/customize"><i class="fi fi-rr-settings-sliders"></i><span class="menu-label">سفارشی‌سازی</span></a></li>
                                <li class="menu-item"><a class="menu-link @OnPath("/App/print-templates")" href="/App/print-templates"><i class="fi fi-rr-print"></i><span class="menu-label">قالب‌های چاپ</span></a></li>
                                <li class="menu-item"><a class="menu-link @OnPath("/App/access")" href="/App/access"><i class="fi fi-rr-users"></i><span class="menu-label">مدیریت کاربر</span></a></li>
                            }
                            <li class="menu-item"><a class="menu-link @OnPath("/App/integrations")" href="/App/integrations"><i class="fi fi-rr-plug"></i><span class="menu-label">یکپارچگی و API</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/subscription")" href="/App/subscription"><i class="fi fi-rr-badge"></i><span class="menu-label">اشتراک</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/help")" href="/App/help"><i class="fi fi-rr-book-alt"></i><span class="menu-label">آموزش</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/workflows")" href="/App/workflows"><i class="fi fi-rr-workflow"></i><span class="menu-label">گردش‌کار</span></a></li>
                            <li class="menu-item"><a class="menu-link @OnPath("/App/recycle-bin")" href="/App/recycle-bin"><i class="fi fi-rr-trash"></i><span class="menu-label">سطل بازیابی</span></a></li>
                            @foreach (var m in Group("tools").Where(m => m.Name is not ("tasks" or "events" or "documents")))
                            {
                                <li class="menu-item"><a class="menu-link @(IsActiveMod(m) ? "active" : "")" href="@ModHref(m)"><i class="@Icon(m)"></i><span class="menu-label">@m.PluralLabel</span></a></li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</aside>
