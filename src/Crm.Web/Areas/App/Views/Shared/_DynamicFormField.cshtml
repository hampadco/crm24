@using Crm.Core.Entities
@model Crm.Web.Areas.App.Models.RecordFormViewModel
@{
    var field = (FieldDef)ViewData["FormField"]!;
    var access = Model.AccessFor(field);
}
@if (access != FieldAccess.Hidden)
{
    var readOnly = access == FieldAccess.ReadOnly;
    var name = $"f_{field.Name}";
    var rawDefault = field.DefaultValue;
    if (rawDefault == "__TODAY__" && string.IsNullOrEmpty(Model.Values.GetValueOrDefault(field.Name)))
    {
        rawDefault = DateTime.Today.ToString("yyyy-MM-dd");
    }
    var value = Model.Values.GetValueOrDefault(field.Name) ?? rawDefault;
    var hasError = Model.Errors.TryGetValue(field.Name, out var error);
    var inputClass = $"form-control crm-rf-control{(hasError ? " is-invalid" : "")}";
    var selectClass = $"form-select crm-rf-control{(hasError ? " is-invalid" : "")}";
    var colClass = field.Type == FieldType.MultilineText ? "col-12" : "col-md-6 col-xl-4";
    var ruleAttr = string.IsNullOrWhiteSpace(field.VisibilityRuleJson)
        ? null
        : field.VisibilityRuleJson;

    <div class="@colClass crm-dep-target crm-rf-field"
         @if (ruleAttr is not null)
         {
             <text>data-visibility-rule="@ruleAttr"</text>
         }>
        <label class="crm-rf-label" for="@name">
            @field.Label
            @if (field.IsRequired)
            {
                <span class="crm-rf-req" title="اجباری">*</span>
            }
        </label>

        @switch (field.Type)
        {
            case FieldType.MultilineText:
                <textarea id="@name" name="@name" rows="4" class="@inputClass" readonly="@readOnly" maxlength="@(field.MaxLength)">@value</textarea>
                break;

            case FieldType.Picklist:
                <select id="@name" name="@name" class="@selectClass crm-select2"
                        data-placeholder="جستجو و انتخاب…"
                        data-allow-clear="@(!field.IsRequired ? "true" : null)"
                        disabled="@readOnly">
                    @if (!field.IsRequired)
                    {
                        <option value="">— انتخاب کنید —</option>
                    }
                    @foreach (var pick in field.PicklistValues.OrderBy(p => p.SortOrder))
                    {
                        if (pick.Value == value)
                        {
                            <option value="@pick.Value" selected>@pick.Label</option>
                        }
                        else
                        {
                            <option value="@pick.Value">@pick.Label</option>
                        }
                    }
                </select>
                break;

            case FieldType.MultiPicklist:
                {
                    var selected = (value ?? "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);
                    <select id="@name" name="@name" class="@selectClass crm-select2"
                            multiple
                            data-placeholder="جستجو و انتخاب…"
                            disabled="@readOnly">
                        @foreach (var pick in field.PicklistValues.OrderBy(p => p.SortOrder))
                        {
                            if (selected.Contains(pick.Value))
                            {
                                <option value="@pick.Value" selected>@pick.Label</option>
                            }
                            else
                            {
                                <option value="@pick.Value">@pick.Label</option>
                            }
                        }
                    </select>
                }
                break;

            case FieldType.Lookup:
                <select id="@name" name="@name" class="@selectClass crm-select2"
                        data-placeholder="جستجو و انتخاب…"
                        data-allow-clear="true"
                        data-ajax-url="/App/m/@Model.Module.Name/lookup/@field.Name"
                        @(string.Equals(field.Name, "priceBook", StringComparison.OrdinalIgnoreCase) ? "data-price-book=true" : null)
                        disabled="@readOnly">
                    <option value=""></option>
                    @if (!string.IsNullOrWhiteSpace(value)
                         && Model.LookupOptions.TryGetValue(field.Name, out var options))
                    {
                        @foreach (var (optId, optTitle) in options)
                        {
                            if (string.Equals(optId.ToString(), value.Trim(), StringComparison.Ordinal))
                            {
                                <option value="@optId" selected>@optTitle</option>
                            }
                        }
                    }
                </select>
                @if (string.Equals(field.Name, "priceBook", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="form-text">با انتخاب محصول در سطرها، قیمت از این دفترچه پر می‌شود.</div>
                }
                break;

            case FieldType.Checkbox:
                <div class="crm-rf-check">
                    <input type="hidden" name="@name" value="@(value == "true" ? "true" : "false")" />
                    <input type="checkbox" class="form-check-input" id="@name" checked="@(value == "true")" disabled="@readOnly"
                           onchange="this.previousElementSibling.value = this.checked ? 'true' : 'false'" />
                    <label class="form-check-label" for="@name">فعال</label>
                </div>
                break;

            case FieldType.Number:
            case FieldType.Decimal:
            case FieldType.Currency:
            case FieldType.Percent:
                <div class="input-group crm-rf-igroup">
                    <input type="text" inputmode="decimal" dir="ltr" id="@name" name="@name" value="@value" class="@inputClass" readonly="@readOnly" maxlength="@(field.MaxLength)" />
                    @if (field.Type == FieldType.Percent)
                    {
                        <span class="input-group-text">٪</span>
                    }
                    else if (field.Type == FieldType.Currency)
                    {
                        <span class="input-group-text">﷼</span>
                    }
                </div>
                break;

            case FieldType.Date:
                <input type="text" dir="ltr" id="@name" name="@name" value="@value" class="@inputClass jalali-date" readonly="@readOnly" autocomplete="off" />
                break;

            case FieldType.DateTime:
                <input type="text" dir="ltr" id="@name" name="@name" value="@value" class="@inputClass jalali-datetime" readonly="@readOnly" autocomplete="off" />
                break;

            case FieldType.Email:
            case FieldType.Phone:
            case FieldType.Url:
                <input type="text" dir="ltr" id="@name" name="@name" value="@value" class="@inputClass" readonly="@readOnly" maxlength="@(field.MaxLength)" />
                break;

            default:
                <input type="text" id="@name" name="@name" value="@value" class="@inputClass" readonly="@readOnly" maxlength="@(field.MaxLength)" />
                break;
        }

        @if (hasError)
        {
            <div class="invalid-feedback d-block">@error</div>
        }
    </div>
}
