@using Crm.Core.Entities
@model KbArticle
@{
    ViewData["PanelTitle"] = "پورتال مشتری";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-1"><i class="bx bx-book-open text-primary me-1"></i> @Model.Title</h4>
        @if (Model.Category is not null)
        {
            <span class="badge bg-label-info">@Model.Category</span>
        }
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bx bx-right-arrow-alt me-1"></i> بازگشت
    </a>
</div>

<div class="card">
    <div class="card-body p-3 p-md-4">
        @await Component.InvokeAsync("ElementorContent", new { html = Model.Body, wrapperClass = "taben-elementor-content kb-article-content" })
    </div>
</div>
