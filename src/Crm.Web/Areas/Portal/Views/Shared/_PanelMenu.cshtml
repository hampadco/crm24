@{
    var currentPath = Context.Request.Path.Value ?? "";
    string On(string prefix) => currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<aside class="app-menubar-tabs" id="appMenubar">
    <div class="app-navbar-brand">
        <a class="navbar-brand-logo" href="/Portal"><img src="~/nexlink/images/logo.svg" alt="" /></a>
    </div>
    <div class="app-navbar-tabs" data-simplebar>
        <ul class="nav" role="tablist">
            <li class="nav-item" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-title="پورتال">
                <a class="menu-link active" href="#nx-portal" data-bs-toggle="tab"><i class="fi fi-br-user"></i></a>
            </li>
        </ul>
    </div>
    <div class="app-tab-content">
        <div class="app-side-brands"><a class="navbar-brand-text" href="/Portal">پورتال</a></div>
        <div class="app-content-inner">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="nx-portal">
                    <nav class="app-navbar" data-simplebar>
                        <ul class="side-menubar">
                            <li class="menu-heading"><span class="menu-label">خدمات</span></li>
                            <li class="menu-item"><a class="menu-link @(currentPath == "/Portal" || currentPath.StartsWith("/Portal/Dashboard") ? "active" : "")" href="/Portal"><i class="fi fi-rr-house-blank"></i><span class="menu-label">داشبورد</span></a></li>
                            <li class="menu-item"><a class="menu-link @On("/Portal/tickets")" href="/Portal/tickets"><i class="fi fi-rr-headset"></i><span class="menu-label">تیکت‌های من</span></a></li>
                            <li class="menu-item"><a class="menu-link @On("/Portal/projects")" href="/Portal/projects"><i class="fi fi-rr-briefcase"></i><span class="menu-label">پروژه‌های من</span></a></li>
                            <li class="menu-item"><a class="menu-link @On("/Portal/invoices")" href="/Portal/invoices"><i class="fi fi-rr-receipt"></i><span class="menu-label">فاکتورهای من</span></a></li>
                            <li class="menu-item"><a class="menu-link @On("/Portal/kb")" href="/Portal/kb"><i class="fi fi-rr-book-alt"></i><span class="menu-label">پایگاه دانش</span></a></li>
                            <li class="menu-item"><a class="menu-link @On("/Portal/help")" href="/Portal/help"><i class="fi fi-rr-book-alt"></i><span class="menu-label">راهنما</span></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</aside>
